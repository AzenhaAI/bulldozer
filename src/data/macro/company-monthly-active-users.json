{
  "meta": {
    "title": "Monthly Active Users of Internet Companies",
    "valueLabel": "Monthly active users, as each company defines them (millions)",
    "unit": "million",
    "changeMode": "pct",
    "topic": "economy",
    "summary": "Monthly active users reported by listed internet companies in their quarterly earnings releases filed with the SEC, in millions. Pinterest and Spotify report users at quarter end; Snap and Duolingo average the months of the quarter; Uber reports monthly active platform consumers (MAPCs: people who took a ride or received a delivery in a month, averaged over the quarter). Snap's MAU starts in Q2 2025, the first release whose table carries it. Not included: Meta's Family monthly active people and Facebook monthly active users, reported only until Q4 2023. Coverage: Duolingo 2021-Q2–2026-Q3; Pinterest 2019-Q1–2026-Q3; Snap 2025-Q2–2026-Q3; Spotify 2019-Q1–2026-Q3; Uber 2019-Q1–2026-Q3.",
    "vintage": "Calendar quarters, 2019-Q1 to 2026-Q3; each company from its first release in the period",
    "method": "Each value is read from the company's own earnings release for that quarter (exhibit 99.x to its 8-K, or 6-K for Spotify) on SEC EDGAR, as first reported: later restatements are not applied. Periods are calendar quarters (every company here has a December year end). Values in millions; a release that rounds (Roblox from Q4 2025, Match Group Q3 2026) is kept as rounded. The filing URL and the exact words or table row of every value are in data/raw/company-metrics/observations.csv.",
    "source": "SEC EDGAR — company earnings releases (8-K / 6-K exhibits)",
    "license": "Public information on sec.gov (SEC website dissemination policy)",
    "url": "https://github.com/AzenhaAI/bulldozer/blob/main/data/raw/company-metrics/observations.csv",
    "entityType": "company",
    "parsedAt": "2026-11-10",
    "kind": "macro"
  },
