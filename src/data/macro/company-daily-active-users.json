{
  "meta": {
    "title": "Daily Active Users of Internet Companies",
    "valueLabel": "Daily active users, as each company defines them (millions)",
    "unit": "million",
    "changeMode": "pct",
    "topic": "economy",
    "summary": "Daily active users reported by listed internet companies in their quarterly earnings releases filed with the SEC, in millions. Each company counts its own way: Meta reports Family daily active people (DAP: people using Facebook, Instagram, Messenger or WhatsApp on a day, averaged over the last month of the quarter); Snap, Roblox and Duolingo average daily active users over the quarter; Reddit reports daily active uniques (DAUq, logged-in or not). Snap added web visits to its DAU in Q1 2024 and calls the effect immaterial; it has said that from Q1 2027 it will report monthly instead of daily users. Not included: Facebook-app DAU and MAU, which Meta stopped reporting after Q4 2023. Coverage: Duolingo 2021-Q2–2026-Q3; Meta 2019-Q4–2026-Q3; Reddit 2024-Q1–2026-Q3; Roblox 2021-Q1–2026-Q3; Snap 2019-Q1–2026-Q3.",
    "vintage": "Calendar quarters, 2019-Q1 to 2026-Q3; each company from its first release in the period",
    "method": "Each value is read from the company's own earnings release for that quarter (exhibit 99.x to its 8-K, or 6-K for Spotify) on SEC EDGAR, as first reported: later restatements are not applied. Periods are calendar quarters (every company here has a December year end). Values in millions; a release that rounds (Roblox from Q4 2025, Match Group Q3 2026) is kept as rounded. The filing URL and the exact words or table row of every value are in data/raw/company-metrics/observations.csv.",
    "source": "SEC EDGAR — company earnings releases (8-K / 6-K exhibits)",
    "license": "Public information on sec.gov (SEC website dissemination policy)",
    "url": "https://github.com/AzenhaAI/bulldozer/blob/main/data/raw/company-metrics/observations.csv",
    "entityType": "company",
    "parsedAt": "2026-11-10",
    "kind": "macro"
  },
