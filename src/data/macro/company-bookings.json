{
  "meta": {
    "title": "Trips, Orders and Nights Booked",
    "valueLabel": "Units booked in the quarter: trips, orders or nights (millions)",
    "unit": "million",
    "changeMode": "pct",
    "topic": "economy",
    "summary": "Transactions per quarter reported by listed travel and delivery platforms in their earnings releases filed with the SEC, in millions: Uber trips (rides and delivery orders), DoorDash total orders, Airbnb nights and experiences booked, and Booking Holdings room nights. The units differ, so compare each company with itself over time. DoorDash includes Wolt from Q2 2022 and Deliveroo from Q4 2025; Airbnb renamed its measure \"nights and seats booked\" in Q2 2025 when it added services, with the prior-year figures unchanged. Uber later revised a few 2020 trip counts slightly (Q3 2020: 1,150 million first reported, 1,184 million a year later); the first-reported figure is kept. Coverage: Airbnb 2020-Q4–2026-Q3; Booking Holdings 2019-Q1–2026-Q3; DoorDash 2020-Q4–2026-Q3; Uber 2019-Q1–2026-Q3.",
    "vintage": "Calendar quarters, 2019-Q1 to 2026-Q3; each company from its first release in the period",
    "method": "Each value is read from the company's own earnings release for that quarter (exhibit 99.x to its 8-K, or 6-K for Spotify) on SEC EDGAR, as first reported: later restatements are not applied. Periods are calendar quarters (every company here has a December year end). Values in millions; a release that rounds (Roblox from Q4 2025, Match Group Q3 2026) is kept as rounded. The filing URL and the exact words or table row of every value are in data/raw/company-metrics/observations.csv.",
    "source": "SEC EDGAR — company earnings releases (8-K / 6-K exhibits)",
    "license": "Public information on sec.gov (SEC website dissemination policy)",
    "url": "https://github.com/AzenhaAI/bulldozer/blob/main/data/raw/company-metrics/observations.csv",
    "entityType": "company",
    "parsedAt": "2026-11-10",
    "kind": "macro"
  },
