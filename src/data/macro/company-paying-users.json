  "meta": {
    "title": "Paying Users of Internet Companies",
    "valueLabel": "Paying users or paid subscribers, as each company defines them (millions)",
    "unit": "million",
    "changeMode": "pct",
    "topic": "economy",
    "summary": "Paying users reported by listed consumer-subscription companies in their quarterly earnings releases filed with the SEC, in millions. Spotify premium subscribers and Duolingo paid subscribers are counted at quarter end; Match Group payers (unique payers per brand in a month) and Bumble total paying users are averages over the quarter. Match Group starts in Q2 2021, when it replaced \"average subscribers\" with payers, a different measure. Not included: Netflix paid memberships, which Netflix stopped reporting from Q1 2025. Coverage: Bumble 2020-Q4–2026-Q2; Duolingo 2021-Q2–2026-Q3; Match Group 2021-Q2–2026-Q3; Spotify 2019-Q1–2026-Q3.",
    "vintage": "Calendar quarters, 2019-Q1 to 2026-Q3; each company from its first release in the period",
    "method": "Each value is read from the company's own earnings release for that quarter (exhibit 99.x to its 8-K, or 6-K for Spotify) on SEC EDGAR, as first reported: later restatements are not applied. Periods are calendar quarters (every company here has a December year end). Values in millions; a release that rounds (Roblox from Q4 2025, Match Group Q3 2026) is kept as rounded. The filing URL and the exact words or table row of every value are in data/raw/company-metrics/observations.csv.",
    "source": "SEC EDGAR — company earnings releases (8-K / 6-K exhibits)",
    "license": "Public information on sec.gov (SEC website dissemination policy)",
    "url": "https://github.com/AzenhaAI/bulldozer/blob/main/data/raw/company-metrics/observations.csv",
    "entityType": "company",
    "parsedAt": "2026-11-10",
    "kind": "macro"
  },
