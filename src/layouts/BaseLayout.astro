---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'news' | 'apps' | 'explore' | 'sources' | 'surveys' | 'macro' | 'markets' | 'geo' | 'edu' | 'quiz' | 'glossary';
  /** Path (under base) to a page-specific OG image, e.g. `/og/whr-happiness.png`. */
  ogPath?: string;
}
const { title, description, active, ogPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Primary data sections stay as tabs; the rest lives in the burger menu
// (same pattern as the Ativa app: switcher + burger on the right edge).
const nav = [
  { id: 'news', label: 'New', href: `${base}/` },
  { id: 'explore', label: 'Top', href: `${base}/explore/` },
  { id: 'macro', label: 'Macro', href: `${base}/macro/` },
  { id: 'markets', label: 'Biz', href: `${base}/markets/` },
  { id: 'surveys', label: 'Polls', href: `${base}/surveys/` },
  { id: 'geo', label: 'Geo', href: `${base}/geo/` },
];
// The burger is a *complete* menu — mirrors every section (so it works as the
// only nav on mobile) plus tools, the app link and the theme toggle.
const burger = [
  { id: 'news', label: '📰 New', href: `${base}/` },
  { id: 'explore', label: '🔎 Top', href: `${base}/explore/` },
  { id: 'macro', label: '📈 Macro', href: `${base}/macro/` },
  { id: 'markets', label: '💼 Biz', href: `${base}/markets/` },
  { id: 'surveys', label: '🗳️ Polls', href: `${base}/surveys/` },
  { id: 'geo', label: '🌍 Geo', href: `${base}/geo/` },
  { id: 'edu', label: '🎓 Edu', href: `${base}/edu/` },
  { sep: true },
  { id: 'quiz', label: '🎲 Country quiz', href: `${base}/quiz/` },
  { id: 'glossary', label: '📖 Glossary', href: `${base}/glossary/` },
  { id: 'about', label: 'ℹ️ About', href: `${base}/about/` },
  { id: 'contact', label: '✉️ Contact', href: 'mailto:agent@azenha.ai' },
  { sep: true },
  // Points at the apps page rather than straight at the APK: iPhone users tapping
  // "Get the app" were being handed an Android package they can't install.
  { id: 'apps', label: '📱 Get the app', href: `${base}/apps` },
];
const fullTitle = title ? `${title} · BullDozer` : 'BullDozer — Marketing Analytics & Research';
const desc = description ?? 'Bulldoze the noise. Mine the signal. 136 public, parsed datasets — surveys, IMF & World Bank macro, markets and people. Every number sourced.';
const canonical = new URL(Astro.url.pathname, 'https://azenha.ai').href;
// Site-level entity markup, homepage only (Google reads WebSite/SearchAction from
// the site root). The SearchAction declares the on-site search so Google can offer
// a sitelinks search box; ?q= is handled by the search overlay below.
const isHome = Astro.url.pathname.replace(/\/$/, '') === base;
const siteLd = isHome ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `https://azenha.ai${base}/#website`,
      url: `https://azenha.ai${base}/`,
      name: 'BullDozer',
      description: 'Marketing analytics & research — public, parsed datasets with sources cited.',
      publisher: { '@id': `https://azenha.ai${base}/#org` },
      inLanguage: 'en',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `https://azenha.ai${base}/explore/?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `https://azenha.ai${base}/#org`,
      name: 'BullDozer',
      url: `https://azenha.ai${base}/`,
      logo: `https://azenha.ai${base}/icon-512.png`,
      founder: { '@type': 'Organization', name: 'Azenha AI', url: 'https://azenha.ai/' },
      sameAs: ['https://azenha.ai/'],
    },
  ],
} : null;
const ogImage = `https://azenha.ai${base}${ogPath ?? '/og.png'}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <meta name="theme-color" content="#0e0f11" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash (default: dark).
      try {
        if (localStorage.getItem('bd-theme') === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f7f6f2');
        }
      } catch (e) { /* private mode etc. */ }
    </script>
    <link rel="apple-touch-icon" href={`${base}/icon-192.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="BullDozer" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <!-- Large previews are what makes a page eligible for Google Discover and for
         big image thumbnails in search; without this Google defaults to small. -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BullDozer" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    {import.meta.env.PROD && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-M2PTQLF903"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-M2PTQLF903');
        </script>
        <script is:inline>
          (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,"clarity","script","xr4rlyhxyo");
        </script>
      </>
    )}
    {siteLd && <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />}
    <!-- Smart App Banner: родная плашка Safari, ведёт в App Store.
         Включена — приложение в продаже. -->
    <meta name="apple-itunes-app" content="app-id=6797664814" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`${base}/`}>
          <span class="mark">B</span>
          <span class="name">Bull<b>Dozer</b></span>
        </a>
        <nav class="nav">
          {nav.map((n) => (
            <a href={n.href} class={active === n.id ? 'active' : ''}>{n.label}</a>
          ))}
          <!-- mobile-only tabs: on desktop these live in the burger -->
          <a href={`${base}/edu/`} class={`nav-extra ${active === 'edu' ? 'active' : ''}`}>Edu</a>
        </nav>
        <div class="header-tools">
          <button type="button" class="hdr-icon" id="hdr-search" aria-label="Search datasets and countries (Cmd+K)">🔍</button>
          <button type="button" class="hdr-icon" id="hdr-theme" aria-label="Toggle light/dark theme">☀️</button>
          <div class="burger-wrap">
            <button type="button" class="hdr-icon" id="hdr-burger" aria-label="More sections" aria-expanded="false" aria-controls="burger-menu">☰</button>
            <nav class="burger-menu" id="burger-menu" hidden>
              {burger.map((n) => (
                n.sep
                  ? <div class="bm-sep" role="separator"></div>
                  : <a href={n.href} class={`bm-${n.id} ${active === n.id ? 'active' : ''}`} {...(n.download ? { download: true } : {})}>{n.label}</a>
              ))}
              <div class="bm-sep" role="separator"></div>
              <button type="button" class="bm-tool" id="bm-search">🔍 Search</button>
              <button type="button" class="bm-tool" id="bm-theme">☀️ Light theme</button>
            </nav>
          </div>
        </div>
      </div>
    </header>
    <div class="srch-overlay" id="srch-overlay" hidden>
      <div class="srch-box" role="dialog" aria-label="Search">
        <input type="search" id="srch-input" placeholder="Search 130+ datasets and 230 countries…" autocomplete="off" />
        <div class="srch-results" id="srch-results"></div>
      </div>
    </div>
    <script is:inline>
      (() => {
        // Theme toggle — same storage/flag the homepage toggle uses.
        const tBtn = document.getElementById('hdr-theme');
        const icon = () => { tBtn.textContent = document.documentElement.getAttribute('data-theme') === 'light' ? '🌙' : '☀️'; };
        tBtn.addEventListener('click', () => {
          const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          if (next === 'light') document.documentElement.setAttribute('data-theme', 'light');
          else document.documentElement.removeAttribute('data-theme');
          try { localStorage.setItem('bd-theme', next); } catch (e) { /* ignore */ }
          var __tc = document.querySelector('meta[name="theme-color"]'); if (__tc) __tc.setAttribute('content', next === 'light' ? '#f7f6f2' : '#0e0f11');
          icon();
        });
        icon();
        // burger copies of the header tools (shown on mobile only)
        const bmTheme = document.getElementById('bm-theme');
        const bmLabel = () => { bmTheme.textContent = document.documentElement.getAttribute('data-theme') === 'light' ? '🌙 Dark theme' : '☀️ Light theme'; };
        bmTheme.addEventListener('click', () => { tBtn.click(); bmLabel(); });
        bmLabel();

        const bBtn = document.getElementById('hdr-burger');
        const menu = document.getElementById('burger-menu');
        const close = () => { menu.hidden = true; bBtn.setAttribute('aria-expanded', 'false'); };
        bBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          menu.hidden = !menu.hidden;
          bBtn.setAttribute('aria-expanded', String(!menu.hidden));
        });
        document.addEventListener('click', (e) => { if (!menu.hidden && !menu.contains(e.target)) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      })();
    </script>
    <script is:inline define:vars={{ base }}>
      (() => {
        // Global search: 🔍 or Cmd/Ctrl+K → overlay over datasets + countries.
        const overlay = document.getElementById('srch-overlay');
        const input = document.getElementById('srch-input');
        const list = document.getElementById('srch-results');
        let index = null, sel = 0, rows = [];
        const open = async () => {
          overlay.hidden = false; input.value = ''; input.focus(); paint([]);
          if (!index) { try { index = await (await fetch(`${base}/data/search.json`)).json(); } catch (e) { index = []; } }
        };
        const close = () => { overlay.hidden = true; };
        const paint = (r) => {
          rows = r; sel = 0;
          list.innerHTML = r.length
            ? r.map(([ic, label, href], i) => `<a class="srch-item${i === 0 ? ' sel' : ''}" href="${base}${href}">${ic} ${label}</a>`).join('')
            : `<p class="srch-empty">${input.value ? 'Nothing found.' : 'Type to search — e.g. “inflation” or “Brazil”.'}</p>`;
        };
        const rank = (q) => {
          q = q.toLowerCase();
          return index
            .map((it) => { const l = it[1].toLowerCase(); const p = l.startsWith(q) ? 0 : l.includes(q) ? 1 : -1; return p < 0 ? null : [p, it]; })
            .filter(Boolean).sort((a, b) => a[0] - b[0] || a[1][1].localeCompare(b[1][1])).slice(0, 12).map((x) => x[1]);
        };
        input.addEventListener('input', () => paint(input.value.trim() && index ? rank(input.value.trim()) : []));
        input.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            sel = Math.max(0, Math.min(rows.length - 1, sel + (e.key === 'ArrowDown' ? 1 : -1)));
            [...list.children].forEach((el, i) => el.classList && el.classList.toggle('sel', i === sel));
            if (list.children[sel]) list.children[sel].scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'Enter' && rows[sel]) location.href = base + rows[sel][2];
        });
        document.getElementById('hdr-search').addEventListener('click', open);
        document.getElementById('bm-search').addEventListener('click', () => { document.getElementById('burger-menu').hidden = true; open(); });
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); overlay.hidden ? open() : close(); }
          else if (e.key === 'Escape') close();
        });
        overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
      })();
    </script>

    <main>
      <slot />
    </main>

    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register(`${base}/sw.js`, { scope: `${base}/` }).catch(() => {}));
      }
    </script>

    <footer class="site-footer">
      <div class="container">
        <span>BullDozer · marketing analytics &amp; research · built on Madeira Ativa</span>
        <span>
          <a href={`${base}/about/`}>About</a> ·
          <a href={`${base}/dashboards/`}>Dashboards</a> ·
          <a href={`${base}/glossary/`}>Glossary</a> ·
          <a href={`${base}/quiz/`}>Quiz</a> ·
          <a href="mailto:agent@azenha.ai">Contact</a> ·
          Public, parsed data only · sources cited per dataset
        </span>
        <span class="map-note">
          <a href="https://www.naturalearthdata.com/about/" target="_blank" rel="noopener" aria-label="Natural Earth"><img class="ne-logo" src={`${base}/natural-earth-logo.png`} alt="Natural Earth" width="405" height="85" /></a>
          Map boundaries are from the <a href="https://www.naturalearthdata.com/about/" target="_blank" rel="noopener">Natural Earth</a> public-domain map dataset and do not imply any endorsement or judgment on the legal status of any territory.
        </span>
      </div>
    </footer>
<!-- Предложение установить приложение — эталон, вставляется перед </body>.
     Источник правды: ~/Projects/_stores/ios-install-hint.html

     Один баннер, два поведения, потому что платформы устроены по-разному:

     Android и десктопный Chromium дают событие beforeinstallprompt — там
     показываем НАСТОЯЩУЮ кнопку, по нажатию открывается системный диалог
     установки. Событие приходит только если сайт установим: манифест с
     иконками 192 и 512, display standalone, https и service worker с
     обработчиком fetch. Без воркера кнопки не будет вовсе.

     Safari beforeinstallprompt не поддерживает и не будет, а на iOS ВСЕ
     браузеры обязаны работать на движке Safari — значит и Chrome с Firefox
     там ведут себя так же. Остаётся подсказать, где кнопка «Поделиться».

     Показываем только когда уместно: страница ещё не открыта как приложение и
     человек подсказку не закрывал. Закрытие помним в localStorage — баннер,
     возвращающийся на каждой странице, раздражает сильнее, чем помогает.

     Проверка на iPadOS отдельная: с 13-й версии iPad представляется
     макинтошем, и обычный /iPad/ по userAgent его больше не ловит — ловим по
     наличию тач-точек у платформы MacIntel. -->
<div id="a2hs" hidden>
  <p id="a2hs-text"></p>
  <button type="button" id="a2hs-go" hidden>Install</button>
  <button type="button" id="a2hs-x" aria-label="Dismiss">&times;</button>
</div>
<style>
  #a2hs{position:fixed;left:12px;right:12px;bottom:12px;z-index:9999;
    display:flex;align-items:center;gap:10px;padding:12px 14px;
    border-radius:12px;border:1px solid rgba(255,255,255,.18);
    background:rgba(20,26,22,.94);color:#f2f5f3;
    font:14px/1.35 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    box-shadow:0 6px 24px rgba(0,0,0,.35);
    /* Дом-бар у айфонов без кнопки перекрывает нижние 34pt. */
    margin-bottom:env(safe-area-inset-bottom,0)}
  #a2hs[hidden]{display:none}
  #a2hs p{margin:0;flex:1}
  #a2hs strong{white-space:nowrap}
  #a2hs button{flex:none;border:0;border-radius:8px;color:inherit;cursor:pointer;
    font:inherit;background:rgba(255,255,255,.12)}
  #a2hs-go{padding:7px 14px;font-weight:600;background:#2f7d5d;color:#fff}
  #a2hs-go[hidden]{display:none}
  #a2hs-x{width:28px;height:28px;font-size:18px;line-height:1}
</style>
<script>
  (function () {
    var el = document.getElementById('a2hs');
    if (!el) return;
    var txt = document.getElementById('a2hs-text');
    var go = document.getElementById('a2hs-go');
    var KEY = 'a2hs-dismissed';

    var dismissed = false;
    try { dismissed = localStorage.getItem(KEY) === '1'; } catch (e) {}
    var installed = window.navigator.standalone === true ||
                    (window.matchMedia &&
                     window.matchMedia('(display-mode: standalone)').matches);
    if (dismissed || installed) return;

    document.getElementById('a2hs-x').addEventListener('click', function () {
      el.hidden = true;
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });

    // Android / Chromium: настоящая установка.
    var deferred = null;
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferred = e;
      txt.textContent = 'Install this as an app — it opens without a browser bar and works offline.';
      go.hidden = false;
      el.hidden = false;
    });
    go.addEventListener('click', function () {
      if (!deferred) return;
      deferred.prompt();
      deferred.userChoice.then(function () {
        el.hidden = true;
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
      });
      deferred = null;
    });
    window.addEventListener('appinstalled', function () {
      el.hidden = true;
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });

    // iOS: кнопки нет, показываем дорогу к ней.
    var ua = navigator.userAgent;
    var iOS = /iPhone|iPod|iPad/.test(ua) ||
              (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (iOS) {
      txt.innerHTML = 'Install this as an app: tap <strong>Share</strong>, ' +
                      'then <strong>Add to Home Screen</strong>.';
      // Не сразу: подсказка на первой секунде читается как реклама.
      setTimeout(function () { if (!deferred) el.hidden = false; }, 2500);
    }
  })();
</script>
  </body>
</html>
