---
import '../styles/global.css';
import { datasets } from '@data/datasets';
import { buildCountryIndex } from '@lib/countryIndex';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'news' | 'ask' | 'apps' | 'explore' | 'sources' | 'surveys' | 'macro' | 'markets' | 'geo' | 'edu' | 'quiz' | 'glossary';
  /** Path (under base) to a page-specific OG image, e.g. `/og/whr-happiness.png`. */
  ogPath?: string;
}
const { title, description, active, ogPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Primary data sections stay as tabs; the rest lives in the burger menu
// (same pattern as the Ativa app: switcher + burger on the right edge).
const nav = [
  { id: 'news', label: 'New', href: `${base}/` },
  { id: 'ask', label: 'Ask AI', href: `${base}/ask/` },
  { id: 'explore', label: 'Top', href: `${base}/explore/` },
  { id: 'macro', label: 'Macro', href: `${base}/macro/` },
  { id: 'markets', label: 'Biz', href: `${base}/markets/` },
  { id: 'surveys', label: 'Polls', href: `${base}/surveys/` },
  { id: 'geo', label: 'Geo', href: `${base}/geo/` },
];
// The burger is a *complete* menu — mirrors every section (so it works as the
// only nav on mobile) plus tools, the app link and the theme toggle.
const burger = [
  { id: 'news', label: '📰 New', href: `${base}/` },
  { id: 'ask', label: '✨ Ask AI', href: `${base}/ask/` },
  { id: 'explore', label: '🔎 Top', href: `${base}/explore/` },
  { id: 'macro', label: '📈 Macro', href: `${base}/macro/` },
  { id: 'markets', label: '💼 Biz', href: `${base}/markets/` },
  { id: 'surveys', label: '🗳️ Polls', href: `${base}/surveys/` },
  { id: 'geo', label: '🌍 Geo', href: `${base}/geo/` },
  { id: 'edu', label: '🎓 Edu', href: `${base}/edu/` },
  { sep: true },
  { id: 'quiz', label: '🎲 Country quiz', href: `${base}/quiz/` },
  { id: 'glossary', label: '📖 Glossary', href: `${base}/glossary/` },
  { id: 'about', label: 'ℹ️ About', href: `${base}/about/` },
  { id: 'contact', label: '✉️ Contact', href: 'mailto:agent@azenha.ai' },
  { sep: true },
  // Points at the apps page rather than straight at the APK: iPhone users tapping
  // "Get the app" were being handed an Android package they can't install.
  { id: 'apps', label: '📱 Get the app', href: `${base}/apps/` },
  { id: 'bot', label: '🤖 Telegram bot', href: 'https://t.me/bulldozer_ebot' },
];
// Bottom bar on phones: the app's seven tabs in the app's order, so someone
// who uses both never has to look for anything (Madeira Ativa does the same).
// Stats is the app's Statistics tab, which on the site is Macro; Top lights it
// too, since both are cross-country rankings.
const tabs = [
  { ids: ['news', 'home'], label: 'Home', href: `${base}/`, d: 'M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z' },
  { ids: ['ask'], label: 'Ask AI', href: `${base}/ask/`, d: 'M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z' },
  { ids: ['macro', 'explore'], label: 'Stats', href: `${base}/macro/`, d: 'M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z' },
  { ids: ['markets'], label: 'Biz', href: `${base}/markets/`, d: 'M10 16v-1H3.01L3 19c0 1.11.89 2 2 2h14c1.11 0 2-.89 2-2v-4h-7v1h-4zm10-9h-4.01V5l-2-2h-4l-2 2v2H4c-1.1 0-2 .9-2 2v3c0 1.11.89 2 2 2h6v-2h4v2h6c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2zm-6 0h-4V5h4v2z' },
  { ids: ['surveys'], label: 'Polls', href: `${base}/surveys/`, d: 'M18 13h-.68l-2 2h1.91L19 17H5l1.78-2h2.05l-2-2H6l-3 3v4c0 1.1.89 2 1.99 2H19c1.1 0 2-.89 2-2v-4l-3-3zm-1-5.05l-4.95 4.95-3.54-3.54 4.95-4.95L17 7.95zm-4.24-5.66L6.39 8.66c-.39.39-.39 1.02 0 1.41l4.95 4.95c.39.39 1.02.39 1.41 0l6.36-6.36c.39-.39.39-1.02 0-1.41L14.16 2.3c-.38-.4-1.01-.4-1.4-.01z' },
  { ids: ['geo'], label: 'Geo', href: `${base}/geo/`, d: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z' },
  { ids: ['edu'], label: 'Edu', href: `${base}/edu/`, d: 'M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z' },
];
const fullTitle = title ? `${title} · BullDozer` : 'BullDozer — Marketing Analytics & Research';
// Counts are read from the data, not typed: the typed ones said 188 and 130+
// long after the catalogue passed 230.
const nDatasets = datasets.length;
const nCountries = buildCountryIndex().length;
const desc = description ?? `Bulldoze the noise. Mine the signal. ${nDatasets} public, parsed datasets — surveys, IMF & World Bank macro, markets and people. Every number sourced.`;
const canonical = new URL(Astro.url.pathname, 'https://azenha.ai').href;
// Site-level entity markup, homepage only (Google reads WebSite/SearchAction from
// the site root). The SearchAction declares the on-site search so Google can offer
// a sitelinks search box. Any page opened with ?q= opens the search overlay
// below with that query filled in, so the root is the lightest valid target.
const isHome = Astro.url.pathname.replace(/\/$/, '') === base;
const siteLd = isHome ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `https://azenha.ai${base}/#website`,
      url: `https://azenha.ai${base}/`,
      name: 'BullDozer',
      description: 'Marketing analytics & research — public, parsed datasets with sources cited.',
      publisher: { '@id': `https://azenha.ai${base}/#org` },
      inLanguage: 'en',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `https://azenha.ai${base}/?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `https://azenha.ai${base}/#org`,
      name: 'BullDozer',
      url: `https://azenha.ai${base}/`,
      logo: `https://azenha.ai${base}/icon-512.png`,
      founder: { '@type': 'Organization', name: 'Azenha AI', url: 'https://azenha.ai/' },
      sameAs: ['https://azenha.ai/'],
    },
    // The apps, so search can show them with the site (16 Nov 2026, SEO
    // session). Category follows the App Store's primary genre, Education.
    {
      '@type': 'MobileApplication',
      '@id': `https://azenha.ai${base}/#app`,
      name: 'BullDozer Stats',
      operatingSystem: 'iOS, Android',
      applicationCategory: 'EducationalApplication',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      url: `https://azenha.ai${base}/`,
      downloadUrl: [
        'https://apps.apple.com/app/id6797664814',
        'https://play.google.com/store/apps/details?id=ai.azenha.bulldozer',
      ],
      sameAs: [
        'https://apps.apple.com/app/id6797664814',
        'https://play.google.com/store/apps/details?id=ai.azenha.bulldozer',
      ],
      publisher: { '@type': 'Organization', name: 'Azenha AI', url: 'https://azenha.ai/' },
    },
  ],
} : null;
const ogImage = `https://azenha.ai${base}${ogPath ?? '/og.png'}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <meta name="theme-color" content="#0e0f11" />
    <script is:inline>
      // Theme, decided before first paint so there is no flash of the wrong one.
      // A choice the visitor made (bd-theme = light | dark) wins; without one the
      // site follows the OS setting, and keeps following it if that changes
      // (it used to be dark for everyone until toggled). The html[data-theme]
      // attribute is the single source of truth: every toggle label is chosen
      // from it in CSS (.th-to-light / .th-to-dark), so they cannot disagree.
      (function () {
        var d = document.documentElement;
        var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: light)') : null;
        var saved = function () {
          try { var v = localStorage.getItem('bd-theme'); return v === 'light' || v === 'dark' ? v : null; }
          catch (e) { return null; }
        };
        var apply = function (t) {
          if (t === 'light') d.setAttribute('data-theme', 'light'); else d.removeAttribute('data-theme');
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'light' ? '#f7f6f2' : '#0e0f11');
        };
        var current = function () { return d.getAttribute('data-theme') === 'light' ? 'light' : 'dark'; };
        apply(saved() || (mq && mq.matches ? 'light' : 'dark'));
        window.bdTheme = {
          get: current,
          toggle: function () {
            var next = current() === 'light' ? 'dark' : 'light';
            apply(next);
            try { localStorage.setItem('bd-theme', next); } catch (e) { /* private mode */ }
          },
        };
        if (mq) {
          var follow = function (e) { if (!saved()) apply(e.matches ? 'light' : 'dark'); };
          if (mq.addEventListener) mq.addEventListener('change', follow);
          else if (mq.addListener) mq.addListener(follow);
        }
        // Every [data-theme-toggle] on the page, present now or rendered later.
        document.addEventListener('click', function (e) {
          var t = e.target && e.target.closest && e.target.closest('[data-theme-toggle]');
          if (t) window.bdTheme.toggle();
        });
      })();
    </script>
    <link rel="apple-touch-icon" href={`${base}/icon-192.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="BullDozer" />
    <!-- Chrome's "Add to home screen" shortcut (the icon with a Chrome badge)
         took the page title, which the launcher cut to "BullDoz…"; this is the
         name it should use. An installed app takes short_name from the manifest. -->
    <meta name="application-name" content="BullDozer" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <!-- Large previews are what makes a page eligible for Google Discover and for
         big image thumbnails in search; without this Google defaults to small. -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BullDozer" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    {import.meta.env.PROD && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-M2PTQLF903"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-M2PTQLF903');
        </script>
        <script is:inline>
          (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,"clarity","script","xr4rlyhxyo");
        </script>
      </>
    )}
    {siteLd && <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />}
    <!-- Smart App Banner: Safari's own strip, linking to the App Store.
         Enabled now that the app is published. -->
    <meta name="apple-itunes-app" content="app-id=6797664814" />
  </head>
  <body>
    <script is:inline>
      // Inside an app's web view the app draws its own bar underneath.
      // The iOS app opens pages in Safari's view controller, which cannot be told
      // apart from Safari by its user agent, so it marks the first URL with
      // ?app=1; the mark is kept for the visit so links followed inside keep it.
      (function () {
        var mark = /[?&](app|embed)=/.test(location.search) || /; wv\)/.test(navigator.userAgent);
        try {
          if (mark) sessionStorage.setItem('bd-in-app', '1');
          else mark = sessionStorage.getItem('bd-in-app') === '1';
        } catch (e) {}
        if (mark) document.documentElement.classList.add('in-app');
      })();
      // A home-screen web app on iOS is woken from memory, never reloaded, and
      // has no reload button: a page opened in the morning was still showing
      // that evening, without the changes made in between. Back after two
      // hours or more, it reloads.
      (function () {
        var standalone = window.navigator.standalone === true ||
          (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches);
        if (!standalone) return;
        var hidden = 0;
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) { hidden = Date.now(); return; }
          if (hidden && Date.now() - hidden > 2 * 3600 * 1000) location.reload();
        });
      })();
    </script>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`${base}/`}>
          <span class="mark">B</span>
          <span class="name">Bull<b>Dozer</b></span>
        </a>
        <nav class="nav">
          {nav.map((n) => (
            <a href={n.href} class={active === n.id ? 'active' : ''}>{n.label}</a>
          ))}
          <!-- mobile-only tabs: on desktop these live in the burger -->
          <a href={`${base}/edu/`} class={`nav-extra ${active === 'edu' ? 'active' : ''}`}>Edu</a>
        </nav>
        <div class="header-tools">
          <button type="button" class="hdr-icon" id="hdr-search" aria-label="Search datasets and countries (Cmd+K)">🔍</button>
          <button type="button" class="hdr-icon" id="hdr-theme" data-theme-toggle aria-label="Toggle light/dark theme"><span class="th-to-light" aria-hidden="true">☀️</span><span class="th-to-dark" aria-hidden="true">🌙</span></button>
          <div class="burger-wrap">
            <button type="button" class="hdr-icon" id="hdr-burger" aria-label="More sections" aria-expanded="false" aria-controls="burger-menu">☰</button>
            <nav class="burger-menu" id="burger-menu" hidden>
              {burger.map((n) => (
                n.sep
                  ? <div class="bm-sep" role="separator"></div>
                  : <a href={n.href} class={`bm-${n.id} ${active === n.id ? 'active' : ''}`} {...(n.download ? { download: true } : {})}>{n.label}</a>
              ))}
              <div class="bm-sep" role="separator"></div>
              <button type="button" class="bm-tool" id="bm-search">🔍 Search</button>
              <button type="button" class="bm-tool" id="bm-theme" data-theme-toggle><span class="th-to-light">☀️ Light theme</span><span class="th-to-dark">🌙 Dark theme</span></button>
            </nav>
          </div>
        </div>
      </div>
    </header>
    <div class="srch-overlay" id="srch-overlay" hidden>
      <div class="srch-box" role="dialog" aria-label="Search">
        <input type="search" id="srch-input" placeholder={`Search ${nDatasets} datasets and ${nCountries} countries…`} autocomplete="off" />
        <div class="srch-results" id="srch-results"></div>
      </div>
    </div>
    <script is:inline>
      (() => {
        // Theme toggles are wired once, in the head script (data-theme-toggle).
        // html.menu-open lifts the header above the bottom tab bar while the
        // burger is open (the bar used to draw over the menu's last items).
        const bBtn = document.getElementById('hdr-burger');
        const menu = document.getElementById('burger-menu');
        const close = () => { menu.hidden = true; bBtn.setAttribute('aria-expanded', 'false'); document.documentElement.classList.remove('menu-open'); };
        bBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          menu.hidden = !menu.hidden;
          bBtn.setAttribute('aria-expanded', String(!menu.hidden));
          document.documentElement.classList.toggle('menu-open', !menu.hidden);
          if (!menu.hidden) menu.scrollTop = 0;
        });
        document.addEventListener('click', (e) => { if (!menu.hidden && !menu.contains(e.target)) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      })();
    </script>
    <script is:inline define:vars={{ base }}>
      (() => {
        // Global search: 🔍 or Cmd/Ctrl+K → overlay over datasets + countries.
        const overlay = document.getElementById('srch-overlay');
        const input = document.getElementById('srch-input');
        const list = document.getElementById('srch-results');
        let index = null, sel = 0, rows = [];
        const open = async (initial) => {
          overlay.hidden = false; input.value = typeof initial === 'string' ? initial : ''; input.focus(); paint([]);
          if (!index) { try { index = await (await fetch(`${base}/data/search.json`)).json(); } catch (e) { index = []; } }
          // Whatever was typed (or passed in) while the index loaded is ranked now.
          if (input.value.trim()) paint(rank(input.value.trim()));
        };
        const close = () => { overlay.hidden = true; };
        const paint = (r) => {
          rows = r; sel = 0;
          list.innerHTML = r.length
            ? r.map(([ic, label, href], i) => `<a class="srch-item${i === 0 ? ' sel' : ''}" href="${base}${href}">${ic} ${label}</a>`).join('')
            : `<p class="srch-empty">${input.value ? 'Nothing found.' : 'Type to search — e.g. “inflation” or “Brazil”.'}</p>`;
        };
        const rank = (q) => {
          q = q.toLowerCase();
          return index
            .map((it) => { const l = it[1].toLowerCase(); const p = l.startsWith(q) ? 0 : l.includes(q) ? 1 : -1; return p < 0 ? null : [p, it]; })
            .filter(Boolean).sort((a, b) => a[0] - b[0] || a[1][1].localeCompare(b[1][1])).slice(0, 12).map((x) => x[1]);
        };
        input.addEventListener('input', () => paint(input.value.trim() && index ? rank(input.value.trim()) : []));
        input.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            sel = Math.max(0, Math.min(rows.length - 1, sel + (e.key === 'ArrowDown' ? 1 : -1)));
            [...list.children].forEach((el, i) => el.classList && el.classList.toggle('sel', i === sel));
            if (list.children[sel]) list.children[sel].scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'Enter' && rows[sel]) location.href = base + rows[sel][2];
        });
        document.getElementById('hdr-search').addEventListener('click', () => open());
        document.getElementById('bm-search').addEventListener('click', () => {
          document.getElementById('burger-menu').hidden = true;
          document.getElementById('hdr-burger').setAttribute('aria-expanded', 'false');
          document.documentElement.classList.remove('menu-open');
          open();
        });
        // ?q=… (the WebSite SearchAction in the structured data, or a shared
        // link) opens the search with that query already filled in. Ask AI
        // reads ?q= as its own question, so it is left alone there.
        const q0 = new URLSearchParams(location.search).get('q');
        if (q0 && q0.trim() && !/\/ask\/?$/.test(location.pathname)) open(q0.trim().slice(0, 100));
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); overlay.hidden ? open() : close(); }
          else if (e.key === 'Escape') close();
        });
        overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
      })();
    </script>

    <main>
      <slot />
    </main>

    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register(`${base}/sw.js`, { scope: `${base}/` }).catch(() => {}));
      }
    </script>

    <footer class="site-footer">
      <div class="container">
        <span>BullDozer · marketing analytics &amp; research · built on Madeira Ativa</span>
        <span>
          <a href={`${base}/about/`}>About</a> ·
          <a href={`${base}/dashboards/`}>Dashboards</a> ·
          <a href={`${base}/glossary/`}>Glossary</a> ·
          <a href={`${base}/licences/`}>Licences</a> ·
          <a href={`${base}/quiz/`}>Quiz</a> ·
          <a href="mailto:agent@azenha.ai">Contact</a> ·
          <a href="https://azenha.ai/apps/">Apps</a> ·
          Public, parsed data only · sources cited per dataset
        </span>
        <span class="map-note">
          <a href="https://www.naturalearthdata.com/about/" target="_blank" rel="noopener" aria-label="Natural Earth"><img class="ne-logo" src={`${base}/natural-earth-logo.png`} alt="Natural Earth" width="405" height="85" /></a>
          <!-- one flex item, so the sentence wraps as text instead of breaking around its link -->
          <span>Map boundaries are from the <a href="https://www.naturalearthdata.com/about/" target="_blank" rel="noopener">Natural Earth</a> public-domain map dataset and do not imply any endorsement or judgment on the legal status of any territory.</span>
        </span>
      </div>
    </footer>
    <nav class="tabbar" aria-label="Sections">
      {tabs.map((t) => {
        const on = t.ids.includes(active ?? '') || (isHome && t.ids.includes('home'));
        return (
          <a href={t.href} class={on ? 'on' : ''} aria-current={on ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.d} /></svg>
            <span>{t.label}</span>
          </a>
        );
      })}
    </nav>
{/* Install prompt, inserted before </body>. A JSX comment, so it is not
     shipped in the HTML (an HTML comment here leaked a local path into every page).

     One banner, two behaviours, because the platforms differ:

     Android and desktop Chromium fire beforeinstallprompt, so there we show a
     REAL button that opens the system install dialog. The event only arrives
     when the site is installable: a manifest with 192 and 512 icons, display
     standalone, https, and a service worker with a fetch handler. Without the
     worker there is no button at all.

     Safari does not support beforeinstallprompt and never will, and on iOS
     EVERY browser must run on Safari's engine — so Chrome and Firefox behave
     the same there. All that is left is to point at the Share button.

     Shown only when it makes sense: the page is not already running as an app
     and the visitor has not dismissed the hint. The dismissal is remembered in
     localStorage — a banner that returns on every page annoys more than helps.

     iPadOS needs its own check: since version 13 an iPad reports itself as a
     Mac, so a plain /iPad/ userAgent test no longer catches it — we detect it
     by MacIntel reporting touch points. */}
<div id="a2hs" hidden>
  <p id="a2hs-text"></p>
  <button type="button" id="a2hs-go" hidden>Install</button>
  <button type="button" id="a2hs-x" aria-label="Dismiss">&times;</button>
</div>
<style>
  #a2hs{position:fixed;left:12px;right:12px;bottom:12px;z-index:9999;
    display:flex;align-items:center;gap:10px;padding:12px 14px;
    border-radius:12px;border:1px solid rgba(255,255,255,.18);
    background:rgba(20,26,22,.94);color:#f2f5f3;
    font:14px/1.35 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    box-shadow:0 6px 24px rgba(0,0,0,.35);
    /* The home bar on button-less iPhones covers the bottom 34pt. */
    margin-bottom:env(safe-area-inset-bottom,0)}
  #a2hs[hidden]{display:none}
  #a2hs p{margin:0;flex:1}
  #a2hs strong{white-space:nowrap}
  #a2hs button{flex:none;border:0;border-radius:8px;color:inherit;cursor:pointer;
    font:inherit;background:rgba(255,255,255,.12)}
  #a2hs #a2hs-go{padding:7px 14px;font-weight:700;background:#ffb000;color:#1a1300;white-space:nowrap}
  #a2hs-go[hidden]{display:none}
  /* 44px: the 28px cross was easy to miss with a thumb. */
  #a2hs #a2hs-x{width:44px;height:44px;font-size:22px;line-height:1;margin:-8px -8px -8px 0;background:transparent}
  /* Desktop: a compact card in the corner rather than a full-width strip, which
     lay across the controls at the bottom of whatever panel was on screen. */
  @media (min-width:761px){#a2hs{left:auto;right:16px;bottom:16px;max-width:420px}}
</style>
<script>
  (function () {
    var el = document.getElementById('a2hs');
    if (!el) return;
    var txt = document.getElementById('a2hs-text');
    var go = document.getElementById('a2hs-go');
    var KEY = 'a2hs-dismissed';

    var ua = navigator.userAgent;
    var iOS = /iPhone|iPod|iPad/.test(ua) ||
              (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    var installed = window.navigator.standalone === true ||
                    (window.matchMedia &&
                     window.matchMedia('(display-mode: standalone)').matches);
    // Inside an app's web view the reader already has the app.
    if (document.documentElement.classList.contains('in-app')) return;
    // On Ask AI the banner would sit over the Ask button.
    if (/\/ask\/?$/.test(location.pathname)) return;
    // On the apps page the store badges are the page itself.
    if (/\/apps\/?$/.test(location.pathname)) return;

    // iPhone and iPad: the App Store app is the better install — offline,
    // Ask AI, the same seven tabs — so offer it instead of Add to Home Screen,
    // and offer it again to whoever already put the web version on their
    // home screen. Its own dismissal: closing the old hint was not a no to this.
    // The app needs iOS 15; below that the App Store would offer nothing.
    var iosMajor = +((ua.match(/OS (\d+)_/) || [])[1] || 99);
    if (iOS && iosMajor < 15) iOS = false;
    if (iOS) {
      var AKEY = 'appstore-dismissed';
      try { if (localStorage.getItem(AKEY) === '1') return; } catch (e) {}
      txt.innerHTML = installed
        ? 'You are using the web version. <strong>BullDozer Stats</strong> is in the App Store — faster, works offline.'
        : '<strong>BullDozer Stats</strong> is in the App Store — faster, works offline, with Ask AI.';
      go.textContent = 'Get the app';
      go.hidden = false;
      go.addEventListener('click', function () {
        try { localStorage.setItem(AKEY, '1'); } catch (e) {}
        location.href = 'https://apps.apple.com/app/id6797664814';
      });
      document.getElementById('a2hs-x').addEventListener('click', function () {
        el.hidden = true;
        try { localStorage.setItem(AKEY, '1'); } catch (e) {}
      });
      // Not immediately: a hint in the first second reads as an ad.
      setTimeout(function () { el.hidden = false; }, 2500);
      return;
    }

    // Android phones and tablets: the site's own strip (azenha.ai's
    // functions/_middleware.js) already offers Google Play and the APK on every
    // /bulldozer/ page, so a second banner here would stack on top of it.
    if (/Android/.test(ua)) return;

    var dismissed = false;
    try { dismissed = localStorage.getItem(KEY) === '1'; } catch (e) {}
    if (dismissed || installed) return;

    document.getElementById('a2hs-x').addEventListener('click', function () {
      el.hidden = true;
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });

    // Desktop Chromium: a real install of the web app.
    var deferred = null;
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferred = e;
      txt.textContent = 'Install this as an app — it opens without a browser bar and works offline.';
      go.hidden = false;
      el.hidden = false;
    });
    go.addEventListener('click', function () {
      if (!deferred) return;
      deferred.prompt();
      deferred.userChoice.then(function () {
        el.hidden = true;
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
      });
      deferred = null;
    });
    window.addEventListener('appinstalled', function () {
      el.hidden = true;
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });

  })();
</script>
<script is:inline>
  // Bottom chrome. Two fixed strips can sit at the bottom of the screen: the
  // install banner above (#a2hs) and, on Android, azenha.ai's Google Play / APK
  // strip (#az-apk), which the site's middleware appends after this point and
  // removes when dismissed. While one is showing, its height goes into
  // --apk-h / --a2hs-h, and global.css lifts the tab bar above the strip and
  // pads the page so the footer's last lines can still be scrolled clear.
  (function () {
    var root = document.documentElement;
    var seen = {};
    var mo = window.MutationObserver ? new MutationObserver(function () { sync(); }) : null;
    var ro = window.ResizeObserver ? new ResizeObserver(function () { sync(); }) : null;
    function shown(el) {
      return !!el && el.isConnected !== false && !el.hidden && getComputedStyle(el).display !== 'none';
    }
    function watch(id) {
      var el = document.getElementById(id);
      if (el && seen[id] !== el) {
        seen[id] = el;
        if (mo) mo.observe(el, { attributes: true, attributeFilter: ['hidden', 'style', 'class'] });
        if (ro) ro.observe(el);
      }
      return el;
    }
    var last = '';
    function sync() {
      var apk = watch('az-apk'), a2 = watch('a2hs');
      var ah = shown(apk) ? Math.ceil(apk.offsetHeight) : 0;
      // the banner floats 12px above whatever is under it; reserve that gap twice
      var bh = shown(a2) ? Math.ceil(a2.offsetHeight) + 24 : 0;
      var key = ah + ',' + bh;
      if (key === last) return;
      last = key;
      root.style.setProperty('--apk-h', ah + 'px');
      root.style.setProperty('--a2hs-h', bh + 'px');
      root.classList.toggle('apk-on', ah > 0);
    }
    // The strip arrives as the last child of <body> and leaves the same way.
    if (mo) mo.observe(document.body, { childList: true });
    document.addEventListener('DOMContentLoaded', sync);
    window.addEventListener('load', sync);
    window.addEventListener('resize', sync);
    document.addEventListener('click', function () { setTimeout(sync, 0); }, true);
    sync();
  })();
</script>
  </body>
</html>
