---
// Share-link + PNG-export buttons under a chart. `svg` is a CSS selector for
// the chart's <svg> (omit for HTML-only charts — share link only). `hash` pins
// the copied URL to the chart's section anchor. Script is hoisted once per page.
// `title`, `source`, `period` and `url` go into the PNG's footer, so an image
// shared on its own still says what it shows and where it is from. Without
// them the export falls back to the section heading, the page's provenance
// line and the page address. A chart can override the period at export time
// with data-period on its <svg> (the map does, for the period on screen).
interface Props { name: string; svg?: string; hash?: string; title?: string; source?: string; period?: string; url?: string }
const { name, svg, hash, title, source, period, url } = Astro.props;
// The same two glyphs are drawn into exported PNGs (see the script below).
const APPLE = 'M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.7-3.1.7-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4 0 0-2.7-1-2.7-3.4ZM14.3 6.6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2Z';
const PLAY = 'M4.6 2.6a1 1 0 0 0-.5.9v17a1 1 0 0 0 .5.9l9.1-9.4-9.1-9.4Zm10.2 8.3 2.9-3-9.9-5.6 7 8.6Zm0 2.2-7 8.6 9.9-5.6-2.9-3Zm4.1-2.2-2.4-1.4-3 3.5 3 3.5 2.4-1.4c.9-.5.9-1.7 0-2.2Z';
---
<p class="chart-actions" style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-top:12px">
  <button type="button" class="ghost-btn ca-share" data-hash={hash} style="margin:0">🔗 Copy link</button>
  {svg && <button type="button" class="ghost-btn ca-png" data-svg={svg} data-name={name} data-title={title} data-source={source} data-period={period} data-url={url} style="margin:0">↓ PNG</button>}
  <span class="chart-src" style="margin-left:auto; display:inline-flex; flex-direction:column; align-items:center; gap:2px; line-height:1.2; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.04em">
    <span style="display:inline-flex; align-items:center; gap:6px; color:var(--accent,#ffb000); font-size:12px; font-weight:700">
      <a href="https://apps.apple.com/app/id6797664814" aria-label="BullDozer Stats on the App Store" title="App Store" style="color:inherit; display:inline-flex"><svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path fill="currentColor" d={APPLE} /></svg></a>
      <a href="https://play.google.com/store/apps/details?id=ai.azenha.bulldozer" aria-label="BullDozer Stats on Google Play" title="Google Play" style="color:inherit; display:inline-flex"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path fill="currentColor" d={PLAY} /></svg></a>
      <span>BULLDOZER STATS</span>
    </span>
    <span style="font-size:11px; color:var(--muted,#8b8f98)">azenha.ai/bulldozer</span>
  </span>
</p>
<script>
  const STORES = 'App Store · Google Play';
  const MONO = 'font-family:ui-monospace,SFMono-Regular,Menlo,monospace';

  interface Meta { title: string; source: string; period: string; url: string }

  // What the chart is, for the footer: explicit props first, then what the
  // page itself says (section heading, provenance pill, canonical address).
  function metaFor(svg: SVGSVGElement, btn: HTMLElement): Meta {
    const sec = btn.closest('section') || svg.closest('section');
    const heading = sec?.querySelector('h2, h1')?.textContent?.trim() || document.querySelector('h1')?.textContent?.trim() || document.title;
    const prov = document.querySelector('.prov .pill b')?.textContent?.trim() || '';
    const canon = (document.querySelector('link[rel="canonical"]') as HTMLLinkElement | null)?.href;
    return {
      title: btn.dataset.title || heading || '',
      source: btn.dataset.source || prov,
      period: svg.dataset.period || btn.dataset.period || '',
      url: (btn.dataset.url || canon || location.origin + location.pathname).replace(/^https?:\/\//, ''),
    };
  }

  // Cut a line to what fits in `w` px of monospace text at `fs` px.
  const fit = (t: string, w: number, fs: number) => {
    const max = Math.max(8, Math.floor(w / (fs * 0.61)));
    return t.length > max ? t.slice(0, max - 1) + '…' : t;
  };

  // Rasterise a live <svg> to a downloadable PNG: clone it, bake computed CSS
  // into inline styles (stylesheets don't travel into the blob), add an opaque
  // background and a footer (title, source and period, the dataset address,
  // the app in both stores), then draw through an <img> onto a 2x canvas.
  async function toPng(svg: SVGSVGElement, name: string, meta: Meta) {
    const vb = svg.viewBox && svg.viewBox.baseVal;
    const w = vb && vb.width ? vb.width : svg.clientWidth || 900;
    const h = vb && vb.height ? vb.height : svg.clientHeight || 480;
    const clone = svg.cloneNode(true) as SVGSVGElement;
    const src = [svg, ...svg.querySelectorAll('*')];
    const dst = [clone, ...clone.querySelectorAll('*')];
    const PROPS = ['fill', 'fill-opacity', 'stroke', 'stroke-width', 'stroke-dasharray', 'stroke-linecap',
      'opacity', 'font-family', 'font-size', 'font-weight', 'letter-spacing', 'text-anchor', 'dominant-baseline'];
    src.forEach((s, i) => {
      const cs = getComputedStyle(s);
      (dst[i] as Element).setAttribute('style', PROPS.map((p) => `${p}:${cs.getPropertyValue(p)}`).join(';'));
    });
    const NS = 'http://www.w3.org/2000/svg';
    const pad = 12;
    const fsT = w < 420 ? 11 : 13, fsS = w < 420 ? 9 : 11;
    const lines: { t: string; fs: number; fill: string; bold?: boolean }[] = [];
    const bodyCs = getComputedStyle(document.body);
    const textCol = bodyCs.color || '#e7e9ec';
    if (meta.title) lines.push({ t: meta.title, fs: fsT, fill: textCol, bold: true });
    const sp = [meta.source && `Source: ${meta.source}`, meta.period && `Period: ${meta.period}`].filter(Boolean).join(' · ');
    if (sp) lines.push({ t: sp, fs: fsS, fill: '#8b8f98' });
    lines.push({ t: meta.url, fs: fsS, fill: '#8b8f98' });
    const FOOT = 12 + lines.reduce((a, l) => a + l.fs + 6, 0) + 18 + 10; // lines, the store line, bottom margin
    clone.setAttribute('xmlns', NS);
    clone.setAttribute('width', String(w));
    clone.setAttribute('height', String(h + FOOT));
    clone.setAttribute('viewBox', `0 0 ${w} ${h + FOOT}`);
    const bg = document.createElementNS(NS, 'rect');
    bg.setAttribute('width', String(w)); bg.setAttribute('height', String(h + FOOT));
    bg.setAttribute('fill', bodyCs.backgroundColor || '#0e0f11');
    clone.insertBefore(bg, clone.firstChild);
    const rule = document.createElementNS(NS, 'line');
    rule.setAttribute('x1', String(pad)); rule.setAttribute('x2', String(w - pad));
    rule.setAttribute('y1', String(h + 4)); rule.setAttribute('y2', String(h + 4));
    rule.setAttribute('stroke', '#8b8f98'); rule.setAttribute('stroke-opacity', '0.4');
    clone.appendChild(rule);
    let y = h + 12;
    for (const l of lines) {
      y += l.fs + 4;
      const t = document.createElementNS(NS, 'text');
      t.setAttribute('x', String(pad)); t.setAttribute('y', String(y));
      t.setAttribute('fill', l.fill);
      t.setAttribute('style', `${MONO};font-size:${l.fs}px${l.bold ? ';font-weight:700' : ''}`);
      t.textContent = fit(l.t, w - 2 * pad, l.fs);
      clone.appendChild(t);
      y += 2;
    }
    // Store line: both glyphs, the app name, and where to get it.
    y += 18;
    const glyph = (d: string, x: number) => {
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', d); p.setAttribute('fill', '#ffb000');
      p.setAttribute('transform', `translate(${x} ${y - 11}) scale(0.55)`);
      clone.appendChild(p);
    };
    glyph('M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.7-3.1.7-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4 0 0-2.7-1-2.7-3.4ZM14.3 6.6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2Z', pad);
    glyph('M4.6 2.6a1 1 0 0 0-.5.9v17a1 1 0 0 0 .5.9l9.1-9.4-9.1-9.4Zm10.2 8.3 2.9-3-9.9-5.6 7 8.6Zm0 2.2-7 8.6 9.9-5.6-2.9-3Zm4.1-2.2-2.4-1.4-3 3.5 3 3.5 2.4-1.4c.9-.5.9-1.7 0-2.2Z', pad + 15);
    const app = document.createElementNS(NS, 'text');
    app.setAttribute('x', String(pad + 32)); app.setAttribute('y', String(y));
    app.setAttribute('fill', '#ffb000');
    app.setAttribute('style', `${MONO};font-size:12px;font-weight:700;letter-spacing:.04em`);
    app.textContent = 'BULLDOZER STATS';
    clone.appendChild(app);
    const stores = document.createElementNS(NS, 'text');
    stores.setAttribute('x', String(w < 420 ? pad + 32 + 122 : w - pad)); stores.setAttribute('y', String(y));
    stores.setAttribute('text-anchor', w < 420 ? 'start' : 'end'); stores.setAttribute('fill', '#8b8f98');
    stores.setAttribute('style', `${MONO};font-size:${fsS}px`);
    stores.textContent = w < 420 ? STORES : `${STORES} · azenha.ai/bulldozer`;
    clone.appendChild(stores);
    const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clone)], { type: 'image/svg+xml;charset=utf-8' }));
    try {
      const img = new Image();
      await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = url; });
      const S = 2;
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(w * S); canvas.height = Math.round((h + FOOT) * S);
      canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
      canvas.toBlob((b) => {
        if (!b) return;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(b); a.download = `${name}.png`; a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 5000);
      }, 'image/png');
    } finally { URL.revokeObjectURL(url); }
  }

  function flash(btn: HTMLElement, txt: string) {
    const t = btn.textContent; btn.textContent = txt;
    setTimeout(() => { btn.textContent = t; }, 1400);
  }

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const share = t.closest('.ca-share') as HTMLElement | null;
    if (share) {
      const hash = share.dataset.hash ? '#' + share.dataset.hash : location.hash;
      const url = location.origin + location.pathname + location.search + hash;
      try { await navigator.clipboard.writeText(url); flash(share, '✓ Link copied'); }
      catch { prompt('Copy link:', url); }
      return;
    }
    const png = t.closest('.ca-png') as HTMLElement | null;
    if (png) {
      const svg = document.querySelector(png.dataset.svg!) as SVGSVGElement | null;
      if (!svg) return;
      try { await toPng(svg, png.dataset.name!, metaFor(svg, png)); flash(png, '✓ Saved'); }
      catch { flash(png, '✗ Export failed'); }
    }
  });
</script>
