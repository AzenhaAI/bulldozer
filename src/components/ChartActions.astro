---
// Share-link + PNG-export buttons under a chart. `svg` is a CSS selector for
// the chart's <svg> (omit for HTML-only charts — share link only). `hash` pins
// the copied URL to the chart's section anchor. Script is hoisted once per page.
interface Props { name: string; svg?: string; hash?: string }
const { name, svg, hash } = Astro.props;
// The same two glyphs are drawn into exported PNGs (see the script below).
const APPLE = 'M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.7-3.1.7-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4 0 0-2.7-1-2.7-3.4ZM14.3 6.6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2Z';
const PLAY = 'M4.6 2.6a1 1 0 0 0-.5.9v17a1 1 0 0 0 .5.9l9.1-9.4-9.1-9.4Zm10.2 8.3 2.9-3-9.9-5.6 7 8.6Zm0 2.2-7 8.6 9.9-5.6-2.9-3Zm4.1-2.2-2.4-1.4-3 3.5 3 3.5 2.4-1.4c.9-.5.9-1.7 0-2.2Z';
---
<p class="chart-actions" style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-top:12px">
  <button type="button" class="ghost-btn ca-share" data-hash={hash} style="margin:0">🔗 Copy link</button>
  {svg && <button type="button" class="ghost-btn ca-png" data-svg={svg} data-name={name} style="margin:0">↓ PNG</button>}
  <span class="chart-src" style="margin-left:auto; display:inline-flex; flex-direction:column; align-items:center; gap:2px; line-height:1.2; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.04em">
    <span style="display:inline-flex; align-items:center; gap:6px; color:var(--accent,#ffb000); font-size:12px; font-weight:700">
      <a href="https://apps.apple.com/app/id6797664814" aria-label="BullDozer Stats on the App Store" title="App Store" style="color:inherit; display:inline-flex"><svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path fill="currentColor" d={APPLE} /></svg></a>
      <a href="https://play.google.com/store/apps/details?id=ai.azenha.bulldozer" aria-label="BullDozer Stats on Google Play" title="Google Play" style="color:inherit; display:inline-flex"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path fill="currentColor" d={PLAY} /></svg></a>
      <span>BULLDOZER STATS</span>
    </span>
    <span style="font-size:11px; color:var(--muted,#8b8f98)">azenha.ai/bulldozer</span>
  </span>
</p>
<script>
  const BRAND = 'azenha.ai/bulldozer · every number sourced';
  const FOOT = 44; // extra band under the chart: app name over the site address

  // Rasterise a live <svg> to a downloadable PNG: clone it, bake computed CSS
  // into inline styles (stylesheets don't travel into the blob), add an opaque
  // background + brand line, then draw through an <img> onto a 2x canvas.
  async function toPng(svg: SVGSVGElement, name: string) {
    const vb = svg.viewBox && svg.viewBox.baseVal;
    const w = vb && vb.width ? vb.width : svg.clientWidth || 900;
    const h = vb && vb.height ? vb.height : svg.clientHeight || 480;
    const clone = svg.cloneNode(true) as SVGSVGElement;
    const src = [svg, ...svg.querySelectorAll('*')];
    const dst = [clone, ...clone.querySelectorAll('*')];
    const PROPS = ['fill', 'fill-opacity', 'stroke', 'stroke-width', 'stroke-dasharray', 'stroke-linecap',
      'opacity', 'font-family', 'font-size', 'font-weight', 'letter-spacing', 'text-anchor', 'dominant-baseline'];
    src.forEach((s, i) => {
      const cs = getComputedStyle(s);
      (dst[i] as Element).setAttribute('style', PROPS.map((p) => `${p}:${cs.getPropertyValue(p)}`).join(';'));
    });
    const NS = 'http://www.w3.org/2000/svg';
    clone.setAttribute('xmlns', NS);
    clone.setAttribute('width', String(w));
    clone.setAttribute('height', String(h + FOOT));
    clone.setAttribute('viewBox', `0 0 ${w} ${h + FOOT}`);
    const bg = document.createElementNS(NS, 'rect');
    bg.setAttribute('width', String(w)); bg.setAttribute('height', String(h + FOOT));
    bg.setAttribute('fill', getComputedStyle(document.body).backgroundColor || '#0e0f11');
    clone.insertBefore(bg, clone.firstChild);
    // Two centred lines, as in the app: what to type into App Store or
    // Google Play, with both store glyphs, and the site under it.
    const MONO = 'font-family:ui-monospace,SFMono-Regular,Menlo,monospace';
    const NAME_W = 118; // width of "BULLDOZER STATS" at 13px bold monospace
    const left = w / 2 - (34 + NAME_W) / 2;
    const glyph = (d: string, x: number) => {
      const p = document.createElementNS(NS, 'path');
      p.setAttribute('d', d); p.setAttribute('fill', '#ffb000');
      p.setAttribute('transform', `translate(${x} ${h + FOOT - 37}) scale(0.6)`);
      clone.appendChild(p);
    };
    glyph('M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.7-3.1.7-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4 0 0-2.7-1-2.7-3.4ZM14.3 6.6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2Z', left);
    glyph('M4.6 2.6a1 1 0 0 0-.5.9v17a1 1 0 0 0 .5.9l9.1-9.4-9.1-9.4Zm10.2 8.3 2.9-3-9.9-5.6 7 8.6Zm0 2.2-7 8.6 9.9-5.6-2.9-3Zm4.1-2.2-2.4-1.4-3 3.5 3 3.5 2.4-1.4c.9-.5.9-1.7 0-2.2Z', left + 16);
    const app = document.createElementNS(NS, 'text');
    app.setAttribute('x', String(left + 34)); app.setAttribute('y', String(h + FOOT - 25));
    app.setAttribute('fill', '#ffb000');
    app.setAttribute('style', `${MONO};font-size:13px;font-weight:700;letter-spacing:.04em`);
    app.textContent = 'BULLDOZER STATS';
    clone.appendChild(app);
    const brand = document.createElementNS(NS, 'text');
    brand.setAttribute('x', String(w / 2)); brand.setAttribute('y', String(h + FOOT - 9));
    brand.setAttribute('text-anchor', 'middle'); brand.setAttribute('fill', '#8b8f98');
    brand.setAttribute('style', `${MONO};font-size:11px`);
    brand.textContent = w < 420 ? 'azenha.ai/bulldozer' : BRAND;
    clone.appendChild(brand);
    const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clone)], { type: 'image/svg+xml;charset=utf-8' }));
    try {
      const img = new Image();
      await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = url; });
      const S = 2;
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(w * S); canvas.height = Math.round((h + FOOT) * S);
      canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
      canvas.toBlob((b) => {
        if (!b) return;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(b); a.download = `${name}.png`; a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 5000);
      }, 'image/png');
    } finally { URL.revokeObjectURL(url); }
  }

  function flash(btn: HTMLElement, txt: string) {
    const t = btn.textContent; btn.textContent = txt;
    setTimeout(() => { btn.textContent = t; }, 1400);
  }

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const share = t.closest('.ca-share') as HTMLElement | null;
    if (share) {
      const hash = share.dataset.hash ? '#' + share.dataset.hash : location.hash;
      const url = location.origin + location.pathname + location.search + hash;
      try { await navigator.clipboard.writeText(url); flash(share, '✓ Link copied'); }
      catch { prompt('Copy link:', url); }
      return;
    }
    const png = t.closest('.ca-png') as HTMLElement | null;
    if (png) {
      const svg = document.querySelector(png.dataset.svg!) as SVGSVGElement | null;
      if (!svg) return;
      try { await toPng(svg, png.dataset.name!); flash(png, '✓ Saved'); }
      catch { flash(png, '✗ Export failed'); }
    }
  });
</script>
