---
/**
 * The full ranking, rendered on the server.
 *
 * Every other view of this data is drawn by the browser: DataPanel ships an
 * empty <table id="table-target"> and fills it from JS, and the map and bars
 * are SVG. That made the dataset pages invisible to search — 379 KB of markup
 * in which no country was ever named outside a <script>. 186 pages, 42% of the
 * site, with nothing to rank for.
 *
 * So this duplicates the table view in HTML. It is not a fallback: it is the
 * page's text.
 *
 * Built from entityTotals rather than computeChanges, which drops any entity
 * whose previous value is 0 to avoid dividing by it — fine for a top-five
 * movers list, wrong for a ranking that claims to be complete.
 */
import type { Observation, ChangeMode, Better } from '@lib/analytics';
import { periods, entityTotals, changeValue, isSinglePeriod, changeSpec, formatDelta, formatValue, toneOf, sharedRanks, alignDecimals } from '@lib/analytics';
import { flagFor } from '@lib/flags';
import countryNames from '@data/country-names.json';

/*
 * `projectedFrom`: the first projected year (IMF WEO). The ranking is of the
 * last observed year, as the KPIs and the panel are; it used to rank the
 * IMF's 2026 projection under a bare "2026".
 * `categories`: code → name for a category scale (Freedom House status).
 * `noun`: what the entities are, for the column head and the caption.
 * Rows may carry `year` (latestPerCountry data, period "Latest"): each
 * country's own reading year is then shown in its own column.
 */
interface Props {
  data: (Observation & { year?: string })[]; unit?: string; fullUnit?: string; mode?: ChangeMode; valueLabel?: string; better?: Better; bandData?: Observation[];
  projectedFrom?: string; categories?: Record<string, string>; noun?: 'country' | 'company';
  /** Values in a different unit per country (currencies): listed A–Z, unranked. */
  incomparable?: boolean;
}
const { data, unit = '', fullUnit = unit, mode = 'pct', valueLabel = 'Value', better, bandData, projectedFrom, categories, noun, incomparable } = Astro.props;
const spec = changeSpec(bandData ?? data, fullUnit, mode, better);
// At most two decimals in a change ("+0.59 points", not "+0.590 points");
// the stable band still decides the colour.
const fmtSpec = mode === 'pp' ? { ...spec, band: Math.max(spec.band, 0.01) } : spec;

const pfYear = projectedFrom ? Number(String(projectedFrom).slice(0, 4)) : null;
const isProjected = (p: string) => pfYear != null && Number(String(p).slice(0, 4)) >= pfYear;
const allPeriods = periods(data);
const observed = allPeriods.filter((p) => !isProjected(p));
const all = observed.length ? observed : allPeriods;
const currPeriod = all[all.length - 1];
const prevPeriod = all.length > 1 ? all[all.length - 2] : null;
const projYears = allPeriods.filter(isProjected);
const single = isSinglePeriod(data.filter((o) => !isProjected(o.period)));
const latest = currPeriod === 'Latest';
const yearOf = new Map(data.filter((o) => o.period === currPeriod && o.year).map((o) => [o.entity, String(o.year)]));
const years = [...new Set(yearOf.values())].sort();
const cat = (v: number) => categories?.[String(v)];
const nouns = noun === 'company' ? 'companies' : noun === 'country' ? 'countries' : 'entities';

const curr = entityTotals(data, currPeriod);
const prev = prevPeriod ? entityTotals(data, prevPeriod) : new Map<string, number>();
const isoOf = new Map(data.filter((o) => o.iso).map((o) => [o.entity, o.iso!]));
// Everyday names ("Hong Kong", "United Kingdom"), as the country profiles and
// the panel above show them, not the source's ISO-list forms.
const NAMES = countryNames as Record<string, { common: string }>;
const shown = (e: string) => { const iso = isoOf.get(e); return (iso && NAMES[iso]?.common) || e; };

const rows = [...curr.entries()]
  .map(([entity, value]) => {
    const pv = prev.get(entity);
    // A change needs both ends. Missing or zero previous value means no
    // meaningful percent, so the cell stays empty rather than reading 0%.
    const pct = pv === undefined || (mode === 'pct' && pv === 0)
      ? null
      : changeValue(value, pv, mode);
    return { entity, value, pct, pv };
  })
  // A category scale is ordered by category, the better one first (Freedom
  // House: Free, Partly free, Not free), not by the size of its code: "Highest
  // first" put Not free at the top. Within a category, by name.
.sort((a, b) => incomparable ? shown(a.entity).localeCompare(shown(b.entity)) : categories
    ? (better === 'high' ? b.value - a.value : a.value - b.value) || shown(a.entity).localeCompare(shown(b.entity))
    : b.value - a.value);
// One decimal style down the value column ("4.0%", not "4%", beside "41.4%").
const valTexts = alignDecimals(rows.map((r) => formatValue(r.value, fullUnit)));
// Ranks compare what is printed: equal values share a rank ("28=").
const ranks = sharedRanks(rows.map((r, i) => cat(r.value) ?? valTexts[i]));
const orderNote = incomparable ? 'A–Z: each value is in its own currency, so the countries are not ranked.' : categories ? `${cat(rows[0]?.value ?? NaN) ?? 'Best'} first; countries in the same status share a rank.` : 'Highest first; equal values share a rank.';
---
{rows.length > 0 && (
  <table class="data">
    <caption class="sub" style="text-align:left; caption-side:top; padding:0 0 8px">
      {latest
        ? `${rows.length} ${rows.length === 1 ? nouns.replace(/ies$/, 'y') : nouns}, the latest reading of each${years.length > 1 ? ` (${years[0]}–${years.at(-1)})` : years.length ? ` (${years[0]})` : ''}`
        : `${rows.length} ${rows.length === 1 ? nouns.replace(/ies$/, 'y') : nouns}, ${currPeriod}`}
      {!single && prevPeriod && !latest && <span>, change vs {prevPeriod}</span>}.
      {projYears.length > 0 && <span> {currPeriod} is the last observed year; the IMF projection for {projYears.join(', ')} is not ranked here (pick it in the period list above).</span>}
      {' '}{orderNote}
    </caption>
    <thead>
      <tr>
        {!incomparable && <th class="num" style="width:3em">#</th>}
        <th>{noun === 'company' ? 'Company' : noun === 'country' ? 'Country' : 'Entity'}</th>
        <th class="num">{valueLabel}</th>
        {latest && <th class="num">Year</th>}
        {!single && !latest && <th class="num">Change</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((r, i) => (
        <tr>
          {!incomparable && <td class="num">{ranks[i].label}</td>}
          <td>{flagFor(isoOf.get(r.entity)) ? flagFor(isoOf.get(r.entity)) + ' ' : ''}{shown(r.entity)}</td>
          <td class="num">{cat(r.value) ?? `${valTexts[i]}${unit}`}</td>
          {latest && <td class="num">{yearOf.get(r.entity) ?? ''}</td>}
          {!single && !latest && (
            <td class={`num ${r.pct === null || (categories && r.pct === 0) ? '' : toneOf(r.pct, spec)}`}>
              {r.pct === null ? '—' : categories ? (r.pct === 0 ? 'same' : `was ${r.pv !== undefined ? cat(r.pv) ?? '' : ''}`) : formatDelta(r.pct, fmtSpec)}
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
)}
