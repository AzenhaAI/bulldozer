---
import type { Observation, ChangeMode, Better } from '@lib/analytics';
import { computeKpi, changeSpec, formatDelta, formatValue, toneOf, quantile, alignDecimalsTo } from '@lib/analytics';

// `fullUnit` is the dataset's unit ("years", "index 0–1"): it decides the unit
// of change and the decimals. `unit` is the short suffix printed after values.
// `bandData` sizes the stable band (default: `data`); pass the whole series so
// the band matches the panel and the movers.
interface Props { data: (Observation & { year?: string })[]; unit?: string; fullUnit?: string; mode?: ChangeMode; noun?: 'country' | 'company'; better?: Better; bandData?: Observation[]; projectedFrom?: string; floor?: number }
const { data, unit: unitIn = '', fullUnit = unitIn, mode = 'pct', noun = 'country', better, bandData, projectedFrom, floor } = Astro.props;
// "% YoY", "% of GDP": still a percent after the number.
const unit = unitIn || (fullUnit.includes('%') ? '%' : '');
// Companies each count users their own way: an average across them means
// nothing, so the first card counts who reported instead.
const company = noun === 'company';
const spec = changeSpec(bandData ?? data, fullUnit, mode, better);
const k = computeKpi(data, mode, spec.band);
// Every figure on the cards with the decimals of the ranking it summarises:
// a median of "10" over a ranking of "10.4, 5.4" read as a rounder number
// than it is (WHO suicide rate), "3%" beside "2.8%" (IMF inflation).
const refTexts = data.filter((o) => o.period === k.currPeriod && Number.isFinite(o.value)).map((o) => formatValue(o.value, fullUnit, floor));
const fv = (v: number) => `${alignDecimalsTo([formatValue(v, fullUnit, floor)], refTexts)[0]}${unit}`;
// Stable band as the reader sees it: "±0.5%", "±0.02 points", "±0.4pp".
const bandText = mode === 'pct' ? `±${spec.band}%` : `±${formatDelta(spec.band, spec).replace(/^[+−]/, '')}`;
// One reading per country (or one period): nothing to compare, so the three
// change cards become the spread of the values instead.
const single = k.prevPeriod === k.currPeriod;
const rows = single ? data.filter((o) => o.period === k.currPeriod && Number.isFinite(o.value)).sort((a, b) => a.value - b.value) : [];
const sortedVals = rows.map((r) => r.value);
const q1 = quantile(sortedVals, 0.25), q3 = quantile(sortedVals, 0.75);
// Both ends of a range with the same decimals: "18% – 61.5%" read as two
// precisions; now "18.0% – 61.5%".
const pair = alignDecimalsTo([formatValue(q1, fullUnit, floor), formatValue(q3, fullUnit, floor)], refTexts).map((t) => t + unit);
// Improving / declining follow which way is better; with no better direction
// the cards say plainly what happened: rose, fell, flat.
const rose = { n: k.growthCount, cls: toneOf(1e9, spec) };
const fell = { n: k.declineCount, cls: toneOf(-1e9, spec) };
const cards = !better
  ? [{ label: 'Rose', ...rose, note: `of ${k.totalEntities} in both periods` }, { label: 'Fell', ...fell, note: 'period over period' }]
  : better === 'high'
    ? [{ label: 'Improving', ...rose, note: `rose, of ${k.totalEntities} in both periods` }, { label: 'Worsening', ...fell, note: 'fell, period over period' }]
    : [{ label: 'Improving', ...fell, note: `fell, of ${k.totalEntities} in both periods` }, { label: 'Worsening', ...rose, note: 'rose, period over period' }];
const nouns = company ? 'companies' : k.currCount === 1 ? 'country' : 'countries';
// IMF WEO runs into its own projections: say so on the headline period.
const projected = (p: string) => !!projectedFrom && Number(String(p).slice(0, 4)) >= Number(String(projectedFrom).slice(0, 4));
// Each country's latest reading (World Bank most-recent-value series): the
// label names the years, and Highest / Lowest carry their own year when it is
// not the newest one (Algeria's 0.19% market cap is from 2018).
const yrs = rows.map((r) => r.year).filter((y): y is string => !!y).sort();
const headYear = yrs.at(-1);
const yearNote = (r: { year?: string }) => (r.year && r.year !== headYear ? ` · ${r.year}` : '');
const periodLabel = k.currPeriod === 'Latest' ? (yrs.length ? `latest, ${yrs[0] === headYear ? headYear : `${yrs[0]}–${headYear}`}` : 'latest') : projected(k.currPeriod) ? `${k.currPeriod}, projection` : k.currPeriod;
---
<div class="kpi-row">
  {company ? (
  <div class="kpi">
    <div class="label">Companies ({k.currPeriod})</div>
    <div class="value">{k.currCount}</div>
    <div class="delta flat">reporting this quarter</div>
  </div>
  ) : (
  <div class="kpi">
    <div class="label">Median of {k.currCount} {nouns} ({periodLabel})</div>
    <div class="value">{fv(k.medianValue)}</div>
    {single
      ? <div class="delta flat">{k.currPeriod === 'Latest' ? 'latest year per country' : 'single period'}</div>
      : <div class={`delta ${toneOf(k.totalPct, spec)}`} title="Change in the median of the countries measured in both periods">{formatDelta(k.totalPct, spec)} vs {k.prevPeriod}{projected(k.prevPeriod) ? ' (projection)' : ''}</div>}
  </div>
  )}
  {single && rows.length ? <>
  <div class="kpi">
    <div class="label">Middle half</div>
    <div class="value" style="font-size:22px">{pair[0]} – {pair[1]}</div>
    <div class="delta">a quarter of the countries below, a quarter above</div>
  </div>
  <div class="kpi">
    <div class="label">Highest</div>
    <div class="value">{fv(rows[rows.length - 1].value)}</div>
    <div class="delta">{rows[rows.length - 1].entity}{yearNote(rows[rows.length - 1])}</div>
  </div>
  <div class="kpi">
    <div class="label">Lowest</div>
    <div class="value">{fv(rows[0].value)}</div>
    <div class="delta">{rows[0].entity}{yearNote(rows[0])}</div>
  </div>
  </> : <>
  {cards.map((c) => (
  <div class="kpi">
    <div class="label">{c.label}</div>
    <div class={`value ${c.cls}`}>{c.n}</div>
    <div class="delta">{c.note}</div>
  </div>
  ))}
  <div class="kpi">
    <div class="label">{better ? 'Stable' : 'Flat'}</div>
    <div class="value flat">{k.stableCount}</div>
    <div class="delta" title="Changes this small count as no change; the band scales with the spread of the data">within {bandText}</div>
  </div>
  </>}
</div>
