---
import type { Observation, ChangeMode, Better } from '@lib/analytics';
import { topByVolume, computeChanges, changeSpec, formatDelta, formatValue, toneOf } from '@lib/analytics';
import { flagFor } from '@lib/flags';

interface Props { data: Observation[]; n?: number; unit?: string; fullUnit?: string; mode?: ChangeMode; better?: Better }
const { data, n = 10, unit = '', fullUnit = unit, mode = 'pct', better } = Astro.props;
const rows = topByVolume(data, n);
const isoOf = new Map(data.filter((o) => o.iso).map((o) => [o.entity, o.iso!]));
const label = (e: string) => { const f = flagFor(isoOf.get(e)); return f ? f + ' ' + e : e; };
const spec = changeSpec(data, fullUnit, mode, better);

// The bar is the value; the change is only the small label, coloured by
// whether it went the better way (neutral when neither way is better).
const changeByEntity = new Map(computeChanges(data, mode).map((c) => [c.entity, c.pct]));

// A visible zero axis, bars running both ways from it: length = |value|.
const values = rows.map((r) => r.curr);
const lo = Math.min(0, ...values);
const hi = Math.max(0, ...values);
const span = hi - lo || 1;
const pos = (v: number) => ((v - lo) / span) * 100;
const zero = pos(0);
const geom = (v: number) => { const p = pos(v); return `margin-left:${Math.min(p, zero).toFixed(2)}%;width:${Math.abs(p - zero).toFixed(2)}%`; };
---
<div class="bars bl">
  {rows.map((r) => {
    const ch = changeByEntity.get(r.entity);
    const cls = ch === undefined ? 'flat' : toneOf(ch, spec);
    return (
      <div class="bar-row">
        <span>{label(r.entity)}</span>
        <span class="bar-track">{lo < 0 && <span class="bar-zero" style={`left:${zero.toFixed(2)}%`}></span>}<span class={`bar-fill${r.curr < 0 ? ' neg' : ''}`} style={geom(r.curr)}></span></span>
        <span class="bar-val">
          {formatValue(r.curr, fullUnit)}{unit}
          {ch !== undefined && <em class={cls}>{formatDelta(ch, spec)}</em>}
        </span>
      </div>
    );
  })}
</div>

<style>
  /* The value column sizes to its content and stays on one line: on phones
     the shared 84 px column broke "22.6% · cancer 9.6%" over three lines. */
  .bl .bar-row { grid-template-columns: minmax(0, 140px) minmax(40px, 1fr) auto; }
  .bl .bar-row > span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bl .bar-val { white-space: nowrap; }
  .bl .bar-val em { display: inline; margin-left: 6px; }
  @media (max-width: 560px) {
    .bl .bar-row { grid-template-columns: minmax(0, 96px) minmax(32px, 1fr) auto; }
  }
</style>
