---
import type { Observation } from '@lib/analytics';
import { colorFor } from '@lib/palette';

interface Props { data: Observation[]; unit?: string }
const { data, unit = '' } = Astro.props;

const periods = [...new Set(data.map((o) => o.period))].sort();
const groups = [...new Set(data.map((o) => o.group).filter(Boolean) as string[])];

// group → period → mean
const series = groups.map((g) => {
  const pts = periods.map((p) => {
    const vals = data.filter((o) => o.group === g && o.period === p).map((o) => o.value);
    return vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : null;
  });
  return { group: g, pts };
});

const allVals = series.flatMap((s) => s.pts).filter((v): v is number => v != null);
const yMin = Math.min(...allVals), yMax = Math.max(...allVals);
const pad = (yMax - yMin) * 0.08 || 1;
const lo = yMin - pad, hi = yMax + pad;

// Two drawings of the same lines: a wide one, and a narrow one for phones,
// where the wide viewBox shrank the axis text to about 4px.
const geom = (W: number, H: number, maxLabels: number) => {
  const m = { t: 14, r: 14, b: 32, l: 46 };
  const iw = W - m.l - m.r, ih = H - m.t - m.b;
  const X = (i: number) => m.l + (periods.length === 1 ? iw / 2 : (i / (periods.length - 1)) * iw);
  const Y = (v: number) => m.t + ih - ((v - lo) / (hi - lo || 1)) * ih;
  const yTicks = Array.from({ length: 5 }, (_, i) => Math.round((lo + ((hi - lo) * i) / 4) * 10) / 10);
  // Keep the first and last labels, then add evenly spaced ones only where
  // they do not touch a neighbour (11px mono ≈ 6.8px per character).
  const span = (p: string) => p.length * 6.8 + 14;
  const last = periods.length - 1;
  const step = Math.ceil(periods.length / maxLabels);
  const kept = periods.length > 1 ? [0, last] : [0];
  for (let i = step; i < last; i += step) {
    const fits = kept.every((j) => Math.abs(X(i) - X(j)) >= (span(periods[i]) + span(periods[j])) / 2 + (j === 0 || j === last ? span(periods[j]) / 2 : 0));
    if (fits) kept.push(i);
  }
  const xLabels = kept.sort((a, b) => a - b).map((i) => ({ p: periods[i], i }));
  const path = (pts: (number | null)[]) => pts.map((v, i) => v == null ? '' : `${i === 0 || pts[i - 1] == null ? 'M' : 'L'}${X(i).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');
  return { W, H, m, X, Y, yTicks, xLabels, path };
};
const views = [{ cls: 'tc-wide', g: geom(760, 340, 8) }, { cls: 'tc-narrow', g: geom(380, 250, 4) }];
---
<div class="chart-svg">
  {views.map(({ cls, g }) => (
  <svg class={cls} viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-label="Trend by group">
    {g.yTicks.map((v) => (
      <g><line x1={g.m.l} y1={g.Y(v)} x2={g.W - g.m.r} y2={g.Y(v)} stroke="var(--border)" /><text x={g.m.l - 8} y={g.Y(v) + 4} text-anchor="end" class="axis">{v}{unit}</text></g>
    ))}
    {g.xLabels.map(({ p, i }) => (
      <text x={g.X(i)} y={g.H - g.m.b + 20} text-anchor={i === 0 && periods.length > 1 ? 'start' : i === periods.length - 1 && periods.length > 1 ? 'end' : 'middle'} class="axis">{p}</text>
    ))}
    {series.map((s) => (
      <path d={g.path(s.pts)} fill="none" stroke={colorFor(s.group)} stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" />
    ))}
  </svg>
  ))}
  <div class="legend-regions">
    {series.map((s) => (<span class="lr"><span class="lr-dot" style={`background:${colorFor(s.group)}`}></span>{s.group}</span>))}
  </div>
</div>
