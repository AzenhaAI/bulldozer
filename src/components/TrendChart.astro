---
/**
 * Group trend lines on a dataset page, by the chart rules in lib/trend.ts
 * (the app's chart_rules.dart applies the same ones):
 *  - each region's line is the MEDIAN of the same countries in every period
 *    (a mean let Venezuela's 19,906% inflation drag the Americas; a changing
 *    set of countries showed composition, not change). A region with fewer
 *    than 3 such countries is not drawn, and the note says so;
 *  - x by time; the axis zooms to the data; round ticks; a 0 line when
 *    values cross zero;
 *  - long series (≥ 20 periods): a LOWESS curve over a faint raw line;
 *  - a dashed Theil–Sen trend only where the direction is steady (≥ 6
 *    readings, Mann–Kendall p < 0.05, same sign in both halves), its rate in
 *    the legend;
 *  - IMF projections: a shaded "forecast" stretch;
 *  - a category scale (Freedom House status) has no median: each line is the
 *    share of the countries rated that year that are in one category.
 */
import type { Observation } from '@lib/analytics';
import { colorFor, categoryColors } from '@lib/palette';
import { periodYear, yDomain, niceTicks, trendOf, trendAt, trendRate, lowess, isPointUnit, SMOOTH_MIN_POINTS } from '@lib/trend';

interface Props { data: Observation[]; unit?: string; fullUnit?: string; mode?: 'pp' | 'pct'; projectedFrom?: string; categories?: Record<string, string>; better?: 'high' | 'low' }
const { data, categories, better } = Astro.props;
// Shares of countries are percentages, whatever the codes' own unit says.
const unit = categories ? '%' : Astro.props.unit ?? '';
const fullUnit = categories ? '%' : Astro.props.fullUnit ?? unit;
const projectedFrom = Astro.props.projectedFrom;
const changeMode = categories ? 'pp' : Astro.props.mode ?? (isPointUnit(fullUnit) ? 'pp' : 'pct');
const proj = projectedFrom ? Number(projectedFrom) : undefined;
const MIN_PANEL = 3;

const periods = [...new Set(data.map((o) => o.period))].sort((a, b) => periodYear(a) - periodYear(b));
const xs = periods.map(periodYear);
const median = (a: number[]) => { const s = [...a].sort((x, y) => x - y), n = s.length; return n % 2 ? s[(n - 1) / 2] : (s[n / 2 - 1] + s[n / 2]) / 2; };

const byGroup = new Map<string, Map<string, Map<string, number>>>();
for (const o of data) {
  if (!o.group) continue;
  const g = byGroup.get(o.group) ?? byGroup.set(o.group, new Map()).get(o.group)!;
  (g.get(o.entity) ?? g.set(o.entity, new Map()).get(o.entity)!).set(o.period, o.value);
}
const series: { group: string; n: number; pts: number[]; smooth?: number[]; trend: ReturnType<typeof trendOf>; color?: string }[] = [];
const dropped: string[] = [];
// Category scale: one line per category, best first, as a share of the
// countries rated in that year (the count rated is in the note).
const catCodes = categories ? Object.keys(categories).map(Number).sort((a, b) => (better === 'high' ? b - a : a - b)) : [];
const ratedPerPeriod = periods.map((p) => data.filter((o) => o.period === p && Number.isFinite(o.value)).length);
const catColors = categoryColors(catCodes.length);
catCodes.forEach((code, ci) => {
  const pts = periods.map((p, i) => (ratedPerPeriod[i] ? (data.filter((o) => o.period === p && o.value === code).length / ratedPerPeriod[i]) * 100 : NaN));
  const smooth = xs.length >= SMOOTH_MIN_POINTS ? lowess(xs, pts) : undefined;
  series.push({ group: categories![String(code)], n: 0, pts, smooth, trend: trendOf(pts.map((y, i) => ({ x: xs[i], y })), undefined, false), color: catColors[ci] });
});
const lineColor = (s: (typeof series)[number]) => s.color ?? colorFor(s.group);
for (const [group, ents] of (categories ? new Map() : byGroup)) {
  const panel = [...ents.values()].filter((m) => periods.every((p) => m.has(p)));
  if (panel.length < MIN_PANEL) { dropped.push(group); continue; }
  const pts = periods.map((p) => median(panel.map((m) => m.get(p)!)));
  const actual = proj == null ? xs.length : Math.max(1, xs.filter((x) => x < proj).length);
  const smooth = xs.length >= SMOOTH_MIN_POINTS ? lowess(xs, pts) : undefined;
  series.push({ group, n: panel.length, pts, smooth, trend: trendOf(pts.slice(0, actual).map((y, i) => ({ x: xs[i], y })), undefined, changeMode === 'pct') }); // levels: fitted on logs
}
if (!categories) series.sort((a, b) => b.pts[b.pts.length - 1] - a.pts[a.pts.length - 1]);

const trendEnds = series.flatMap((s) => (s.trend?.clear ? [trendAt(s.trend, s.trend.x0), trendAt(s.trend, s.trend.x1)] : []));
const [lo, hi] = series.length ? yDomain([...series.flatMap((s) => s.pts), ...trendEnds]) : [0, 1];
const ticks = niceTicks(lo, hi, 4);
const ppUnit = fullUnit.includes('%') ? 'pp' : fullUnit.replace(/^%\s*/, '').trim();
// As many decimals as the tick step needs: a fixed two places read
// 0.81, 0.81, 0.80, 0.80 on a 0.0025 step (Albania's HDI in the app, 14 Nov).
const step = ticks.length > 1 ? ticks[1] - ticks[0] : 1;
let tickDp = 0;
for (let sc = step; tickDp < 6 && Math.abs(sc - Math.round(sc)) > 1e-6; sc *= 10) tickDp++;
// One style per axis: "5000" next to "10K" read as two scales (QA, 16 Nov 2026),
// and a true minus sign as on the rest of the site.
const compactAxis = Math.max(...[lo, hi].map((v) => Math.abs(v))) >= 1e4;
const fmtTick = (v: number) => `${compactAxis ? new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(v) : v.toFixed(tickDp)}${unit}`.replace(/^-/, '\u2212');

const rate = (s: (typeof series)[number]) => {
  if (!s.trend?.clear) return '';
  const r = trendRate(s.trend), sign = r > 0 ? '+' : '−', a = Math.abs(r);
  if (s.trend.log) return `${sign}${a.toFixed(1)}% per year`;
  return `${sign}${a.toFixed(a >= 10 ? 0 : a >= 1 ? 1 : 2)}${ppUnit ? ' ' + ppUnit : ''} per year`;
};

// Two drawings of the same lines: a wide one, and a narrow one for phones.
const geom = (W: number, H: number) => {
  const m = { t: 18, r: 18, b: 32, l: 52 };
  const iw = W - m.l - m.r, ih = H - m.t - m.b;
  const x0 = xs[0], x1 = xs[xs.length - 1];
  const X = (x: number) => m.l + (x1 === x0 ? iw / 2 : ((x - x0) / (x1 - x0)) * iw);
  const Y = (v: number) => m.t + ih - ((v - lo) / (hi - lo || 1)) * ih;
  // Labels centred on their own year; the first and last are anchored to the
  // edge so they are not cut; others only where they do not touch a neighbour.
  const wd = (p: string) => p.length * 6.8 + 10;
  const last = periods.length - 1;
  const span = (i: number): [number, number] => {
    const c = X(xs[i]), w = wd(periods[i]);
    return i === 0 ? [c, c + w] : i === last ? [c - w, c] : [c - w / 2, c + w / 2];
  };
  const kept: number[] = periods.length > 1 ? [0, last] : [0];
  for (let i = 1; i < last; i++) {
    const [a, b] = span(i);
    if (kept.every((j) => { const [c, d] = span(j); return b + 6 <= c || d + 6 <= a; })) kept.push(i);
  }
  let xLabels = kept.sort((a, b) => a - b).map((i) => ({ p: periods[i], x: X(xs[i]), anchor: i === 0 && last > 0 ? 'start' : i === last && last > 0 ? 'end' : 'middle' }));
  // Plain years: labels on an even step (every 1, 2, 5, 10… years, on
  // multiples of it), the smallest step whose labels do not touch. Greedy
  // packing gave 1990, 1994, 1997 … 2018, 2024 (World Bank life expectancy).
  // The last year is added only where it does not crowd the step before it.
  if (periods.length > 2 && periods.every((p) => /^\d{4}$/.test(p))) {
    const lw = wd('0000');
    const pos = (y: number, anchor: string): [number, number] => {
      const c = X(y);
      return anchor === 'start' ? [c, c + lw] : anchor === 'end' ? [c - lw, c] : [c - lw / 2, c + lw / 2];
    };
    const anchorOf = (y: number) => (y === x0 ? 'start' : y === x1 ? 'end' : 'middle');
    const fits = (ys: number[]) => ys.every((y, i) => !i || pos(ys[i - 1], anchorOf(ys[i - 1]))[1] + 6 <= pos(y, anchorOf(y))[0]);
    for (const stepY of [1, 2, 5, 10, 20, 25, 50, 100]) {
      const ys: number[] = [];
      for (let y = Math.ceil(x0 / stepY) * stepY; y <= x1; y += stepY) ys.push(y);
      if (ys.length < 2 && stepY > 1) break;
      if (!fits(ys)) continue;
      if (ys.at(-1) !== x1 && fits([...ys, x1])) ys.push(x1);
      xLabels = ys.map((y) => ({ p: String(y), x: X(y), anchor: anchorOf(y) }));
      break;
    }
  }
  const line = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${X(xs[i]).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');
  // A log fit is a curve on this axis: drawn through 24 steps.
  const trendPath = (t: NonNullable<(typeof series)[number]['trend']>) =>
    Array.from({ length: t.log ? 25 : 2 }, (_, i) => t.x0 + ((t.x1 - t.x0) * i) / (t.log ? 24 : 1))
      .map((x, i) => `${i ? 'L' : 'M'}${X(x).toFixed(1)},${Y(trendAt(t, x)).toFixed(1)}`).join(' ');
  const projX = proj != null && xs.some((x) => x >= proj) ? X(Math.max(x0, xs[xs.findIndex((x) => x >= proj) - 1] ?? x0)) : null;
  return { W, H, m, Y, line, trendPath, xLabels, projX };
};
const views = [{ cls: 'tc-wide', g: geom(760, 340) }, { cls: 'tc-narrow', g: geom(380, 260) }];
// A zoomed axis exaggerates change: say so when 0 is off the chart.
const noZero = series.length > 0 && (lo > 0 || hi < 0);
const topTick = ticks.length ? Math.max(...ticks) : null;
// The unit rides on the top tick ("80 years", "0.9 index 0–1"); a bare "%"
// is already on every tick.
const unitLabel = fullUnit && fullUnit !== '%' ? fullUnit : '';
const anySmooth = series.some((s) => s.smooth), anyTrend = series.some((s) => s.trend?.clear);
---
{series.length > 0 ? (
<div class="chart-svg">
  {views.map(({ cls, g }) => (
  <svg class={cls} viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-label="Trend by group">
    {g.projX != null && (
      <g><rect x={g.projX} y={g.m.t} width={g.W - g.m.r - g.projX} height={g.H - g.m.t - g.m.b} class="tc-proj" />
      <text x={g.W - g.m.r - 4} y={g.m.t + 12} text-anchor="end" class="axis">IMF forecast</text></g>
    )}
    {ticks.map((v) => (
      <g><line x1={g.m.l} y1={g.Y(v)} x2={g.W - g.m.r} y2={g.Y(v)} stroke="var(--border)" stroke-width={v === 0 ? 1.6 : 1} /><text x={g.m.l - 8} y={g.Y(v) + 4} text-anchor="end" class="axis">{fmtTick(v)}</text>
      {v === topTick && unitLabel && <text x={g.m.l + 4} y={g.Y(v) - 4} text-anchor="start" class="axis tc-unit">{unitLabel}</text>}</g>
    ))}
    {noZero && (
      <g class="tc-nozero"><path d={`M${g.m.l - 5},${g.H - g.m.b - 2} l5,-4 l5,4`} fill="none" stroke="var(--text-dim)" stroke-width="1" /><text x={g.m.l + 8} y={g.H - g.m.b - 4} text-anchor="start" class="axis">axis does not start at 0</text></g>
    )}
    {g.xLabels.map(({ p, x, anchor }) => (
      <text x={x} y={g.H - g.m.b + 20} text-anchor={anchor} class="axis">{p}</text>
    ))}
    {series.map((s) => s.trend?.clear && (
      <path d={g.trendPath(s.trend)} fill="none" stroke={lineColor(s)} stroke-width="1.3" stroke-dasharray="6 4" opacity="0.75" />
    ))}
    {series.map((s) => (
      <path d={g.line(s.pts)} fill="none" stroke={lineColor(s)} stroke-width={s.smooth ? 1 : 2.2} opacity={s.smooth ? 0.45 : 1} stroke-linejoin="round" stroke-linecap="round" />
    ))}
    {series.map((s) => s.smooth && (
      <path d={g.line(s.smooth)} fill="none" stroke={lineColor(s)} stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" />
    ))}
  </svg>
  ))}
  <div class="legend-regions">
    {series.map((s) => (<span class="lr"><span class="lr-dot" style={`background:${lineColor(s)}`}></span>{s.group} {!categories && <span class="lr-n">({s.n})</span>}{rate(s) && <em class="lr-rate">{rate(s)}</em>}</span>))}
  </div>
  <p class="tc-note">
    {categories
      ? `Each line is the share of the countries rated that year (${Math.min(...ratedPerPeriod) === Math.max(...ratedPerPeriod) ? Math.max(...ratedPerPeriod) : `${Math.min(...ratedPerPeriod)}–${Math.max(...ratedPerPeriod)}`} countries) that are in that status.`
      : 'Each line is the median of the same countries in every period (number in brackets).'}
    {dropped.length > 0 && ` Not drawn — fewer than ${MIN_PANEL} countries measured every time: ${dropped.join(', ')}.`}
    {anySmooth && ' Thick curve: smoothed (LOWESS) over the yearly line.'}
    {anyTrend && ' Dashed: trend, shown only where the direction is steady.'}
  </p>
</div>
) : (
<p class="tc-note">Too few countries were measured in every period to draw regional trends.</p>
)}
