---
import WorldMap from '@components/WorldMap.astro';
import isoNumeric from '@data/iso-numeric.json';
import isoAlpha2 from '@data/iso-alpha2.json';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { feature } from 'topojson-client';
import { geoNaturalEarth1, geoCentroid, geoPath } from 'd3-geo';
import { betterFor } from '@lib/polarity';
import { changeUnit } from '@lib/analytics';
import { getDataset } from '@data/datasets';
import countryNames from '@data/country-names.json';

// Projected country centroids for the Bubbles view — same projection and
// frame as WorldMap, so bubbles start from each country's map position.
const requireHere = createRequire(import.meta.url);
const worldTopo = JSON.parse(readFileSync(requireHere.resolve('world-atlas/countries-110m.json'), 'utf8'));
const worldFc: any = feature(worldTopo, (worldTopo as any).objects.countries);
const bubbleProj = geoNaturalEarth1().fitSize([960, 480], worldFc);
// Faint world silhouette drawn behind the bubbles so it reads as a map.
// Per-country silhouettes (one <path> each, tagged with ISO3) so a country
// can be highlighted when its bubble is hovered.
const _bubblePath = geoPath(bubbleProj);
const bubbleCountries = worldFc.features
  .map((f: any) => ({ iso: (isoNumeric as any)[String(Number(f.id))], d: _bubblePath(f) }))
  .filter((c: any) => c.iso && c.d);
const centroids: Record<string, [number, number]> = {};
for (const f of worldFc.features) {
  const a3 = (isoNumeric as any)[String(Number(f.id))];
  if (!a3) continue;
  const c = bubbleProj(geoCentroid(f) as [number, number]);
  if (c) centroids[a3] = [Math.round(c[0]), Math.round(c[1])];
}
// Micro-states missing from the 110m geometry (Hong Kong tops several market
// indicators) — pin them by hand so they don't vanish from the bubble view.
const MICRO: Record<string, [number, number]> = {
  HKG: [114.17, 22.3], SGP: [103.85, 1.29], BHR: [50.55, 26.05], MLT: [14.4, 35.9],
  MUS: [57.55, -20.3], BRB: [-59.55, 13.1], MCO: [7.42, 43.73], LIE: [9.52, 47.14],
  AND: [1.52, 42.5], SMR: [12.45, 43.94], SYC: [55.45, -4.6], MDV: [73.5, 4.2], CPV: [-23.6, 15.1],
};
for (const [a3, ll] of Object.entries(MICRO)) {
  if (centroids[a3]) continue;
  const c = bubbleProj(ll as [number, number]);
  if (c) centroids[a3] = [Math.round(c[0]), Math.round(c[1])];
}

// Reusable interactive panel: indicator (optional) + period + country search +
// Bars/Table/Map views. Used by /explore (all indicators) and each dataset
// dashboard (pinned to one indicator).
export interface IndexItem {
  slug: string; title: string; kind: string; unit: string; valueLabel: string;
  changeMode: 'pct' | 'pp'; periods: string[]; projectedFrom?: string | null;
  latestPerCountry?: boolean;
}
// `noun` names the entities: 'company' for the company-metrics datasets, which
// have no map position, so their panel drops the map views and the
// country-spread summary and keeps its own pinned set.
interface Props { indicators: IndexItem[]; pinnedSlug?: string; defaultView?: 'bar' | 'table' | 'map' | 'bubbles'; noun?: 'country' | 'company' }
const { indicators, pinnedSlug, defaultView = 'bar', noun = 'country' } = Astro.props;
const geo = noun === 'country';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const showIndicator = !pinnedSlug && indicators.length > 1;
// Default to a flagship indicator, not "datasets[0] after alphabetical sort" —
// that shifts to whatever obscure dataset title happens to sort first
// whenever a new one is added (e.g. "Acceptance of ..."), which reads as random.
const defaultSlug = indicators.some((d) => d.slug === 'whr-happiness') ? 'whr-happiness' : indicators[0]?.slug;
// Which way is better (colours the change labels) and the unit a change is
// stated in ("pp" only for % shares, "years", "points"…), per indicator.
// The registry is the one place that knows whether a series is one reading
// per country spread over several years (latestPerCountry, oneEach) or a
// category scale (categories): pages that build their own indicator lists
// (/explore, /markets) do not pass those, and without them a one-year-each
// World Bank series was shown as a time series ("0.00% vs 2023", a 2017
// period with two countries in it).
const enriched = indicators.map((d) => {
  const full = getDataset(d.slug);
  const latestPerCountry = !!(d.latestPerCountry ?? full?.latestPerCountry);
  const oneEach = latestPerCountry && !!full && new Set(full.data.map((o) => o.iso ?? o.entity)).size === full.data.length;
  return { ...d, better: betterFor(d.slug) ?? null, chgSuffix: changeUnit(d.unit, d.changeMode), latestPerCountry, oneEach, categories: full?.categories ?? null, incomparable: full?.incomparable ?? null, source: full?.source ?? '' };
});
// A pinned series in a different currency per country has no bubble view:
// circle sizes would compare yen with euros (datasets.ts INCOMPARABLE).
const noBubbles = !!(pinnedSlug && getDataset(pinnedSlug)?.incomparable);
const config = { base, pinnedSlug: pinnedSlug ?? null, defaultSlug, defaultView: geo ? defaultView : 'bar', datasets: enriched, noun };
// Everyday country names ("United Kingdom", not the ISO list's "United Kingdom
// of Great Britain and Northern Ireland (the)"), the same ones the country
// profiles use; the long forms made the "add country" select 424 px wide.
const commonNames = Object.fromEntries(Object.entries(countryNames as Record<string, { common: string }>).map(([iso, n]) => [iso, n.common]));
---
<div class="datapanel">
  <div class="controls">
    {showIndicator && (
      <label>Indicator<select id="sel-indicator"></select></label>
    )}
    <label>Period<select id="sel-period"></select></label>
    <label>Search {noun}<input id="sel-query" type="search" placeholder="filter…" autocomplete="off" /></label>
    <div class="view-toggle" id="view-toggle" role="tablist">
      <button data-view="bar" class="active">Bars</button>
      <button data-view="table">Table</button>
      {geo && <button data-view="map">Map</button>}
      {geo && !noBubbles && <button data-view="bubbles">Bubbles</button>}
    </div>
  </div>

  <p class="sub" id="ex-summary"></p>

  <div id="view-bar" class="view">
    <div class="bar-controls" id="bar-controls">
      <label class="inline-add">Add {noun}
        <select id="add-country"><option value="">＋ add…</option></select>
      </label>
      <span id="pinned-chips" class="chips"></span>
      <button type="button" id="sort-dir" class="ghost-btn" style="margin-left:auto">Highest first</button>
      <button type="button" id="show-all" class="ghost-btn" style="margin-left:0">Show all</button>
    </div>
    <div class="dp-dist" id="dp-dist" hidden></div>
    <div class="bars" id="bar-target"></div>
  </div>
  <div id="view-table" class="view" hidden><table class="data" id="table-target"></table></div>
  <div id="view-map" class="view" hidden><WorldMap /></div>
  <div id="view-bubbles" class="view" hidden>
    <svg id="bubble-target" viewBox="0 0 960 520" role="img" aria-label="Bubble map: circle area = indicator value" preserveAspectRatio="xMidYMid meet">
      <g transform="translate(0,20)">{bubbleCountries.map((c) => (<path class="bubble-basemap" data-iso={c.iso} d={c.d} />))}</g>
      <g id="bubble-nodes"></g>
    </svg>
    <div id="bubble-tip" hidden></div>
    <div class="map-legend" id="bubble-legend"></div>
  </div>
</div>

<script type="application/json" id="bd-config" set:html={JSON.stringify(config)}></script>
<script type="application/json" id="bd-centroids" set:html={JSON.stringify(centroids)}></script>
<script type="application/json" id="bd-iso" set:html={JSON.stringify(isoNumeric)}></script>
<script type="application/json" id="bd-a2" set:html={JSON.stringify(isoAlpha2)}></script>
<script type="application/json" id="bd-names" set:html={JSON.stringify(commonNames)}></script>

<script>
  import { stableBand, quantile, formatValue, formatDelta, toneOf, sharedRanks, alignDecimals } from '@lib/analytics';
  import { normaliseGroups } from '@lib/regions';
  import { categoryColors } from '@lib/palette';
  const cfg = JSON.parse(document.getElementById('bd-config').textContent);
  const isoNumeric = JSON.parse(document.getElementById('bd-iso').textContent); // numeric -> alpha3
  const isoAlpha2 = JSON.parse(document.getElementById('bd-a2').textContent);   // alpha3 -> alpha2
  const NAMES = JSON.parse(document.getElementById('bd-names').textContent);   // alpha3 -> everyday name
  const CENT = JSON.parse(document.getElementById('bd-centroids').textContent); // alpha3 -> [x,y]
  // Flag emoji from alpha-3; '' for aggregates/unknowns (decorative only).
  const flag = (iso) => { const a2 = iso && isoAlpha2[iso.toUpperCase()]; return a2 ? String.fromCodePoint(...[...a2].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65)) + ' ' : ''; };
  const BASE = cfg.base;
  const el = (id) => document.getElementById(id);
  const esc = (t) => String(t).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  const selI = el('sel-indicator'), selP = el('sel-period'), selQ = el('sel-query');
  const TOP_N = 7;
  // "My countries" — a saved set that persists across datasets and sessions,
  // so the same countries stay pinned everywhere the panel is used.
  const NOUN = cfg.noun || 'country';
  const NOUNS = NOUN === 'company' ? 'companies' : 'countries';
  const GEO = NOUN === 'country';
  const MYKEY = GEO ? 'bd-my-countries' : 'bd-my-companies';
  const loadMy = () => { try { return new Set(JSON.parse(localStorage.getItem(MYKEY) || '[]')); } catch (e) { return new Set(); } };
  const saveMy = () => { try { localStorage.setItem(MYKEY, JSON.stringify([...state.pinned])); } catch (e) { /* private mode */ } };
  const state = { slug: cfg.pinnedSlug || cfg.defaultSlug || cfg.datasets[0]?.slug, period: null, view: cfg.defaultView || 'bar', query: '', pinned: loadMy(), showAll: false, sortDir: 'desc' };
  const cache = new Map();
  const meta = () => cfg.datasets.find((d) => d.slug === state.slug);

  // ---- deep-link state from the URL ----
  const params = new URLSearchParams(location.search);
  if (!cfg.pinnedSlug && params.get('i') && cfg.datasets.some((d) => d.slug === params.get('i'))) state.slug = params.get('i');
  if ((GEO ? ['bar', 'table', 'map', 'bubbles'] : ['bar', 'table']).includes(params.get('v'))) state.view = params.get('v');
  // A view the page does not offer (bubbles of an incomparable series) falls back to bars.
  if (!document.querySelector(`#view-toggle [data-view="${state.view}"]`)) state.view = 'bar';
  function syncUrl() {
    const p = new URLSearchParams(location.search);
    if (!cfg.pinnedSlug) p.set('i', state.slug);
    if (state.period) p.set('p', state.period);
    p.set('v', state.view);
    history.replaceState(null, '', location.pathname + '?' + p.toString() + location.hash);
  }

  if (selI) {
    for (const kind of ['macro', 'survey']) {
      const items = cfg.datasets.filter((x) => x.kind === kind);
      if (!items.length) continue;
      const g = document.createElement('optgroup');
      g.label = kind === 'macro' ? 'Macro' : 'Polls';
      for (const d of items) { const o = document.createElement('option'); o.value = d.slug; o.textContent = d.title; g.appendChild(o); }
      selI.appendChild(g);
    }
    selI.value = state.slug;
    selI.addEventListener('change', () => { state.slug = selI.value; state.showAll = false; fillPeriods(); render(); });
  }

  let initialPeriod = params.get('p');
  function fillPeriods() {
    const m = meta(); selP.innerHTML = '';
    // Countries measured in different years: open on each one's latest reading.
    // One reading per country in all (World Bank most-recent-value series):
    // a single year would hold a handful of countries and say nothing, so
    // "latest" is the only choice.
    const opts = m.oneEach ? ['latest'] : m.latestPerCountry ? ['latest', ...m.periods] : m.periods;
    // Projections are marked in the list and never the default: IMF series end in
    // the IMF's own forecast for the current year (statistical review, 15 Nov 2026).
    const pf = m.projectedFrom ? Number(String(m.projectedFrom).slice(0, 4)) : null;
    const isProj = (p) => pf != null && Number(String(p).slice(0, 4)) >= pf;
    for (const p of opts) { const o = document.createElement('option'); o.value = p; o.textContent = p === 'latest' ? `Latest reading of each ${NOUN}` : (isProj(p) ? `${p} (IMF projection)` : p); selP.appendChild(o); }
    const observed = m.periods.filter((p) => !isProj(p));
    const lastObserved = observed.length ? observed[observed.length - 1] : m.periods[m.periods.length - 1];
    state.period = (initialPeriod && opts.includes(initialPeriod)) ? initialPeriod : (m.latestPerCountry ? 'latest' : lastObserved);
    initialPeriod = null; // only honour the URL period on first load
    selP.value = state.period;
  }

  // Stable band per dataset, sized on the whole series (lib/analytics
  // stableBand) — the same band the dataset page's cards and tables use.
  const bands = new Map();
  async function load(slug) {
    if (cache.has(slug)) return cache.get(slug);
    const ds = await (await fetch(`${BASE}/data/${slug}.json`)).json();
    const m = cfg.datasets.find((d) => d.slug === slug);
    // Everyday names for countries (see bd-names): rows, search, pins and
    // the "add country" list all use them.
    if (GEO) for (const o of ds.data) if (o.iso && NAMES[o.iso]) o.entity = NAMES[o.iso];
    // One region scheme, as on the rest of the page (lib/regions).
    if (GEO) ds.data = normaliseGroups(ds.data);
    bands.set(slug, stableBand(ds.data.map((o) => o.value), m ? m.changeMode : 'pct'));
    cache.set(slug, ds); return ds;
  }

  const changeVal = (cv, pv, mode) => mode === 'pp' ? cv - pv : (pv ? (cv - pv) / pv * 100 : 0);
  const specOf = (m) => ({ mode: m.changeMode, suffix: m.chgSuffix || (m.changeMode === 'pp' ? 'pp' : '%'), band: bands.get(m.slug) ?? 0.5, better: m.better || undefined });
  // At most two decimals in a change: the band rule gave "+0.590 points" on a
  // 1–5 mean shown as 3.46. The band itself still decides the colour.
  const fmtChange = (v, m) => { const sp = specOf(m); return formatDelta(v, sp.mode === 'pp' ? { ...sp, band: Math.max(sp.band, 0.01) } : sp); };
  const toneClass = (v, m) => toneOf(v, specOf(m));
  // Precision per scale (0–1 indices two places, huge numbers "3.19T").
  const fmtNum = (n) => formatValue(n, (meta() || {}).unit || '');
  // Category scales (Freedom House status): a value is a name, and a change
  // is a move to another category, not "0.00 points".
  const catName = (m, v) => (m.categories ? m.categories[String(v)] : null);
  const unitOf = (m) => (m.unit.includes('%') ? '%' : '');
  const valText = (m, v) => catName(m, v) || (fmtNum(v) + unitOf(m));
  // Values of one list with one decimal style ("4.0%" beside "41.4%"), over
  // every row of the period so it does not change with "Show all".
  const listTexts = (m, rows) => {
    if (m.categories) return new Map(rows.map((r) => [r.entity, valText(m, r.value)]));
    const t = alignDecimals(rows.map((r) => fmtNum(r.value)));
    return new Map(rows.map((r, i) => [r.entity, t[i] + unitOf(m)]));
  };
  const chgText = (m, r) => {
    if (r.change == null) return '';
    if (m.categories) return r.prev !== r.value && catName(m, r.prev) ? `was ${catName(m, r.prev)}` : '';
    return fmtChange(r.change, m);
  };
  const periodLabel = () => {
    const m = meta();
    if (state.period === 'latest') return `latest reading of each ${NOUN}`;
    const pf = m.projectedFrom ? Number(String(m.projectedFrom).slice(0, 4)) : null;
    return pf != null && Number(String(state.period).slice(0, 4)) >= pf ? `${state.period} (IMF projection)` : String(state.period);
  };

  function rowsFor(ds) {
    const m = meta();
    const latest = state.period === 'latest';
    const idx = m.periods.indexOf(state.period);
    const prevP = !latest && idx > 0 ? m.periods[idx - 1] : null;
    // "Latest" = each country's newest observed reading from the last ten
    // years, the window the country profiles use (lib/countryIndex), so a
    // 1998 survey is not ranked against 2024 ones. Projections never count.
    const pf = m.projectedFrom ? Number(String(m.projectedFrom).slice(0, 4)) : null;
    const yearOf = (p) => Number(String(p).slice(0, 4));
    const observed = m.periods.filter((p) => pf == null || yearOf(p) < pf);
    const lastObsYear = observed.length ? yearOf(observed[observed.length - 1]) : NaN;
    const byEnt = new Map();
    for (const o of ds.data) {
      if (latest && (pf != null && yearOf(o.period) >= pf || yearOf(o.period) < lastObsYear - 10)) continue;
      let r = byEnt.get(o.entity);
      if (!r) byEnt.set(o.entity, r = { entity: o.entity, group: o.group, iso: o.iso });
      if (latest) { if (r.year == null || String(o.period) > String(r.year)) { r.value = o.value; r.year = o.period; } continue; }
      if (o.period === state.period) r.value = o.value;
      if (o.period === prevP) r.prev = o.value;
    }
    let rows = [...byEnt.values()].filter((r) => r.value != null);
    rows.forEach((r) => { r.change = r.prev != null ? changeVal(r.value, r.prev, m.changeMode) : null; });
    if (state.query) { const q = state.query.toLowerCase(); rows = rows.filter((r) => r.entity.toLowerCase().includes(q) || (r.group || '').toLowerCase().includes(q)); }
    return rows.sort(rankCmp(m));
  }

  // Rank order. A category scale is ordered by category, the better one first,
  // then by name: by code size, "Highest first" opened on Not free. Numbers:
  // highest first.
  const rankCmp = (m) => m.categories
    ? (a, b) => (m.better === 'high' ? b.value - a.value : a.value - b.value) || a.entity.localeCompare(b.entity)
    : (a, b) => b.value - a.value;
  // Shared ranks on the printed value ("28=" for both of two 2.50s).
  const ranksOf = (m, rows) => { const rk = sharedRanks(rows.map((r) => valText(m, r.value))); return new Map(rows.map((r, i) => [r.entity, rk[i].label])); };

  function visibleRows(rows) {
    // A–Z is for finding a country, so it lists every one (a top-7 cut by
    // alphabet would mean nothing); the rank by value stays on each row.
    if (state.sortDir === 'name') return [...rows].sort((a, b) => a.entity.localeCompare(b.entity));
    const ordered = state.sortDir === 'asc' ? [...rows].reverse() : rows; // rows is desc by value
    if (state.query) return ordered;            // search overrides the limit
    if (state.showAll) return ordered;
    const top = ordered.slice(0, TOP_N);
    const names = new Set(top.map((r) => r.entity));
    const extra = ordered.filter((r) => state.pinned.has(r.entity) && !names.has(r.entity));
    // Pinned extras slot in where they rank (category order included).
    const at = new Map(ordered.map((r, i) => [r.entity, i]));
    return [...top, ...extra].sort((a, b) => at.get(a.entity) - at.get(b.entity));
  }

  function renderBarControls(rows) {
    const sel = el('add-country');
    const ordered = state.sortDir === 'asc' ? [...rows].reverse() : rows;
    const shown = new Set(ordered.slice(0, TOP_N).map((r) => r.entity));
    sel.innerHTML = `<option value="">＋ add ${NOUN}…</option>` +
      [...rows].sort((a, b) => a.entity.localeCompare(b.entity))
        .filter((r) => !shown.has(r.entity) && !state.pinned.has(r.entity))
        .map((r) => `<option value="${esc(r.entity)}">${esc(r.entity)}</option>`).join('');
    el('pinned-chips').innerHTML = (state.pinned.size ? `<span class="chips-lbl">★ My ${NOUNS}:</span>` : '') +
      [...state.pinned].map((n) =>
        `<span class="chip">${esc(n)}<button type="button" data-rm="${esc(n)}" aria-label="Remove ${esc(n)}">×</button></span>`).join('');
    // Categories are not high or low: best first / worst first.
    const cat = !!meta().categories;
    el('sort-dir').textContent = { desc: cat ? '↓ Best first' : '↓ Highest first', asc: cat ? '↑ Worst first' : '↑ Lowest first', name: 'A–Z' }[state.sortDir];
    el('sort-dir').setAttribute('aria-label', `Sort: ${{ desc: cat ? 'best first' : 'highest first', asc: cat ? 'worst first' : 'lowest first', name: `by ${NOUN} name` }[state.sortDir]} — tap to change`);
    el('show-all').textContent = state.showAll ? 'Show top 7' : `Show all ${rows.length}`;
    // Nothing more to show (a company dataset with two companies): no button.
    el('show-all').hidden = state.sortDir === 'name' || rows.length <= TOP_N;
    el('bar-controls').style.display = state.query ? 'none' : 'flex';
  }

  // Median and the middle half of countries, from every country in the period
  // (not just the rows on screen). Median and quartiles rather than mean and SD:
  // survey shares are often split into two camps, where a mean describes no one.
  function distStats(rows) {
    const v = rows.map((r) => r.value).sort((a, b) => a - b), n = v.length;
    if (n < 5) return null;
    const q = (p) => quantile(v, p);
    const mean = v.reduce((a, b) => a + b, 0) / n;
    const sd = Math.sqrt(v.reduce((a, b) => a + (b - mean) ** 2, 0) / (n - 1));
    return { n, min: v[0], max: v[n - 1], q1: q(0.25), med: q(0.5), q3: q(0.75), mean, sd, v };
  }

  function renderDist(st, unit, label) {
    const box = el('dp-dist');
    if (!st || state.query) { box.hidden = true; return; }
    const lo = Math.min(0, st.min), hi = st.max > 0 ? st.max : 1, span = (hi - lo) || 1;
    const X = (v) => (8 + (v - lo) / span * 284).toFixed(1);
    // Many countries would melt into one blob: smaller, fainter dots on more rows.
    const lanes = st.n > 60 ? 5 : 3, r = st.n > 60 ? 2.1 : 3.4, op = st.n > 60 ? 0.55 : 0.85;
    const dots = st.v.map((v, i) => `<circle cx="${X(v)}" cy="${(18 + ((i % lanes) - (lanes - 1) / 2) * (st.n > 60 ? 4 : 5)).toFixed(1)}" r="${r}" fill-opacity="${op}" />`).join('');
    const f = (v) => fmtNum(v) + unit;
    box.innerHTML =
      `<p><b>Median ${f(st.med)}</b> · middle half of countries ${f(st.q1)}–${f(st.q3)} · ${st.n} countries</p>` +
      `<svg viewBox="0 0 300 44" role="img" aria-label="Each country as a dot from ${f(st.min)} to ${f(st.max)}; median ${f(st.med)}">` +
      `<rect class="dd-band" x="${X(st.q1)}" y="6" width="${(X(st.q3) - X(st.q1)).toFixed(1)}" height="24" rx="4"/>` +
      `<line class="dd-med" x1="${X(st.med)}" x2="${X(st.med)}" y1="4" y2="32"/><g class="dd-dots">${dots}</g>` +
      `<text x="8" y="42">${f(lo)}</text><text x="292" y="42" text-anchor="end">${f(hi)}</text></svg>` +
      `<p class="dd-legend">Each dot is a country · dashed line: median · shaded: middle half</p>` +
      `<details><summary>Details</summary><p>Average of the ${st.n} countries ${f(st.mean)} — each country counts once, whatever its population, so it is not an average of ${label}. Spread (standard deviation) ${fmtNum(st.sd)}${unit ? ' pp' : ''} · range ${f(st.min)}–${f(st.max)}.</p></details>`;
    box.hidden = false;
  }

  function renderBars(rows) {
    const m = meta(); const unit = m.unit.includes('%') ? '%' : '';
    renderBarControls(rows);
    // A spread across a handful of companies that each count differently says
    // nothing, and a median of category codes means nothing either.
    // Nor does a spread of values each in its own currency (exchange rates).
    const st = GEO && !m.categories && !m.incomparable ? distStats(rows) : null;
    renderDist(st, unit, m.kind === 'survey' ? 'all the people asked' : 'everyone in those countries');
    const top = visibleRows(rows); const vals = top.map((r) => r.value);
    // A visible zero axis with bars running both ways: length = |value|. The
    // old scale started at the minimum, so with Kuwait at −16.7% Austria's
    // 0.6% drew almost as long as Armenia's 5.5%.
    const lo = Math.min(0, ...vals), hi = Math.max(0, ...vals), span = (hi - lo) || 1;
    const pos = (v) => Math.max(0, Math.min(100, (v - lo) / span * 100));
    const zero = pos(0);
    const zeroLine = lo < 0 ? `<span class="bar-zero" style="left:${zero.toFixed(2)}%"></span>` : '';
    const guides = st && !state.query
      ? `<span class="bar-band" style="left:${pos(st.q1)}%;width:${Math.max(0, pos(st.q3) - pos(st.q1))}%"></span><span class="bar-med" style="left:${pos(st.med)}%"></span>`
      : '';
    const rankOf = ranksOf(m, rows);
    const vt = listTexts(m, rows);
    // Category scale: a coloured chip with the category's name, not a bar
    // whose length is a code (Not free drawn three times as long as Free).
    const cc = m.categories ? categoryClasses(m) : null;
    el('bar-target').innerHTML = top.map((r) => {
      const p = pos(r.value), left = Math.min(p, zero), w = Math.abs(p - zero);
      if (cc) {
        const col = cc.colors[cc.classOf(r.value)] || '#9aa1a9';
        const ct = chgText(m, r);
        const rkc = state.sortDir === 'name' ? `<i class="bar-rank">#${rankOf.get(r.entity)}</i>` : '';
        return `<div class="bar-row bar-row-cat"><span class="bar-name" title="${esc(r.entity)}">${rkc}${flag(r.iso)}${esc(r.entity)}</span><span class="bar-track bar-track-cat"><span class="bar-cat" style="background:${col};color:${lum(col) > 0.5 ? '#1a1300' : '#fff'}">${esc(valText(m, r.value))}</span></span><span class="bar-val">${ct ? `<em class="${r.change == null ? 'flat' : toneClass(r.change, m)}">${ct}</em>` : ''}</span></div>`;
      }
      // One fill for every bar: the bar is the value. The change is the small
      // label, coloured by whether it went the better way.
      const cls = r.change == null ? 'flat' : toneClass(r.change, m);
      const ct = chgText(m, r);
      const chg = ct ? `<em class="${cls}">${ct}</em>` : '';
      const rk = state.sortDir === 'name' ? `<i class="bar-rank">#${rankOf.get(r.entity)}</i>` : '';
      const yr = r.year != null ? `<em class="flat">${r.year}</em>` : '';
      // Values in different currencies: listed, not drawn as lengths.
      const fill = m.incomparable ? '' : `${guides}${zeroLine}<span class="bar-fill${r.value < 0 ? ' neg' : ''}" style="margin-left:${left.toFixed(2)}%;width:${w.toFixed(2)}%"></span>`;
      return `<div class="bar-row"><span class="bar-name" title="${esc(r.entity)}">${rk}${flag(r.iso)}${esc(r.entity)}</span><span class="bar-track${m.incomparable ? ' bar-track-none' : ''}">${fill}</span><span class="bar-val">${vt.get(r.entity)}${chg}${yr}</span></div>`;
    }).join('');
  }

  function renderTable(rows) {
    const m = meta(); const unit = m.unit.includes('%') ? '%' : '';
    // Each country's latest reading has nothing to compare with: no change column.
    const showChg = state.period !== 'latest';
    // Each reading's own year in a column of its own, not squeezed into the value cell.
    const showYear = state.period === 'latest';
    const head = `<thead><tr><th>${GEO ? 'Country' : 'Company'}</th>${GEO ? '<th class="dp-grp">Group</th>' : ''}<th class="num">${m.valueLabel}</th>${showYear ? '<th class="num">Year</th>' : ''}${showChg ? '<th class="num">Change</th>' : ''}</tr></thead>`;
    const vt = listTexts(m, rows);
    el('table-target').innerHTML = head + '<tbody>' + rows.map((r) => {
      const cls = r.change == null ? 'flat' : toneClass(r.change, m);
      const ct = chgText(m, r);
      const chg = ct ? `<span class="${cls}">${ct}</span>` : (m.categories && r.change != null ? 'same' : '—');
      return `<tr><td>${flag(r.iso)}${esc(r.entity)}</td>${GEO ? `<td class="dp-grp">${r.group || ''}</td>` : ''}<td class="num">${vt.get(r.entity)}</td>${showYear ? `<td class="num">${r.year != null ? r.year : ''}</td>` : ''}${showChg ? `<td class="num">${chg}</td>` : ''}</tr>`;
    }).join('') + '</tbody>';
  }

  const isLight = () => document.documentElement.getAttribute('data-theme') === 'light';
  // Relative luminance of a hex colour, to pick dark or light text on it.
  const lum = (hex) => { const h = hex.replace('#', ''); const [r, g, b] = [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16) / 255); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };
  // Five quantile classes, theme-aware: light runs pale → dark amber, dark runs
  // dark → bright amber, so "more" is always the stronger contrast with the
  // page and the lowest class never melts into the no-data grey.
  const SEQ_LIGHT = ['#fbecc8', '#f5cd73', '#e5a32b', '#b97400', '#6e4300'];
  const SEQ_DARK = ['#4a3913', '#7a5610', '#b07a06', '#e09d00', '#ffd055'];
  // Signed data (GDP growth): blue below zero, orange above, zero between the
  // two middle classes — a colour-blind-safe diverging pair (PuOr-like).
  const DIV = ['#2166ac', '#67a9cf', '#c6dbef', '#fdd0a2', '#f08c3a', '#b35806'];
  const seqRamp = () => isLight() ? SEQ_LIGHT : SEQ_DARK;

  // Breaks and colours for one set of values. Sequential: quintiles (ties
  // collapse a class rather than repeat a break). Diverging: symmetric around
  // 0, clamped at the 95th percentile of |v| so one outlier (Venezuela) does
  // not wash every other country into the centre.
  // Breaks rounded to two significant figures: a legend step at "92.4" people
  // or "0.6378" reads as false precision, and a round break is easier to read.
  const nice = (x) => {
    if (!x || !Number.isFinite(x)) return x;
    const p = Math.pow(10, Math.floor(Math.log10(Math.abs(x))) - 1);
    return Number((Math.round(x / p) * p).toPrecision(2));
  };
  // Category scales: one class per category, in code order, on the same ramp.
  function categoryClasses(m) {
    // Best category first, in the category colours the chips and the trend
    // lines use (lib/palette), so one status is one colour on the whole page.
    const codes = Object.keys(m.categories).map(Number).sort((a, b) => (m.better === 'high' ? b - a : a - b));
    const colors = categoryColors(codes.length);
    return { diverging: false, categorical: true, codes, breaks: [], colors, classOf: (x) => codes.indexOf(Number(x)), labels: codes.map((c) => m.categories[String(c)]) };
  }
  function classesFor(vals) {
    const m = meta();
    if (m && m.categories) return categoryClasses(m);
    const v = vals.filter(Number.isFinite).sort((a, b) => a - b);
    if (!v.length) return { diverging: false, breaks: [], colors: [], classOf: () => -1 };
    const diverging = v[0] < 0 && v[v.length - 1] > 0;
    if (diverging) {
      const abs = v.map(Math.abs).sort((a, b) => a - b);
      const L = nice(quantile(abs, 0.95) || abs[abs.length - 1] || 1);
      const breaks = [-2 * L / 3, -L / 3, 0, L / 3, 2 * L / 3];
      const classOf = (x) => { let i = 0; while (i < breaks.length && x >= breaks[i]) i++; return i; };
      return { diverging, breaks, colors: DIV, classOf, L };
    }
    const raw = [0.2, 0.4, 0.6, 0.8].map((p) => nice(quantile(v, p)));
    const breaks = raw.filter((b, i) => b > v[0] && (i === 0 || b > raw[i - 1]));
    const ramp = seqRamp();
    const k = breaks.length + 1;
    // Spread the classes over the whole ramp when ties leave fewer than five.
    const colors = Array.from({ length: k }, (_, i) => ramp[k === 1 ? ramp.length - 1 : Math.round(i * (ramp.length - 1) / (k - 1))]);
    const classOf = (x) => { let i = 0; while (i < breaks.length && x >= breaks[i]) i++; return i; };
    return { diverging, breaks, colors, classOf };
  }

  // Legend text for class i: "< 2.1", "2.1–5.0", "≥ 9.8".
  function classLabels(c, f) {
    if (c.labels) return c.labels;
    const n = c.colors.length;
    return c.colors.map((_, i) => {
      if (n === 1) return 'all';
      if (i === 0) return `< ${f(c.breaks[0])}`;
      if (i === n - 1) return `≥ ${f(c.breaks[n - 2])}`;
      return `${f(c.breaks[i - 1])} – ${f(c.breaks[i])}`;
    });
  }
  function legendSteps(c, f, noData = true) {
    const labels = classLabels(c, f);
    return `<span class="lg-steps">${c.colors.map((col, i) => `<span class="lg-step"><i style="background:${col}"></i><small>${labels[i]}</small></span>`).join('')}` +
      (noData ? `<span class="lg-step nodata"><i></i><small>No data</small></span>` : '') + `</span>`;
  }

  // The rows behind the map, by ISO3, for its hover/tap tooltip.
  let mapRows = new Map();
  // What the last map/bubble legend showed, for the PNG export.
  let lastLegend = null;
  function renderMap(rows) {
    const m = meta(); const unit = m.unit.includes('%') ? '%' : '';
    const byIso = new Map(); for (const r of rows) if (r.iso) byIso.set(r.iso, r.value);
    mapRows = new Map(rows.filter((r) => r.iso).map((r) => [r.iso, r]));
    hideMapTip();
    // Different currencies: one colour for "has data", no scale, and the line
    // that says why. The tooltip still gives each country's own value.
    const c = m.incomparable
      ? { diverging: false, breaks: [], colors: [isLight() ? SEQ_LIGHT[2] : SEQ_DARK[3]], classOf: () => 0, labels: ['Has data'] }
      : classesFor([...byIso.values()]);
    const f = (v) => fmtNum(v) + unit;
    const svg = el('view-map').querySelector('svg');
    const hatch = svg && svg.querySelector('pattern') ? `url(#${svg.querySelector('pattern').id})` : 'var(--bg-elev)';
    el('view-map').querySelectorAll('.country').forEach((p) => {
      // data-num is zero-padded ("076"); iso-numeric keys are unpadded ("76")
      const iso = isoNumeric[String(Number(p.getAttribute('data-num')))];
      const v = iso != null ? byIso.get(iso) : undefined;
      if (v == null) { p.setAttribute('fill', hatch); p.style.opacity = '1'; }
      else { p.setAttribute('fill', c.colors[c.classOf(v)]); p.style.opacity = '1'; }
    });
    if (svg) svg.dataset.period = periodLabel();
    const how = m.incomparable ? 'no colour scale: each country is in its own currency' : c.categorical ? 'one colour per category' : c.diverging ? `centred on 0 · clamped at ±${f(c.L)}` : c.colors.length < 5 ? `${c.colors.length} classes of about equal size` : 'quintiles: a fifth of countries each';
    const caption = `${m.valueLabel} · ${periodLabel()} · ${how}`;
    lastLegend = byIso.size ? { colors: c.colors, labels: classLabels(c, f), noData: true, caption } : null;
    el('map-legend').innerHTML = byIso.size
      ? `${legendSteps(c, f)}<span class="legend-label">${caption} · hover or tap a country</span>`
      : '<span class="legend-label">No countries with map positions for this period.</span>';
  }

  // Map tooltip: name, value and year on hover; a tap pins it (phones have
  // no hover, and a <title> shows nothing there). The paths' own <title>s are
  // moved to data-name so the browser's tooltip does not double this one.
  const mapWrap = el('view-map');
  const mapTip = document.createElement('div');
  mapTip.className = 'map-tip'; mapTip.hidden = true; mapTip.setAttribute('role', 'status');
  mapWrap.appendChild(mapTip);
  mapWrap.querySelectorAll('.country').forEach((p) => {
    const t = p.querySelector('title');
    if (t) { p.setAttribute('data-name', t.textContent); t.remove(); }
  });
  let mapPinned = false, mapHot = null;
  function hideMapTip() { mapTip.hidden = true; mapPinned = false; if (mapHot) { mapHot.classList.remove('hot'); mapHot = null; } }
  function showMapTip(p, ev) {
    const m = meta();
    const iso = isoNumeric[String(Number(p.getAttribute('data-num')))];
    const r = iso ? mapRows.get(iso) : null;
    const name = r ? r.entity : (iso && NAMES[iso]) || p.getAttribute('data-name') || '';
    const yr = r ? (r.year != null ? String(r.year) : periodLabel()) : '';
    mapTip.innerHTML = `<b>${flag(iso)}${esc(name)}</b>` + (r
      ? `<span class="mt-v">${esc(valText(m, r.value))}</span><span class="mt-y">${esc(m.valueLabel)} · ${esc(yr)}</span>`
      : `<span class="mt-y">No data for ${esc(periodLabel())}</span>`);
    if (mapHot) mapHot.classList.remove('hot');
    mapHot = p; p.classList.add('hot');
    mapTip.hidden = false;
    const box = mapWrap.getBoundingClientRect();
    const x = ev.clientX - box.left, y = ev.clientY - box.top;
    mapTip.style.left = Math.max(4, Math.min(x + 12, box.width - mapTip.offsetWidth - 4)) + 'px';
    mapTip.style.top = (y - mapTip.offsetHeight - 12 >= 0 ? y - mapTip.offsetHeight - 12 : y + 16) + 'px';
  }
  mapWrap.addEventListener('mousemove', (e) => {
    if (mapPinned) return;
    const p = e.target.closest && e.target.closest('.country');
    if (p) showMapTip(p, e); else hideMapTip();
  });
  mapWrap.addEventListener('mouseleave', () => { if (!mapPinned) hideMapTip(); });
  mapWrap.addEventListener('click', (e) => {
    const p = e.target.closest && e.target.closest('.country');
    if (p) { showMapTip(p, e); mapPinned = true; } else hideMapTip();
  });

  // Dorling-style bubble map: a circle per country, area = value, anchored at
  // the country's map position and gently pushed apart until nothing overlaps.
  function renderBubbles(rows) {
    const m = meta(); const unit = m.unit.includes('%') ? '%' : '';
    if (m.incomparable) { el('bubble-nodes').innerHTML = ''; lastLegend = null; el('bubble-legend').innerHTML = '<span class="legend-label">No bubbles: each country is in its own currency, so circle sizes would not compare.</span>'; return; }
    const rk = ranksOf(m, rows);
    const data = rows.map((r) => ({ ...r, rank: rk.get(r.entity) })).filter((r) => r.iso && CENT[r.iso]).slice(0, 60);
    // reset any lingering hover highlight from a previous indicator/period
    el('bubble-nodes').classList.remove('focus');
    el('view-bubbles').querySelectorAll('.bubble-basemap.hl').forEach((p) => p.classList.remove('hl'));
    if (!data.length) { el('bubble-nodes').innerHTML = ''; el('bubble-legend').innerHTML = '<span class="legend-label">No countries with map positions for this indicator.</span>'; return; }
    const signed = data.some((r) => r.value < 0);
    const maxV = Math.max(...data.map((r) => Math.abs(r.value))) || 1;
    const W = 960, H = 520, MAXR = 54, MINR = 4;
    // pow 0.4 instead of a strict sqrt: one outlier (Hong Kong at 1,114%)
    // would otherwise shrink everyone else into unlabelled dots
    const nodes = data.map((r) => ({ ...r,
      x: CENT[r.iso][0], y: CENT[r.iso][1] + 20,
      r: Math.max(MINR, Math.pow(Math.abs(r.value) / maxV, 0.4) * MAXR) }));
    for (let it = 0; it < 70; it++) {
      for (let i = 0; i < nodes.length; i++) for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i], b = nodes[j];
        let dx = b.x - a.x, dy = b.y - a.y;
        const d = Math.hypot(dx, dy) || 0.001, min = a.r + b.r + 1.5;
        if (d < min) { const push = (min - d) / 2; dx /= d; dy /= d; a.x -= dx * push; a.y -= dy * push; b.x += dx * push; b.y += dy * push; }
      }
      for (const n of nodes) { n.x = Math.max(n.r + 2, Math.min(W - n.r - 2, n.x)); n.y = Math.max(n.r + 2, Math.min(H - n.r - 2, n.y)); }
    }
    // Same classes and colours as the map, from every country in the period.
    const cls = classesFor(rows.map((r) => r.value));
    el('bubble-target').dataset.lbl = m.valueLabel;
    el('bubble-nodes').innerHTML = nodes.map((n) => {
      const col = cls.colors[cls.classOf(n.value)] || '#9aa1a9';
      const txt = lum(col) > 0.5 ? '#1a1300' : '#f3f4f6';
      const a2 = isoAlpha2[n.iso] || n.iso.slice(0, 2);
      const showCode = n.r > 9, showVal = n.r > 19;
      const ent = String(n.entity).replace(/"/g, '&quot;');
      return `<g transform="translate(${n.x.toFixed(1)},${n.y.toFixed(1)})" data-e="${ent}" data-iso="${n.iso}"` +
        ` data-v="${esc(valText(m, n.value))}" data-r="#${n.rank} of ${rows.length}"` +
        ` data-c="${esc(chgText(m, n))}" data-g="${n.group || ''}" data-y="${n.year != null ? n.year : ''}">` +
        `<circle r="${n.r.toFixed(1)}" fill="${col}" fill-opacity="0.94" stroke="rgba(0,0,0,0.35)" stroke-width="1"></circle>` +
        (showCode ? `<text class="bub-t" fill="${txt}" y="${showVal ? -2.5 : 4}">${a2}</text>` : '') +
        (showVal ? `<text class="bub-v" fill="${txt}" y="12">${esc(valText(m, n.value))}</text>` : '') + `</g>`;
    }).join('');
    const fb = (v) => fmtNum(v) + unit;
    const bcap = `${m.valueLabel} · ${periodLabel()} · bubble size = ${signed ? '|value|' : 'value'} · top ${nodes.length} of ${rows.length} countries`;
    lastLegend = { colors: cls.colors, labels: classLabels(cls, fb), noData: false, caption: bcap };
    el('bubble-target').dataset.period = periodLabel();
    el('bubble-legend').innerHTML = `${legendSteps(cls, fb, false)}<span class="legend-label">${bcap} · hover or tap a bubble</span>`;
  }

  // Bubble tooltip: hover for the full story, click/tap to pin it.
  {
    const btgt = el('bubble-target'), btip = el('bubble-tip'), bwrap = el('view-bubbles');
    let pinned = false;
    let hlPath = null;
    const clearFocus = () => {
      if (hlPath) { hlPath.classList.remove('hl'); hlPath = null; }
      const nodes = el('bubble-nodes'); nodes.classList.remove('focus');
      nodes.querySelectorAll('g[data-e]').forEach((x) => { x.classList.remove('hot'); x.style.opacity = ''; });
    };
    const focusOn = (g) => {
      const nodes = el('bubble-nodes');
      // dim the others directly (SVG <g> opacity via the CSS cascade is flaky)
      nodes.querySelectorAll('g[data-e]').forEach((x) => { x.style.opacity = x === g ? '1' : '0.28'; x.classList.toggle('hot', x === g); });
      nodes.classList.add('focus');
      if (hlPath) hlPath.classList.remove('hl');
      const p = btgt.querySelector('.bubble-basemap[data-iso="' + g.dataset.iso + '"]');
      if (p) { p.classList.add('hl'); hlPath = p; } else hlPath = null;
    };
    const show = (g, ev) => {
      focusOn(g);
      const d = g.dataset;
      btip.innerHTML = `<b>${flag(d.iso)}${d.e}</b>` +
        `<div class="tr"><span>${btgt.dataset.lbl || 'Value'}</span><b>${d.v}</b></div>` +
        `<div class="tr"><span>Rank</span><b>${d.r}</b></div>` +
        (d.y ? `<div class="tr"><span>Year</span><b>${d.y}</b></div>` : '') +
        (d.c ? `<div class="tr"><span>${/^was /.test(d.c) ? 'Previous period' : 'vs previous period'}</span><b>${d.c}</b></div>` : '') +
        (d.g ? `<div class="tr"><span>Region</span><b>${d.g}</b></div>` : '');
      btip.hidden = false;
      const r = bwrap.getBoundingClientRect();
      const x = ev.clientX - r.left, y = ev.clientY - r.top;
      btip.style.left = Math.max(4, Math.min(x + 14, r.width - btip.offsetWidth - 8)) + 'px';
      btip.style.top = Math.max(y - btip.offsetHeight - 12, 4) + 'px';
    };
    btgt.addEventListener('mousemove', (e) => {
      if (pinned) return;
      const g = e.target.closest('g[data-e]');
      if (g) show(g, e); else { btip.hidden = true; clearFocus(); }
    });
    btgt.addEventListener('mouseleave', () => { if (!pinned) { btip.hidden = true; clearFocus(); } });
    btgt.addEventListener('click', (e) => {
      const g = e.target.closest('g[data-e]');
      if (g) { pinned = true; show(g, e); } else { pinned = false; btip.hidden = true; clearFocus(); }
    });
  }

  // ---- PNG export of what is on screen (ChartActions calls this) ----
  // ChartActions finds the panel by its selector and calls bdExportSvg(): the
  // bars, the map or the bubbles as one SVG, with the legend drawn in. The
  // SVG is attached off-screen so its CSS colours resolve before ChartActions
  // bakes them in; data-temp tells ChartActions to remove it afterwards.
  // (The old export always took the map, which in the Bars view had never
  // been coloured: an empty grey world.)
  const NS = 'http://www.w3.org/2000/svg';
  const mk = (tag, attrs, text) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, String(attrs[k])); if (text != null) e.textContent = text; return e; };
  const MONO = 'ui-monospace,SFMono-Regular,Menlo,monospace';
  const cut = (t, n) => (t.length > n ? t.slice(0, n - 1) + '…' : t);
  let lastRows = [];

  function legendInto(svg, lg, W, y0, nodataFill) {
    const pad = 12;
    svg.appendChild(mk('text', { x: pad, y: y0 + 16, fill: 'var(--text-dim)', style: `font-family:${MONO};font-size:12px` }, cut(lg.caption, Math.floor((W - 2 * pad) / 7.4))));
    const items = lg.colors.map((c, i) => ({ fill: c, label: lg.labels[i] }));
    if (lg.noData && nodataFill) items.push({ fill: nodataFill, label: 'No data' });
    const sw = Math.min(130, (W - 2 * pad) / items.length - 8);
    items.forEach((it, i) => {
      const x = pad + i * (sw + 8);
      svg.appendChild(mk('rect', { x, y: y0 + 26, width: sw, height: 12, fill: it.fill, stroke: 'var(--border)', 'stroke-width': 1 }));
      svg.appendChild(mk('text', { x: x + sw / 2, y: y0 + 54, 'text-anchor': 'middle', fill: 'var(--text-dim)', style: `font-family:${MONO};font-size:12px` }, cut(it.label, Math.floor(sw / 7.2))));
    });
  }

  function barsSvg(rows) {
    const m = meta();
    const W = 760, top = 34, rowH = 30, H = top + rows.length * rowH + 10;
    const svg = mk('svg', { xmlns: NS, viewBox: `0 0 ${W} ${H}` });
    const shown = state.query ? `matching "${state.query}"` : state.showAll || state.sortDir === 'name' ? `all ${lastRows.length} ${NOUNS}` : `${rows.length} of ${lastRows.length} ${NOUNS}`;
    const order = { desc: 'highest first', asc: 'lowest first', name: 'A–Z' }[state.sortDir];
    svg.appendChild(mk('text', { x: 12, y: 20, fill: 'var(--text-dim)', style: `font-family:${MONO};font-size:12px` }, cut(`${m.valueLabel} · ${periodLabel()} · ${shown}, ${order}`, 100)));
    const vals = rows.map((r) => r.value);
    const lo = Math.min(0, ...vals), hi = Math.max(0, ...vals), span = (hi - lo) || 1;
    const tx = 236, tw = 330;
    const X = (v) => tx + (v - lo) / span * tw;
    rows.forEach((r, i) => {
      const y = top + i * rowH;
      svg.appendChild(mk('text', { x: 12, y: y + 19, fill: 'var(--text)', style: 'font-size:13px' }, cut(r.entity, 30)));
      svg.appendChild(mk('rect', { x: tx, y: y + 9, width: tw, height: 12, rx: 6, fill: 'var(--bg-elev)', stroke: 'var(--border)', 'stroke-width': 1 }));
      const a = X(Math.min(0, r.value)), b = X(Math.max(0, r.value));
      svg.appendChild(mk('rect', { x: a.toFixed(1), y: y + 9, width: Math.max(3, b - a).toFixed(1), height: 12, rx: 6, fill: 'var(--accent)' }));
      const t = mk('text', { x: W - 12, y: y + 19, 'text-anchor': 'end', fill: 'var(--text)', style: `font-family:${MONO};font-size:13px` });
      t.appendChild(mk('tspan', {}, valText(m, r.value)));
      const ct = chgText(m, r);
      if (ct) t.appendChild(mk('tspan', { dx: 8, fill: 'var(--text-dim)', style: 'font-size:11px' }, ct));
      if (r.year != null) t.appendChild(mk('tspan', { dx: 8, fill: 'var(--text-dim)', style: 'font-size:11px' }, String(r.year)));
      svg.appendChild(t);
    });
    if (lo < 0) svg.appendChild(mk('line', { x1: X(0), x2: X(0), y1: top, y2: H - 6, stroke: 'var(--text-dim)', 'stroke-width': 1 }));
    return svg;
  }

  function mapSvg(src) {
    const vb = src.viewBox.baseVal;
    const legendH = lastLegend ? 66 : 0;
    const svg = mk('svg', { xmlns: NS, viewBox: `0 0 ${vb.width} ${vb.height + legendH}` });
    const g = mk('g', { transform: `translate(${-vb.x} ${-vb.y})` });
    // Styles that come from rules scoped to the on-screen view (#view-bubbles
    // .bub-t: text-anchor, font) do not reach a copy outside it: carry them over.
    const KEEP = ['text-anchor', 'font-family', 'font-size', 'font-weight', 'opacity'];
    for (const ch of src.childNodes) {
      const c = ch.cloneNode(true);
      if (ch.nodeType === 1) {
        const from = [ch, ...ch.querySelectorAll('text')], to = [c, ...c.querySelectorAll('text')];
        from.forEach((s, i) => { if (s.tagName === 'text') { const cs = getComputedStyle(s); to[i].setAttribute('style', KEEP.map((k) => `${k}:${cs.getPropertyValue(k)}`).join(';')); } });
      }
      g.appendChild(c);
    }
    g.querySelectorAll('.hot,.hl').forEach((x) => x.classList.remove('hot', 'hl'));
    g.querySelectorAll('g[data-e]').forEach((x) => { x.style.opacity = ''; });
    svg.appendChild(g);
    const pat = src.querySelector('pattern');
    if (lastLegend) legendInto(svg, lastLegend, vb.width, vb.height, pat ? `url(#${pat.id})` : null);
    return svg;
  }

  el('view-bar').closest('.datapanel').bdExportSvg = () => {
    let svg;
    if (state.view === 'map') svg = mapSvg(el('view-map').querySelector('svg'));
    else if (state.view === 'bubbles') svg = mapSvg(el('bubble-target'));
    // The table exports as the bar chart of the same rows: a 190-row table is
    // not a picture.
    else svg = barsSvg(visibleRows(lastRows));
    // Title and source of the indicator on screen, for the PNG footer where
    // the page's button does not name them (/markets, /explore).
    svg.dataset.period = periodLabel();
    svg.dataset.title = meta().title;
    svg.dataset.source = meta().source || '';
    svg.setAttribute('data-temp', '1');
    svg.setAttribute('aria-hidden', 'true');
    svg.style.cssText = 'position:fixed;left:-10000px;top:0;width:960px;height:auto;pointer-events:none';
    document.body.appendChild(svg);
    return svg;
  };

  async function render() {
    const ds = await load(state.slug); const m = meta(); const rows = rowsFor(ds);
    lastRows = rows;
    // On a dataset page the heading above is the value label: the summary
    // repeats it rather than the dataset title ("Stock Market Capitalisation"
    // under "Listed-company market cap").
    // The unit is left out where the label already carries it, and for a
    // category scale, whose "1=free…3=not" codes are shown by name.
    const label = cfg.pinnedSlug ? m.valueLabel : m.title;
    el('ex-summary').textContent = `${label} · ${periodLabel()} · ${rows.length} ${rows.length === 1 ? NOUN : NOUNS}${label.includes(m.unit) || m.categories ? '' : ` · unit ${m.unit}`}`;
    for (const v of ['bar', 'table', 'map', 'bubbles']) el('view-' + v).hidden = state.view !== v;
    if (state.view === 'bar') renderBars(rows); else if (state.view === 'table') renderTable(rows); else if (state.view === 'bubbles') renderBubbles(rows); else renderMap(rows);
    syncUrl();
  }

  selP.addEventListener('change', () => { state.period = selP.value; render(); });
  selQ.addEventListener('input', () => { state.query = selQ.value.trim(); render(); });
  el('add-country').addEventListener('change', (e) => { if (e.target.value) { state.pinned.add(e.target.value); saveMy(); render(); } });
  el('pinned-chips').addEventListener('click', (e) => { const n = e.target.getAttribute('data-rm'); if (n) { state.pinned.delete(n); saveMy(); render(); } });
  el('show-all').addEventListener('click', () => { state.showAll = !state.showAll; render(); });
  el('sort-dir').addEventListener('click', () => { state.sortDir = { desc: 'asc', asc: 'name', name: 'desc' }[state.sortDir]; render(); });
  el('view-toggle').addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b) return;
    state.view = b.dataset.view;
    [...el('view-toggle').children].forEach((x) => x.classList.toggle('active', x === b));
    render();
  });

  // The map's ramp depends on the theme: redraw when it is switched.
  new MutationObserver(() => { if (state.view === 'map' || state.view === 'bubbles') render(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // reflect restored view in the toggle
  [...el('view-toggle').children].forEach((x) => x.classList.toggle('active', x.dataset.view === state.view));
  fillPeriods();
  render();
</script>

<style>
  /* The "add country" select sizes itself to its longest option; capped so a
     long name cannot push the page wider than a phone. */
  .datapanel .inline-add { min-width: 0; max-width: 100%; }
  .datapanel .inline-add select { min-width: 0; max-width: min(100%, 260px); text-overflow: ellipsis; }
  /* Tap targets of at least 32 px: the sort and show-all buttons, and the
     chips' remove buttons (drawn by the script, hence :global). */
  .datapanel .bar-controls .ghost-btn { min-height: 32px; }
  .datapanel :global(.chip) { padding-top: 0; padding-bottom: 0; }
  .datapanel :global(.chip button) { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; min-height: 32px; margin-right: -4px; }
  /* Category scale: a status chip where a bar would be (a bar's length would
     be a code). Exchange rates: no bar at all, values only. */
  .datapanel :global(.bar-track-cat), .datapanel :global(.bar-track-none) { background: none; border: 0; height: auto; overflow: visible; }
  .datapanel :global(.bar-cat) { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; line-height: 18px; white-space: nowrap; }
  /* The table scrolls sideways inside the panel rather than being cut off;
     on phones the region column gives way to the values. */
  #view-table { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  @media (max-width: 560px) { #view-table :global(.dp-grp) { display: none; } }
  /* Map tooltip (hover; a tap pins it). */
  #view-map { position: relative; }
  #view-map :global(.country) { cursor: pointer; }
  #view-map :global(.country.hot) { stroke: var(--accent); stroke-width: 1.2; }
  #view-map :global(.map-tip) {
    position: absolute; z-index: 6; pointer-events: none; display: flex; flex-direction: column; gap: 2px;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px;
    font-size: 12px; color: var(--text); white-space: nowrap; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }
  #view-map :global(.map-tip[hidden]) { display: none; }
  #view-map :global(.map-tip .mt-v) { font-family: var(--mono); font-size: 15px; font-weight: 700; }
  #view-map :global(.map-tip .mt-y) { color: var(--text-dim); font-size: 11px; }
</style>
