---
import { sourcesByKind } from '@data/sources';
import { datasets } from '@data/datasets';

interface Props {
  kind: 'macro' | 'survey';
  /** 'live' = only ingested studies, 'catalog' = only catalogued ones, 'all' = both */
  mode?: 'live' | 'catalog' | 'all';
}
const { kind, mode = 'all' } = Astro.props;
const list = sourcesByKind(kind).filter((s) => mode === 'all' || s.status === mode);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function ownDatasets(match?: string) {
  if (!match) return [];
  return datasets.filter((d) => d.source.includes(match)).sort((a, b) => a.title.localeCompare(b.title));
}
// keep category order, but only categories present for this kind
const cats = [...new Set(list.map((s) => s.category))];
---
<div class="grid" style="gap:28px">
  {cats.map((cat) => (
    <div>
      {cats.length > 1 && <h3 style="margin:0 0 14px">{cat}</h3>}
      <div class="grid cols-2">
        {list.filter((s) => s.category === cat).map((s) => {
          const own = ownDatasets(s.match);
          return (
            <div class="card source-card">
              <div class="source-head">
                <h3><a href={s.url} target="_blank" rel="noopener">{s.name} ↗</a></h3>
                {s.status === 'live'
                  ? <span class="badge live">Live · {own.length} {own.length === 1 ? 'dataset' : 'datasets'}</span>
                  : <span class="badge catalog">Catalogue</span>}
              </div>
              <p class="meta">{s.description}</p>
              {own.length > 0 && (
                <p class="src-inds">
                  {own.map((d) => (
                    <a class="src-ind" href={`${base}/dataset/${d.slug}`}>{d.title}</a>
                  ))}
                </p>
              )}
              {s.dash && (
                <p class="meta" style="margin-top:10px">
                  <a href={`${base}/dashboards/${s.dash}`} target="_blank" rel="noopener">📊 Full results dashboard ↗</a>
                </p>
              )}
            </div>
          );
        })}
      </div>
    </div>
  ))}
</div>
