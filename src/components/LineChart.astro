---
import { periodYear } from '@lib/trend';
interface Point { x: string; y: number }
interface Props { points: Point[]; yLabel?: string; yMax?: number }
const { points, yLabel = '', yMax = 100 } = Astro.props;

// Two drawings, as in Scatter: a wide 760 × 320 one and a narrow 380 × 260 one
// for phones (.tc-wide / .tc-narrow, global.css), so the axis text stays
// readable instead of shrinking to about 5 px. The wide one comes first in
// the DOM, so ChartActions exports it.
const n = points.length;
// x by time (chart rules, lib/trend.ts): uneven survey years keep their gaps.
const yrs = points.map((p) => periodYear(p.x));
const byTime = yrs.every(Number.isFinite) && yrs[n - 1] > yrs[0];
const yTicks = [0, 25, 50, 75, 100].filter((v) => v <= yMax);
const last = points[n - 1];

const VARIANTS = [
  { cls: 'tc-wide', W: 760, H: 320, m: { t: 16, r: 20, b: 34, l: 40 }, xLabels: 8, gid: 'lc-fill-w' },
  { cls: 'tc-narrow', W: 380, H: 260, m: { t: 18, r: 14, b: 30, l: 34 }, xLabels: 4, gid: 'lc-fill-n' },
];
const drawings = VARIANTS.map((v) => {
  const iw = v.W - v.m.l - v.m.r, ih = v.H - v.m.t - v.m.b;
  const X = (i: number) => v.m.l + (n === 1 ? iw / 2 : ((byTime ? (yrs[i] - yrs[0]) / (yrs[n - 1] - yrs[0]) : i / (n - 1))) * iw);
  const Y = (y: number) => v.m.t + ih - (y / yMax) * ih;
  const line = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${X(i).toFixed(1)},${Y(p.y).toFixed(1)}`).join(' ');
  const area = `${line} L${X(n - 1).toFixed(1)},${(v.m.t + ih).toFixed(1)} L${X(0).toFixed(1)},${(v.m.t + ih).toFixed(1)} Z`;
  // Every k-th year, plus the last one unless it would sit on the previous label.
  const step = Math.ceil(n / v.xLabels);
  const xIdx = points.map((_, i) => i).filter((i) => i % step === 0 && (i === n - 1 || n - 1 - i >= step * 0.6 || i === 0));
  if (!xIdx.includes(n - 1)) xIdx.push(n - 1);
  return { ...v, iw, ih, X, Y, line, area, xIdx };
});
---
<div class="chart-svg">
  {drawings.map((d) => (
    <svg class={d.cls} viewBox={`0 0 ${d.W} ${d.H}`} role="img" aria-label={yLabel}>
      <defs>
        <linearGradient id={d.gid} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.35" />
          <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
        </linearGradient>
      </defs>
      {yTicks.map((v) => (
        <g>
          <line x1={d.m.l} y1={d.Y(v)} x2={d.W - d.m.r} y2={d.Y(v)} stroke="var(--border)" stroke-width="1" />
          <text x={d.m.l - 6} y={d.Y(v) + 4} text-anchor="end" class="axis">{v}</text>
        </g>
      ))}
      {d.xIdx.map((i) => (
        <text x={d.X(i)} y={d.H - d.m.b + 18} text-anchor="middle" class="axis">{points[i].x}</text>
      ))}
      <path d={d.area} fill={`url(#${d.gid})`} />
      <path d={d.line} fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
      {points.map((p, i) => <circle cx={d.X(i)} cy={d.Y(p.y)} r={i === n - 1 ? 5 : 3} fill="var(--accent)" />)}
      <text x={d.X(n - 1) - 6} y={d.Y(last.y) - 10} text-anchor="end" class="pt-label" fill="var(--text)" style="font-weight:700">{last.y}%</text>
    </svg>
  ))}
</div>
