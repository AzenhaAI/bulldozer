---
/**
 * "Open in the app" bar for phone browsers, on every page (SEO session,
 * 18 Nov 2026: one OS-aware app prompt per screen on all four products).
 *
 *   Android            our bar: Google Play (opens the app when installed,
 *                      via an intent with Play as the fallback) + small APK
 *   iPhone in Safari   nothing here: Safari's Smart App Banner (the
 *                      apple-itunes-app meta in BaseLayout) does it, with
 *                      "Open" for people who have the app
 *   other iOS browsers our bar with the App Store (Chrome, Firefox, Edge and
 *   and iPadOS         in-app browsers get no Smart App Banner; an iPad in
 *                      desktop mode reports a Mac, told apart by touch points)
 *   desktop            nothing
 *
 * Never inside the apps' own web views (html.in-app), in an installed web app,
 * on /ask (the bar would cover the Ask box) or /apps (the page is the badges),
 * nor while the dataset page's own app card is on screen: one prompt at a time.
 * A dismissal holds for 14 days. Replaces azenha.ai's Android strip (#az-apk,
 * hidden by the style below on these pages) and the iOS card that #a2hs used to show.
 *
 * GA4: app_banner_view and app_banner_dismiss { store, page_type:
 * 'mobile_banner' }; the store and APK taps are store_click through
 * BaseLayout's listener, which reads data-placement.
 */
import { appScreen } from '@lib/app-screen';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const screen = appScreen(Astro.url.pathname);
const PLAY_URL = 'https://play.google.com/store/apps/details?id=ai.azenha.bulldozer&referrer=utm_source%3Dsite%26utm_medium%3Dmobile_banner';
const IOS_URL = 'https://apps.apple.com/app/apple-store/id6797664814?pt=129240922&ct=mobile_banner&mt=8';
const PLAY = 'M4.6 2.6a1 1 0 0 0-.5.9v17a1 1 0 0 0 .5.9l9.1-9.4-9.1-9.4Zm10.2 8.3 2.9-3-9.9-5.6 7 8.6Zm0 2.2-7 8.6 9.9-5.6-2.9-3Zm4.1-2.2-2.4-1.4-3 3.5 3 3.5 2.4-1.4c.9-.5.9-1.7 0-2.2Z';
const APPLE = 'M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.7-3.1.7-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4 0 0-2.7-1-2.7-3.4ZM14.3 6.6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2Z';
---
<div id="bd-app" data-placement="mobile_banner" data-screen={screen} hidden>
  <img src={`${base}/icon-192.png`} width="34" height="34" alt="" />
  <p><b>BullDozer Stats</b><span>Open in the app — free<span class="bd-app-and"> · <a class="bd-app-apk" href={`${base}/downloads/bulldozer-stats.apk`} download>APK</a></span></span></p>
  <a class="bd-app-go bd-app-and" href={PLAY_URL}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d={PLAY} /></svg>Google Play
  </a>
  <a class="bd-app-go bd-app-ios" href={IOS_URL}>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d={APPLE} /></svg>App Store
  </a>
  <button type="button" id="bd-app-x" aria-label="Dismiss">&times;</button>
</div>

<style is:global>
  #bd-app {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 95;
    display: flex; align-items: center; gap: 9px;
    padding: 8px 2px 8px 12px; padding-bottom: calc(8px + env(safe-area-inset-bottom));
    background: var(--bg-elev); color: var(--text); border-top: 1px solid var(--border);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.22);
    font: 13px/1.3 var(--font);
  }
  #bd-app[hidden], html.in-app #bd-app { display: none !important; }
  #bd-app img { flex: none; width: 34px; height: 34px; border-radius: 8px; }
  #bd-app p { flex: 1; min-width: 0; margin: 0; display: flex; flex-direction: column; }
  #bd-app p b { font-size: 14px; }
  #bd-app p > span { color: var(--text-dim); font-size: 12px; }
  #bd-app[data-os="android"] .bd-app-ios, #bd-app[data-os="ios"] .bd-app-and { display: none; }
  #bd-app .bd-app-go {
    flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 12px;
    border-radius: 999px; background: var(--accent-fill); color: #1a1300; font-weight: 700; font-size: 13.5px;
    text-decoration: none; white-space: nowrap;
  }
  /* Small, but a 40px-tall target: a phone without Google Play has no other way in. */
  #bd-app .bd-app-apk { color: var(--text-dim); text-decoration: underline; display: inline-block; padding: 12px 6px; margin: -12px -6px; }
  #bd-app #bd-app-x {
    flex: none; width: 44px; height: 44px; border: 0; background: none; color: var(--text-dim);
    font-size: 24px; line-height: 1; cursor: pointer; -webkit-tap-highlight-color: rgba(127, 127, 127, 0.2);
  }
  @media (prefers-reduced-motion: no-preference) { #bd-app { animation: bd-app-up .25s ease-out; } }
  @keyframes bd-app-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
  /* azenha.ai's own Android strip: this bar takes its place on BullDozer pages. */
  html #az-apk { display: none !important; }
  /* The open ☰ menu reaches the bottom of the screen. */
  html:has(#hdr-burger[aria-expanded="true"]) #bd-app { display: none !important; }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('bd-app');
    if (!el || document.documentElement.classList.contains('in-app')) return;
    try { if (window.top !== window.self) return; } catch (e) { return; }
    if (/\/(ask|apps)\/?$/.test(location.pathname)) return;
    var KEY = 'bd-app-hidden';
    try {
      if (matchMedia('(display-mode: standalone)').matches || navigator.standalone) return;
      if (Date.now() < +(localStorage.getItem(KEY) || 0)) return;
    } catch (e) {}

    var ua = navigator.userAgent;
    var android = /Android/.test(ua);
    var iPadDesk = !android && /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
    var iOS = !android && (/iPhone|iPod|iPad/.test(ua) || iPadDesk);
    if (iOS) {
      // The app needs iOS 15; below that the App Store would offer nothing.
      var v = +((ua.match(/OS (\d+)_/) || [])[1] || 99);
      if (v < 15) return;
      // Safari proper shows the Smart App Banner. Everything else on iOS is
      // WebKit too but names itself (CriOS, FxiOS, EdgiOS...) or is an app's
      // web view, which has no "Safari/" token.
      var safari = !iPadDesk && /Safari\//.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS|OPT\/|GSA\/|YaBrowser|DuckDuckGo|Instagram|FBAN|FBAV|Line\/|Telegram/.test(ua);
      if (safari) return;
    } else if (!android) return;
    var store = iOS ? 'app_store' : 'google_play';
    el.setAttribute('data-os', iOS ? 'ios' : 'android');

    function ga(name) {
      if (window.gtag) gtag('event', name, { store: store, page_type: 'mobile_banner', page_path: location.pathname });
    }

    // Android, Chrome and Samsung Internet: the Play button opens the app on
    // the same screen when it is installed, and Google Play when it is not.
    var go = el.querySelector('a.bd-app-go.bd-app-and');
    if (android && /Chrome\//.test(ua) && !/Firefox|; wv\)/.test(ua)) {
      go.addEventListener('click', function (e) {
        e.preventDefault();
        location.href = 'intent://open/' + (el.getAttribute('data-screen') || '') +
          '#Intent;scheme=bulldozerstats;package=ai.azenha.bulldozer;S.browser_fallback_url=' +
          encodeURIComponent(go.href) + ';end';
      });
    }

    function close() {
      el.hidden = true;
      try { localStorage.setItem(KEY, String(Date.now() + 14 * 864e5)); } catch (e) {}
    }
    document.getElementById('bd-app-x').addEventListener('click', function () { close(); ga('app_banner_dismiss'); });

    // One prompt per screen: while the dataset page's own app card is in
    // view, it is the prompt.
    var card = document.querySelector('.handoff');
    var cardOn = false, ready = false, viewed = false;
    function apply() {
      if (!ready) return;
      var off = cardOn;
      if (el.hidden !== off) el.hidden = off;
      if (!off && !viewed) { viewed = true; ga('app_banner_view'); }
    }
    if (card && window.IntersectionObserver) {
      new IntersectionObserver(function (es) { cardOn = es[es.length - 1].isIntersecting; apply(); }).observe(card);
    }
    // Not in the first second: a bar that is there before the page reads as an ad.
    setTimeout(function () {
      try { if (Date.now() < +(localStorage.getItem(KEY) || 0)) return; } catch (e) {}
      ready = true; apply();
    }, 1500);
    // Dismissed bars stay dismissed: apply() only ever shows a bar not closed.
    document.getElementById('bd-app-x').addEventListener('click', function () { ready = false; });
    // Back from a page where it was dismissed: the cached page still shows it.
    addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      try { if (Date.now() < +(localStorage.getItem(KEY) || 0)) { ready = false; el.hidden = true; } } catch (x) {}
    });
  })();
</script>
