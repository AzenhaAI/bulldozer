---
import { colorFor } from '@lib/palette';

export interface Point { x: number; y: number; label: string; group?: string; highlight?: boolean }
interface Props {
  points: Point[];
  xLabel: string;
  yLabel: string;
  xLog?: boolean;
  labelTop?: number; // label the N highest-y points
}
const { points, xLabel, yLabel, xLog = false, labelTop = 0 } = Astro.props;

// Two drawings of the same chart: a wide one (760 × 460) and a narrow one
// (380 × 360) shown on phones (.tc-wide / .tc-narrow, global.css). One
// 760-wide viewBox scaled down to a 350 px phone drew its 11 px text at about
// 5 px. The wide one comes first in the DOM, so ChartActions exports it.
const tx = (v: number) => (xLog ? Math.log10(Math.max(v, 1)) : v);
const xs = points.map((p) => tx(p.x));
const ys = points.map((p) => p.y);
// On a log axis the domain stretches to the decade ticks just past the data:
// the 1k tick sat at x = −21, outside the plot, and only 10k and 100k showed
// (QA, 16 Nov 2026).
const LOG_TICKS = [1, 10, 100, 1000, 10000, 100000, 1000000];
const dataXMin = Math.min(...xs), dataXMax = Math.max(...xs);
const nearTicks = xLog ? LOG_TICKS.map((t) => Math.log10(t)).filter((t) => t >= dataXMin - 0.3 && t <= dataXMax + 0.3) : [];
const xMin = Math.min(dataXMin, ...nearTicks), xMax = Math.max(dataXMax, ...nearTicks);
const yMin = Math.min(...ys), yMax = Math.max(...ys);
const padY = (yMax - yMin) * 0.05 || 1;
const rawXMin = Math.min(...points.map((p) => p.x)), rawXMax = Math.max(...points.map((p) => p.x));

// A true minus sign (U+2212) on the axes, as everywhere else on the site.
const minus = (s: string) => s.replace(/^-/, '−');
const fmtX = (v: number) => minus(Math.abs(v) >= 1000 ? `${Math.round(v / 1000)}k` : `${v}`);
const fmtY = (v: number) => minus(String(v));
// tooltip-friendly value: keep small decimals, abbreviate big magnitudes
const trimZeros = (s: string) => s.replace(/0+$/, '').replace(/\.$/, '');
const fmtVal = (v: number) => {
  const a = Math.abs(v);
  if (a >= 1000) return minus(trimZeros((v / 1000).toFixed(1)) + 'k');
  if (a >= 100) return minus(String(Math.round(v)));
  if (a >= 10) return minus(trimZeros(v.toFixed(1)));
  return minus(trimZeros(v.toFixed(2)));
};

// Which points ask for a label, most important first: highlighted ones, then
// the labelTop highest.
const sortedByY = [...points].sort((a, b) => b.y - a.y);
const wanted = [
  ...points.filter((p) => p.highlight),
  ...sortedByY.slice(0, labelTop).filter((p) => !p.highlight),
];

// Round tick steps (1, 2, 2.5, 5 × 10^k) inside [lo, hi]. The old ticks were
// Math.round of evenly spaced values: on a 0.2–0.6 axis (cultural map) every
// x tick rounded to 0 or 1 and fell outside the plot, so the axis had none.
const niceTicks = (lo: number, hi: number, n: number) => {
  const raw = (hi - lo) / Math.max(1, n);
  if (!(raw > 0)) return [Math.round(lo * 100) / 100];
  const p = Math.pow(10, Math.floor(Math.log10(raw)));
  const step = [1, 2, 2.5, 5, 10].map((k) => k * p).find((s) => s >= raw * 0.7)!;
  const dp = Math.max(0, -Math.floor(Math.log10(step)) + (step / p === 2.5 ? 1 : 0));
  const out: number[] = [];
  for (let v = Math.ceil(lo / step) * step; v <= hi + step * 1e-9; v += step) out.push(Number(v.toFixed(dp)));
  return out;
};

interface Variant { cls: string; W: number; H: number; m: { t: number; r: number; b: number; l: number }; yTicks: number; xTicks: number; fs: number; pr: number }
const VARIANTS: Variant[] = [
  { cls: 'tc-wide', W: 760, H: 460, m: { t: 20, r: 20, b: 48, l: 48 }, yTicks: 5, xTicks: 5, fs: 11, pr: 4 },
  { cls: 'tc-narrow', W: 380, H: 360, m: { t: 14, r: 12, b: 44, l: 40 }, yTicks: 4, xTicks: 4, fs: 11, pr: 4.5 },
];

const build = (v: Variant) => {
  const { W, H, m } = v;
  const iw = W - m.l - m.r, ih = H - m.t - m.b;
  const X = (x: number) => m.l + ((tx(x) - xMin) / (xMax - xMin || 1)) * iw;
  const Y = (y: number) => m.t + ih - ((y - (yMin - padY)) / ((yMax + padY) - (yMin - padY) || 1)) * ih;
  const yvals = niceTicks(yMin - padY, yMax + padY, v.yTicks);
  const xvals = xLog
    ? LOG_TICKS.filter((x) => tx(x) >= xMin - 1e-9 && tx(x) <= xMax + 1e-9)
    : niceTicks(rawXMin, rawXMax, v.xTicks - 1);
  // Labels that would overlap one already placed are left out (the point
  // keeps its tooltip): "Iceland" printed over "Denmark" helped no one.
  // Width is estimated from the character count; each label may sit right
  // or left of its point.
  const boxes: { x0: number; x1: number; y0: number; y1: number }[] = [];
  const hit = (b: { x0: number; x1: number; y0: number; y1: number }) => boxes.some((o) => b.x0 < o.x1 && b.x1 > o.x0 && b.y0 < o.y1 && b.y1 > o.y0);
  const labels: { x: number; y: number; anchor: 'start' | 'end'; text: string; highlight?: boolean }[] = [];
  for (const p of wanted) {
    const px = X(p.x), py = Y(p.y), w = p.label.length * v.fs * 0.58;
    const sides: ('start' | 'end')[] = px > W * 0.74 ? ['end', 'start'] : ['start', 'end'];
    for (const side of sides) {
      const x0 = side === 'start' ? px + 8 : px - 8 - w;
      const b = { x0, x1: x0 + w, y0: py + 3 - v.fs, y1: py + 5 };
      if (b.x0 < m.l || b.x1 > W - 2 || hit(b)) continue;
      boxes.push(b);
      labels.push({ x: side === 'start' ? px + 8 : px - 8, y: py + 3, anchor: side, text: p.label, highlight: p.highlight });
      break;
    }
  }
  return { ...v, iw, ih, X, Y, yvals, xvals, labels };
};
const drawings = VARIANTS.map(build);
---
<div class="chart-svg sc-wrap">
  {drawings.map((d) => (
    <svg class={d.cls} viewBox={`0 0 ${d.W} ${d.H}`} role="img" aria-label={`${yLabel} vs ${xLabel}`} data-xl={xLabel} data-yl={yLabel}>
      {d.yvals.map((v) => (
        <g>
          <line x1={d.m.l} y1={d.Y(v)} x2={d.W - d.m.r} y2={d.Y(v)} stroke="var(--border)" stroke-width="1" />
          <text x={d.m.l - 6} y={d.Y(v) + 4} text-anchor="end" class="axis">{fmtY(v)}</text>
        </g>
      ))}
      {d.xvals.map((v) => (
        <text x={d.X(v)} y={d.H - d.m.b + 18} text-anchor="middle" class="axis">{fmtX(v)}</text>
      ))}
      <text x={d.m.l + d.iw / 2} y={d.H - 6} text-anchor="middle" class="axis-title">{xLabel}</text>
      <text x={12} y={d.m.t + d.ih / 2} text-anchor="middle" class="axis-title" transform={`rotate(-90 12 ${d.m.t + d.ih / 2})`}>{yLabel}</text>

      {points.map((p) => (
        <circle class="sc-pt" cx={d.X(p.x)} cy={d.Y(p.y)} r={p.highlight ? d.pr + 2 : d.pr}
          fill={colorFor(p.group)} fill-opacity={p.highlight ? 1 : 0.78}
          stroke={p.highlight ? 'var(--text)' : 'none'} stroke-width="1.5"
          data-l={p.label} data-x={fmtVal(p.x)} data-y={fmtVal(p.y)} />
      ))}
      {d.labels.map((l) => (
        <text x={l.x} y={l.y} text-anchor={l.anchor} class="pt-label" fill={l.highlight ? 'var(--text)' : 'var(--text-dim)'}>{l.text}</text>
      ))}
    </svg>
  ))}
  <div class="sc-tip" hidden></div>
</div>

<script>
  // Tooltip on hover, and on tap (phones have no hover); a tap elsewhere
  // closes it.
  for (const wrap of document.querySelectorAll<HTMLElement>('.sc-wrap')) {
    const tip = wrap.querySelector<HTMLElement>('.sc-tip')!;
    const place = (el: SVGCircleElement) => {
      const svg = el.ownerSVGElement!;
      const xl = svg.dataset.xl ?? '', yl = svg.dataset.yl ?? '';
      tip.innerHTML = `<b>${el.dataset.l}</b><span>${xl}: ${el.dataset.x}</span><span>${yl}: ${el.dataset.y}</span>`;
      tip.hidden = false;
      const r = svg.getBoundingClientRect(), w = wrap.getBoundingClientRect(), vb = svg.viewBox.baseVal;
      const sx = r.width / vb.width, sy = r.height / vb.height;
      const px = +el.getAttribute('cx')! * sx + (r.left - w.left), py = +el.getAttribute('cy')! * sy + (r.top - w.top);
      tip.style.left = Math.max(2, Math.min(px + 12, w.width - tip.offsetWidth - 6)) + 'px';
      tip.style.top = Math.max(py - tip.offsetHeight - 8, 2) + 'px';
    };
    for (const el of wrap.querySelectorAll<SVGCircleElement>('.sc-pt')) {
      el.addEventListener('mouseenter', () => place(el));
      el.addEventListener('mouseleave', () => { tip.hidden = true; });
      el.addEventListener('click', (e) => { e.stopPropagation(); place(el); });
    }
    document.addEventListener('click', () => { tip.hidden = true; });
  }
</script>

<style>
  .sc-wrap { position: relative; }
  .sc-pt { cursor: pointer; transition: fill-opacity 0.12s ease; }
  .sc-pt:hover { fill-opacity: 1; stroke: var(--text); stroke-width: 1.5; }
  .sc-tip {
    position: absolute; z-index: 6; pointer-events: none; display: flex; flex-direction: column; gap: 1px;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 6px 9px;
    font-size: 12px; color: var(--text); white-space: nowrap; box-shadow: 0 6px 20px rgba(0,0,0,0.25);
  }
  /* display: flex above would otherwise override the hidden attribute and
     leave an empty box under every chart. */
  .sc-tip[hidden] { display: none; }
  .sc-tip b { font-size: 12.5px; }
  .sc-tip span { font-size: 11px; color: var(--text-dim); }
</style>
