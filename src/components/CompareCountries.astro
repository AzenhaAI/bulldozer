---
import { TOPICS, TOPIC_ORDER } from '@lib/topics';
import isoAlpha2 from '@data/iso-alpha2.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topicMeta = TOPIC_ORDER.map((id) => ({ id, label: TOPICS[id].label, icon: TOPICS[id].icon }));
---
<div class="compare" data-base={base}>
  <div class="controls">
    <label>Add country (up to 5)<select id="cmp-add"><option value="">＋ add…</option></select></label>
    <span id="cmp-chips" class="chips"></span>
    <button type="button" id="cmp-csv" class="ghost-btn" style="margin-left:auto">↓ CSV</button>
  </div>
  <p id="cmp-msg" class="cmp-msg" role="status" aria-live="polite" hidden></p>
  <p id="cmp-hint" class="cmp-hint" hidden>Swipe sideways for more countries →</p>
  <div class="cmp-wrap" id="cmp-wrap"><div id="cmp-table" class="cmp-scroll"></div></div>
  <p class="sub" style="font-size:12px; margin-top:8px">
    Each cell is the latest year for that country (shown under the value). Highlighted: the better value, only where
    one direction is plainly better (higher life expectancy, lower child mortality); opinions, spending and other
    neutral series are left unmarked.
  </p>
</div>

<script type="application/json" id="cmp-topics" set:html={JSON.stringify(topicMeta)}></script>
<script type="application/json" id="cmp-a2" set:html={JSON.stringify(isoAlpha2)}></script>
<script>
  import { formatValue } from '@lib/analytics';
  const root = document.querySelector('.compare') as HTMLElement;
  const base = root.dataset.base || '';
  const TOPICS = JSON.parse(document.getElementById('cmp-topics')!.textContent || '[]');
  const isoAlpha2 = JSON.parse(document.getElementById('cmp-a2')!.textContent || '{}');
  const flag = (iso: string) => { const a2 = iso && isoAlpha2[iso.toUpperCase()]; return a2 ? String.fromCodePoint(...[...a2].map((c: string) => 0x1f1e6 + c.charCodeAt(0) - 65)) + ' ' : ''; };
  const add = document.getElementById('cmp-add') as HTMLSelectElement;
  const chipsEl = document.getElementById('cmp-chips')!;
  const tableEl = document.getElementById('cmp-table')!;
  let countries: any[] = [], byIso: Record<string, any> = {};
  // Unit as a short suffix after the value ("%"), and as the row's own label.
  const suffix = (unit: string) => (unit && unit.includes('%') ? '%' : '');

  const params = new URLSearchParams(location.search);
  let selected = (params.get('cmp') || 'USA,CHN,DEU').split(',').filter(Boolean);

  function syncUrl() {
    const p = new URLSearchParams(location.search);
    p.set('cmp', selected.join(','));
    history.replaceState(null, '', location.pathname + '?' + p.toString() + location.hash);
  }

  function renderChips() {
    chipsEl.innerHTML = selected.map((iso) =>
      `<span class="chip">${flag(iso)}${(byIso[iso] || {}).name || iso}<button type="button" data-rm="${iso}" aria-label="Remove ${(byIso[iso] || {}).name || iso}">×</button></span>`).join('');
    add.innerHTML = '<option value="">＋ add country…</option>' +
      countries.filter((c) => !selected.includes(c.iso))
        .map((c) => `<option value="${c.iso}">${flag(c.iso)}${c.name}</option>`).join('');
  }

  // Indicator rows, grouped by topic, each with one cell per country.
  function tableRows() {
    const cols = selected.map((iso) => byIso[iso]).filter(Boolean);
    const ind = new Map<string, any>();
    for (const c of cols) for (const it of c.items) if (!ind.has(it.slug)) ind.set(it.slug, it);
    const out: { topic: any; rows: { r: any; cells: ({ value: number; period: string } | null)[] }[] }[] = [];
    for (const t of TOPICS) {
      const rows = [...ind.values()].filter((i) => i.topic === t.id).sort((a, b) => a.title.localeCompare(b.title));
      if (!rows.length) continue;
      out.push({ topic: t, rows: rows.map((r) => ({ r, cells: cols.map((c) => { const it = c.items.find((x: any) => x.slug === r.slug); return it ? { value: it.value, period: String(it.period) } : null; }) })) });
    }
    return { cols, out };
  }

  function renderTable() {
    const { cols, out } = tableRows();
    if (!cols.length) { tableEl.innerHTML = '<p class="sub">Add a country to compare.</p>'; return; }
    let html = `<table class="data"><thead><tr><th class="cmp-ind">Indicator</th><th class="cmp-unit">Unit</th>${cols.map((c) => `<th class="num">${flag(c.iso)}${c.name}</th>`).join('')}</tr></thead><tbody>`;
    for (const { topic: t, rows } of out) {
      html += `<tr class="cmp-topic"><td colspan="${cols.length + 2}" style="padding-top:16px;color:var(--text-dim);font-size:12px;text-transform:uppercase;letter-spacing:1px"><span class="cmp-topic-lbl">${t.icon} ${t.label}</span></td></tr>`;
      for (const { r, cells } of rows) {
        // The better value, by the indicator's polarity; none when neutral or
        // when fewer than two countries have a value.
        const vals = cells.filter(Boolean).map((c) => c!.value);
        const best = r.better && vals.length > 1 ? (r.better === 'low' ? Math.min(...vals) : Math.max(...vals)) : null;
        const sfx = suffix(r.unit);
        // The unit also rides under the name: on phones the Unit column is
        // hidden to leave room for the countries.
        html += `<tr><td class="cmp-ind"><a href="${base}/dataset/${r.slug}/">${r.title}</a>${r.unit ? `<small class="cmp-u">${r.unit}</small>` : ''}</td><td class="cmp-unit" style="color:var(--text-dim);font-size:12px">${r.unit || ''}</td>` +
          cells.map((c) => c == null ? '<td class="num" style="color:var(--text-dim)">—</td>'
            : `<td class="num"${best != null && c.value === best ? ` style="color:var(--accent);font-weight:600" title="${r.better === 'low' ? 'Lowest, and lower is better' : 'Highest, and higher is better'}"` : ''}>${formatValue(c.value, r.unit)}${sfx}<br><small style="color:var(--text-dim);font-weight:400">${c.period}</small></td>`).join('') + '</tr>';
      }
    }
    tableEl.innerHTML = html + '</tbody></table>';
    // Re-measured whenever the table's size settles (fonts, styles, rotation).
    const t = tableEl.querySelector('table');
    if (t && 'ResizeObserver' in window) { ro ??= new ResizeObserver(edges); ro.disconnect(); ro.observe(t); ro.observe(tableEl); }
    edges();
  }
  let ro: ResizeObserver | undefined;

  // Sideways scroll on phones: the indicator column stays put (sticky), a fade
  // marks the edge where more columns are hidden, and a line says so. The
  // table used to slide off to the right with nothing to tell that it could.
  const wrapEl = document.getElementById('cmp-wrap')!;
  const hintEl = document.getElementById('cmp-hint')!;
  function edges() {
    const more = tableEl.scrollWidth - tableEl.clientWidth > 2;
    const atEnd = tableEl.scrollLeft + tableEl.clientWidth >= tableEl.scrollWidth - 2;
    wrapEl.classList.toggle('fade-r', more && !atEnd);
    hintEl.hidden = !more;
  }
  tableEl.addEventListener('scroll', edges, { passive: true });
  window.addEventListener('resize', edges);

  // The table as CSV: one row per indicator × country, with year and unit.
  function downloadCsv() {
    const { cols, out } = tableRows();
    if (!cols.length) return;
    const q = (v: unknown) => { const s = v == null ? '' : String(v); return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s; };
    const lines = ['topic,indicator,unit,country,iso3,period,value,better,dataset_url'];
    for (const { topic: t, rows } of out) for (const { r, cells } of rows) cells.forEach((c, i) => {
      if (!c) return;
      lines.push([t.label, r.title, r.unit, cols[i].name, cols[i].iso, c.period, c.value, r.better || '', `https://azenha.ai${base}/dataset/${r.slug}/`].map(q).join(','));
    });
    const blob = new Blob(['\ufeff' + lines.join('\r\n') + '\r\n'], { type: 'text/csv;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `bulldozer_compare_${cols.map((c) => c.iso).join('-')}.csv`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
  }

  function render() { renderChips(); renderTable(); syncUrl(); }

  // A sixth pick was dropped silently while the select kept showing it: say
  // why, and put the select back on its placeholder.
  const MAX = 5;
  const msgEl = document.getElementById('cmp-msg')!;
  const say = (t: string) => { msgEl.textContent = t; msgEl.hidden = !t; };
  add.addEventListener('change', () => {
    const iso = add.value;
    if (!iso) return;
    if (selected.length >= MAX) { add.value = ''; say(`Up to ${MAX} countries side by side; remove one (×) to add ${(byIso[iso] || {}).name || iso}.`); return; }
    if (!selected.includes(iso)) selected.push(iso);
    say(''); render();
  });
  chipsEl.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('[data-rm]'); const iso = b && b.getAttribute('data-rm'); if (iso) { selected = selected.filter((x) => x !== iso); say(''); render(); } });
  document.getElementById('cmp-csv')!.addEventListener('click', downloadCsv);

  (window.__bdCountryIndex ??= (async (u) => { for (let i = 0; i < 4; i++) { try { const r = await fetch(u); if (r.ok) return await r.json(); } catch { /* retry */ } await new Promise((res) => setTimeout(res, 700 * (i + 1))); } window.__bdCountryIndex = undefined; throw new Error('country index unavailable'); })(`${base}/data/country-index.json`)).then((data) => {
    countries = data; byIso = Object.fromEntries(data.map((c: any) => [c.iso, c]));
    selected = [...new Set(selected.filter((iso) => byIso[iso]))].slice(0, MAX); // a hand-edited ?cmp= can list more
    if (!selected.length) selected = data.slice(0, 3).map((c: any) => c.iso);
    render();
  });
</script>

<style is:global>
  /* The chip "×" was a 13x15 target; 32px square keeps it tappable. */
  .compare .chip { padding-top: 0; padding-bottom: 0; padding-right: 2px; }
  .compare .chip button { min-width: 32px; min-height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; }
  .compare .cmp-msg { margin: 8px 0 0; font-size: 13px; color: var(--accent); }
  .compare .cmp-wrap { position: relative; margin-top: 8px; }
  .compare .cmp-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  /* The wrapper scrolls, not the table: phones make every table.data its own
     scroller (global.css), which the edge fade and hint could not watch. */
  .compare .cmp-scroll table.data { display: table; overflow: visible; }
  /* The indicator column stays in view while the countries scroll under it;
     an opaque background so the values do not show through. */
  .compare .cmp-ind { position: sticky; left: 0; z-index: 2; background: var(--bg); }
  .compare .cmp-topic td { background: transparent; }
  .compare .cmp-topic-lbl { position: sticky; left: 10px; }
  .compare .cmp-u { display: none; color: var(--text-dim); font-size: 11px; font-weight: 400; margin-top: 2px; }
  /* A fade on the right edge while more columns are hidden behind it (none
     on the left: the sticky indicator column sits there). */
  .compare .cmp-wrap::after { content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 28px; pointer-events: none; opacity: 0; transition: opacity .15s; z-index: 3; background: linear-gradient(90deg, transparent, var(--bg)); }
  .compare .cmp-wrap.fade-r::after { opacity: 1; }
  .compare .cmp-hint { margin: 8px 0 0; font-size: 12px; color: var(--text-dim); }
  .compare .cmp-hint[hidden] { display: none; }
  @media (max-width: 560px) {
    .compare .cmp-unit { display: none; }
    .compare .cmp-u { display: block; }
    .compare .cmp-ind { min-width: 128px; max-width: 150px; box-shadow: 1px 0 0 var(--border); }
  }
</style>
