---
// Every issue of the weekly AI review, newest first. The issues are built in
// AzenhaAI/azenha by the brief bot and served from azenha.ai/ai-weekly/, so this
// page only reads them: index.json and one JSON per issue when the archive is
// published, otherwise just latest.json.
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="AI this week" active="ask" description="A weekly review of AI: the week's news, what to try hands-on, and the theory and papers worth reading slowly.">
  <section class="container aiw-page">
    <a class="aiw-back" href={`${base}/ask/`}>← Ask AI</a>
    <h1>🤖 AI this week</h1>
    <p class="aiw-lead">Every Sunday: the week's AI news, what to try hands-on, and the theory and papers worth reading slowly — interpretability, world models, alignment.</p>
    <div id="aiw-issues"></div>
    <p id="aiw-none" class="aiw-none" hidden>No issues yet — the first arrives on Sunday.</p>
  </section>
</BaseLayout>

<script>
  const list = document.getElementById('aiw-issues')!;
  const SECTIONS = [['news', 'News'], ['practice', '🛠 Hands-on'], ['theory', 'Theory & papers']];

  function render(issue: any, into: HTMLElement) {
    for (const [key, title] of SECTIONS) {
      const items = (issue.sections && issue.sections[key]) || [];
      if (!items.length) continue;
      const h = document.createElement('h3');
      h.textContent = title;
      const ul = document.createElement('ul');
      for (const it of items) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = it.url; a.rel = 'noopener'; a.target = '_blank';
        a.textContent = it.en || it.title;
        const src = document.createElement('span');
        src.className = 'aiw-src';
        src.textContent = ` — ${it.outlet}`;
        li.append(a, src);
        ul.append(li);
      }
      into.append(h, ul);
    }
  }

  (async () => {
    let ids: string[] = [];
    try {
      const res = await fetch('/ai-weekly/index.json');
      if (res.ok) ids = (await res.json()).issues || [];
    } catch { /* no archive yet */ }
    // No archive published yet: show the latest issue on its own.
    if (!ids.length) {
      try {
        const res = await fetch('/ai-weekly/latest.json');
        if (!res.ok) throw new Error(String(res.status));
        const issue = await res.json();
        const h = document.createElement('h2');
        h.className = 'aiw-week';
        h.textContent = issue.week || issue.date || '';
        list.append(h);
        render(issue, list);
        if (list.querySelector('li')) return;
        list.textContent = '';
      } catch { /* falls through to "no issues yet" */ }
      document.getElementById('aiw-none')!.hidden = false;
      return;
    }
    ids.forEach((id, i) => {
      const d = document.createElement('details');
      const s = document.createElement('summary');
      s.textContent = id;
      const body = document.createElement('div');
      d.append(s, body);
      list.append(d);
      let loaded = false;
      const load = async () => {
        if (loaded) return;
        loaded = true;
        try {
          const res = await fetch(`/ai-weekly/${encodeURIComponent(id)}.json`);
          if (!res.ok) throw new Error(String(res.status));
          render(await res.json(), body);
        } catch {
          loaded = false;
          body.textContent = 'Could not load this issue.';
        }
      };
      d.addEventListener('toggle', () => { if (d.open) load(); });
      if (i === 0) d.open = true;
    });
  })();
</script>

<style>
  .aiw-page { padding-top: 28px; padding-bottom: 40px; max-width: 720px; }
  .aiw-back { font-size: 14px; font-weight: 600; }
  .aiw-page h1 { margin: 10px 0 8px; font-size: clamp(28px, 5vw, 40px); }
  .aiw-lead { color: var(--text-dim); font-size: 15px; line-height: 1.5; margin: 0 0 18px; }
  .aiw-page details { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 12px 16px; margin-bottom: 10px; }
  .aiw-page summary { cursor: pointer; font-weight: 700; }
  .aiw-page h3 { font-size: 13px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--accent); margin: 14px 0 6px; }
  .aiw-page ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; }
  .aiw-page li { font-size: 15px; line-height: 1.45; }
  .aiw-src { color: var(--text-dim); font-size: 13px; }
  .aiw-none { color: var(--text-dim); font-style: italic; }
  .aiw-none[hidden] { display: none; }
  .aiw-week { font-size: 18px; margin: 6px 0 0; }
</style>
