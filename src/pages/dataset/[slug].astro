---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Provenance from '@components/Provenance.astro';
import StatsNote from '@components/StatsNote.astro';
import KpiRow from '@components/KpiRow.astro';
import DataPanel from '@components/DataPanel.astro';
import MoversTable from '@components/MoversTable.astro';
import RankTable from '@components/RankTable.astro';
import GroupChart from '@components/GroupChart.astro';
import TrendChart from '@components/TrendChart.astro';
import { hasRegionalPanel } from '@lib/trend';
import BivariateMap from '@components/BivariateMap.astro';
import ChartActions from '@components/ChartActions.astro';
import { datasets, getDataset } from '@data/datasets';

// Curated bivariate pairings — a "good" second dimension per indicator.
const PAIRINGS: Record<string, { y: string; title: string }> = {
  'whr-happiness': { y: 'imf-gdp-per-capita-ppp', title: 'Happiness × wealth — colour shows both at once' },
  'wb-life-expectancy': { y: 'imf-gdp-per-capita-ppp', title: 'Longevity × wealth' },
  'gapminder-life-expectancy': { y: 'imf-gdp-per-capita-ppp', title: 'Longevity × wealth' },
  'gapminder-internet': { y: 'imf-gdp-per-capita-ppp', title: 'Internet access × wealth' },
  'v-dem-v2x-libdem': { y: 'qog-ti-cpi', title: 'Liberal democracy × clean government' },
  'qog-ti-cpi': { y: 'v-dem-v2x-libdem', title: 'Clean government × liberal democracy' },
  'imf-gdp-growth': { y: 'imf-inflation', title: 'Growth × inflation' },
  'imf-inflation': { y: 'imf-gdp-growth', title: 'Inflation × growth' },
};
import { groupRollups, isSinglePeriod, isAdditive, changeSpec, formatDelta, formatValue, toneOf } from '@lib/analytics';
import { TOPICS } from '@lib/topics';

export function getStaticPaths() {
  return datasets.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const ds = getDataset(slug!)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Detailed pre-built frequency / by-country dashboards (static HTML in /public).
const DASH: Record<string, string> = {
  'wvs-': 'wvs', 'afro-': 'afrobarometer', 'wgm-': 'wellcome', 'wrp-': 'wrp',
  'sdr2-': 'sdr2', 'v-dem-': 'vdem', 'whr-': 'whr', 'gapminder-': 'gapminder',
  'dhs-': 'dhs', 'lb-': 'latinobarometro',
  'eb-': 'eurobarometer', 'issp-': 'issp', 'evs-': 'evs', 'ab-': 'arabbarometer', 'rlms-': 'rlms',
};
const dashFile = Object.entries(DASH).find(([p]) => ds.slug.startsWith(p))?.[1];
// Company datasets (SEC user metrics): entities are companies, so no map, no
// country wording, and no group table (each company is its own group).
const company = ds.entityType === 'company';
const noun = company ? 'company' : 'country';
const additive = isAdditive(ds.unit);
// Series measured in different years per country (household surveys): the
// summary, group table and full ranking use each country's latest reading,
// labelled "Latest". Where every country has just one reading, there is no
// trend and nothing moved, so those sections are left out.
// "Latest" is each country's newest reading of the last ten years, the window
// the country profiles and the panel use; `year` keeps the reading's own year
// for the ranking's Year column.
const lpcEnd = Math.max(...ds.data.map((o) => Number(String(o.period).slice(0, 4))).filter(Number.isFinite));
const latestData: (typeof ds.data[number] & { year?: string })[] = ds.latestPerCountry
  ? [...ds.data.filter((o) => !(Number(String(o.period).slice(0, 4)) < lpcEnd - 10))
      .reduce((m, o) => (!m.has(o.iso ?? o.entity) || String(o.period) > String(m.get(o.iso ?? o.entity)!.period) ? m.set(o.iso ?? o.entity, o) : m), new Map<string, typeof ds.data[number]>()).values()]
      .map((o) => ({ ...o, period: 'Latest', year: String(o.period) }))
  : ds.data;
const oneEach = !!ds.latestPerCountry && new Set(ds.data.map((o) => o.iso ?? o.entity)).size === ds.data.length;
const single = isSinglePeriod(latestData) || oneEach;
const periodCount = oneEach ? 1 : new Set(ds.data.map((o) => o.period)).size;
const pairing = PAIRINGS[ds.slug];
const related = datasets.filter((d) => d.topic === ds.topic && d.slug !== ds.slug).slice(0, 6);
// prev/next within the same section + topic, alphabetical — matches list order
const siblings = datasets.filter((d) => d.kind === ds.kind && d.topic === ds.topic).sort((a, b) => a.title.localeCompare(b.title));
const sidx = siblings.findIndex((d) => d.slug === ds.slug);
const prevDs = sidx > 0 ? siblings[sidx - 1] : null;
const nextDs = sidx < siblings.length - 1 ? siblings[sidx + 1] : null;
const pctUnit = ds.unit === '%' ? '%' : '';
// Suffix printed after values in the tables: any percent unit ("% YoY",
// "% of GDP") keeps its "%", as the panel and the KPI cards do; the ranking
// printed inflation as a bare "22.3" next to the panel's "22.3%".
const valSuffix = ds.unit.includes('%') ? '%' : '';
// Category scale (Freedom House status): counts per category stand in for
// the median and change cards, which would average category codes.
const cats = ds.categories;
const catKpis = cats ? (() => {
  const ps = [...new Set(ds.data.map((o) => o.period))].sort();
  const cur = ps.at(-1)!, prev = ps.length > 1 ? ps.at(-2)! : null;
  const now = ds.data.filter((o) => o.period === cur);
  const before = new Map(prev ? ds.data.filter((o) => o.period === prev).map((o) => [o.entity, o.value]) : []);
  const moved = now.filter((o) => before.has(o.entity) && before.get(o.entity) !== o.value).length;
  return { cur, prev, moved, counts: Object.entries(cats).map(([code, name]) => ({ name, n: now.filter((o) => String(o.value) === code).length })), total: now.length };
})() : null;
// One unit of change and one stable band for every view on the page (the band
// is sized on the whole series, as the interactive panel does).
const spec = changeSpec(ds.data, ds.unit, ds.changeMode, ds.better);
const panelIndicator = [{
  slug: ds.slug, title: ds.title, kind: ds.kind, unit: ds.unit, valueLabel: ds.valueLabel,
  changeMode: ds.changeMode, periods: [...new Set(ds.data.map((o) => o.period))].sort(),
  latestPerCountry: !!ds.latestPerCountry,
  projectedFrom: ds.projectedFrom ?? null,
}];
const backHref = ds.kind === 'survey' ? `${base}/surveys/` : `${base}/macro/`;
const active = ds.kind === 'survey' ? 'surveys' : 'macro';
const dsPeriods = [...new Set(ds.data.map((o) => o.period))].sort();
// SEO title targets the high-intent "<indicator> by country" query pattern that
// actually ranks for us (worldpopulationreview model), suffixed with the latest
// data year. The on-page H1 keeps the short, clean indicator name.
// The last observed year names the page and heads the KPIs: IMF series end in
// a projection, and "— 2026" over a chart that opens on 2025 contradicted it.
const pfYear = ds.projectedFrom ? Number(String(ds.projectedFrom).slice(0, 4)) : null;
const isProjected = (p: unknown) => pfYear != null && Number(String(p).slice(0, 4)) >= pfYear;
const observedPeriods = dsPeriods.filter((p) => !isProjected(p));
const lastYear = (observedPeriods.length ? observedPeriods : dsPeriods).at(-1);
const kpiData = pfYear != null ? latestData.filter((o) => !isProjected(o.period)) : latestData;
// Groups on observed years too: "latest period" was the IMF's projection.
const groups = groupRollups(kpiData.length ? kpiData : latestData, ds.changeMode, additive);
// Only advertise the year when the data is recent — a fresh "— 2025" lifts CTR,
// but a stale "— 2013" signals outdated data and hurts it, so drop it there.
const endYear = Number(String(lastYear ?? '').match(/(\d{4})(?!.*\d{4})/)?.[1]);
const seoTitle = `${ds.title} by ${company ? 'Company' : 'Country'}${endYear >= 2022 ? ` — ${lastYear}` : ''}`;
// schema.org/Dataset — indexed by Google Dataset Search. Google ranks partly on
// metadata completeness, so every recommended field it understands is filled in.
const dsUrl = `https://azenha.ai${base}/dataset/${ds.slug}/`;
const countryCount = new Set(ds.data.map((o) => o.entity)).size;
// Served by a Pages Function built from the JSON (azenha functions/bulldozer/data/[file].js): no file per dataset, under the 20,000-file upload limit.
const csvHref = `${base}/data/${ds.slug}.csv`;
const periodRange = dsPeriods.length > 1 ? `${dsPeriods[0]}–${dsPeriods.at(-1)}` : String(dsPeriods[0] ?? '');
// "Cite this": the access date is the build date; the button below swaps in
// the reader's own date when copying.
const accessed = new Date().toISOString().slice(0, 10);
// The edition/vintage clause only, not the whole methodological note.
const vintageShort = ds.vintage ? ds.vintage.split(/;|\. /)[0].trim() : '';
const citeEdition = vintageShort && vintageShort.length <= 70 ? `, ${vintageShort}` : '';
const citation = `BullDozer Stats (Azenha AI), ${ds.title}, from ${ds.source}${citeEdition}, accessed ${accessed}, ${dsUrl}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: seoTitle,
  description: ds.summary,
  url: dsUrl,
  identifier: dsUrl,
  license: { '@type': 'CreativeWork', name: ds.license },
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: ds.source, url: ds.url },
  publisher: { '@type': 'Organization', name: 'BullDozer', url: `https://azenha.ai${base}/` },
  includedInDataCatalog: { '@type': 'DataCatalog', name: 'BullDozer', url: `https://azenha.ai${base}/` },
  keywords: company
    ? [ds.title, `${ds.title} by company`, 'company user metrics', 'SEC filings', 'company comparison']
    : [ds.title, `${ds.title} by country`, TOPICS[ds.topic]?.label ?? ds.topic, ds.kind === 'survey' ? 'survey data' : 'macro indicator', 'country comparison'],
  ...(company ? {} : { spatialCoverage: { '@type': 'Place', name: countryCount > 50 ? 'World' : `${countryCount} countries` } }),
  dateModified: ds.parsedAt,
  citation: `${ds.source}. ${ds.url}`,
  ...(ds.method ? { measurementTechnique: ds.method } : {}),
  temporalCoverage: dsPeriods.length > 1 ? `${dsPeriods[0]}/${dsPeriods.at(-1)}` : dsPeriods[0],
  variableMeasured: ds.valueLabel,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `https://azenha.ai${csvHref}` },
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `https://azenha.ai${base}/data/${ds.slug}.json` },
  ],
};
// Breadcrumbs are rendered visually below; this lets Google show them in the SERP
// in place of the raw URL.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'BullDozer', item: `https://azenha.ai${base}/` },
    { '@type': 'ListItem', position: 2, name: ds.kind === 'survey' ? 'Polls' : 'Macro', item: `https://azenha.ai${backHref}/` },
    { '@type': 'ListItem', position: 3, name: ds.title, item: dsUrl },
  ],
};
---
<BaseLayout title={seoTitle} description={ds.summary} active={active} ogPath={`/og/${ds.slug}.png`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <section class="section">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={backHref}>{ds.kind === 'survey' ? 'Polls' : 'Macro'}</a>
        <span aria-hidden="true">›</span>
        <a href={backHref}>{TOPICS[ds.topic]?.icon} {TOPICS[ds.topic]?.label ?? ds.topic}</a>
        <span aria-hidden="true">›</span>
        <span class="crumb-here">{ds.title}</span>
      </nav>
      <h1><span class="ind-ic" aria-hidden="true">{TOPICS[ds.topic]?.icon}</span>{ds.title}</h1>
      <p class="sub">{ds.summary}</p>
      <Provenance meta={ds} />
      {(ds.vintage || ds.method) && (
        <p class="method-note">
          {ds.vintage && <span><b>Period:</b> {ds.vintage}. </span>}
          {ds.method && <span><b>Method:</b> {ds.method}</span>}
        </p>
      )}
      {ds.notes && <StatsNote note={ds.notes} />}
      <p style="margin-top:12px; display:flex; gap:10px; flex-wrap:wrap">
        <a class="ghost-btn" style="margin:0; display:inline-block; text-decoration:none" href={csvHref} download={`${ds.slug}.csv`}>↓ Download CSV</a>
        {dashFile && (
          <>
            <a class="ghost-btn" style="margin:0; display:inline-block; text-decoration:none" href={`${base}/dashboards/${dashFile}`} target="_blank" rel="noopener">📊 Detailed results dashboard ↗</a>
            <a class="ghost-btn" style="margin:0; display:inline-block; text-decoration:none" href={`${base}/dashboards/${dashFile}`} download={`${dashFile}-dashboard.html`}>⤓ Download dashboard</a>
          </>
        )}
      </p>
      <div class="cite-box" id="cite">
        <b>Cite this</b>
        <code id="cite-text" data-pre={`BullDozer Stats (Azenha AI), ${ds.title}, from ${ds.source}${citeEdition}, accessed `} data-post={`, ${dsUrl}`}>{citation}</code>
        <button type="button" class="ghost-btn" id="cite-copy" style="margin:0">Copy citation</button>
      </div>
      <script>
        // Today's date, not the build date, when the reader copies it.
        const c = document.getElementById('cite-text');
        const b = document.getElementById('cite-copy');
        if (c && b) {
          c.textContent = (c.dataset.pre || '') + new Date().toISOString().slice(0, 10) + (c.dataset.post || '');
          b.addEventListener('click', async () => {
            const t = c.textContent || '';
            try { await navigator.clipboard.writeText(t); b.textContent = '✓ Copied'; }
            catch (e) { window.prompt('Copy citation:', t); }
            setTimeout(() => { b.textContent = 'Copy citation'; }, 1400);
          });
        }
      </script>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      {catKpis ? (
        <div class="kpi-row">
          {catKpis.counts.map((c) => (
            <div class="kpi">
              <div class="label">{c.name} ({catKpis.cur})</div>
              <div class="value">{c.n}</div>
              <div class="delta flat">of {catKpis.total} countries</div>
            </div>
          ))}
          {catKpis.prev && (
            <div class="kpi">
              <div class="label">Changed status</div>
              <div class="value">{catKpis.moved}</div>
              <div class="delta flat">since {catKpis.prev}</div>
            </div>
          )}
        </div>
      ) : (
        <KpiRow data={kpiData.length ? kpiData : latestData} unit={pctUnit} fullUnit={ds.unit} mode={ds.changeMode} noun={noun} better={ds.better} bandData={ds.data} projectedFrom={ds.projectedFrom} />
      )}
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <h2>{ds.valueLabel}</h2>
      <p class="sub">{company
        ? 'Interactive — choose a quarter, search a company, switch between bars and table.'
        : 'Interactive — choose a period, search a country, switch between bars, table and map.'}</p>
      <DataPanel indicators={panelIndicator} pinnedSlug={ds.slug} noun={noun} />
      {/* The panel exports the view on screen (bars, map or bubbles) with its legend. */}
      <ChartActions name={`bulldozer-${ds.slug}`} svg=".datapanel" hash="data" title={ds.title} source={ds.source} period={periodRange} url={dsUrl} />
    </div>
  </section>

  {periodCount > 2 && !ds.latestPerCountry && hasRegionalPanel(ds.data) && (
    <section class="section" style="padding-top:0" id="trend">
      <div class="container">
        <h2>Trend over time</h2>
        <p class="sub">{company ? 'Each company by quarter' : 'Regional medians'}, {String([...new Set(ds.data.map((o) => o.period))].sort()[0]).slice(0, 4)}–{String([...new Set(ds.data.map((o) => o.period))].sort().at(-1)).slice(-4)}.</p>
        <TrendChart data={ds.data} unit={pctUnit} fullUnit={ds.unit} mode={ds.changeMode === 'pct' ? 'pct' : 'pp'} projectedFrom={ds.projectedFrom} />
        <ChartActions name={`bulldozer-${ds.slug}-trend`} svg="#trend svg" hash="trend" title={`${ds.title} — trend by region`} source={ds.source} period={periodRange} url={dsUrl} />
      </div>
    </section>
  )}

  {pairing && (
    <section class="section" style="padding-top:0" id="bivariate">
      <div class="container">
        <h2>Two dimensions at once</h2>
        <BivariateMap xSlug={ds.slug} ySlug={pairing.y} title={pairing.title} />
        <ChartActions name={`bulldozer-${ds.slug}-map`} svg="#bivariate svg" hash="bivariate" title={pairing.title} source={ds.source} url={dsUrl} />
      </div>
    </section>
  )}

  {!single && !cats && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <h2>Movers</h2>
        <p class="sub">Biggest period-over-period changes.</p>
        <MoversTable data={ds.data} n={5} unit={valSuffix} fullUnit={ds.unit} mode={ds.changeMode} better={ds.better} />
      </div>
    </section>
  )}

  {groups.length > 0 && !single && !company && !cats && (
    <section class="section" style="padding-top:0" id="groups">
      <div class="container">
        <h2>By group</h2>
        <p class="sub">Change by group, latest period.</p>
        <GroupChart data={kpiData.length ? kpiData : latestData} mode={ds.changeMode} additive={additive} unit={ds.unit} better={ds.better} bandData={ds.data} />
        <div style="height:24px"></div>
        <table class="data">
          <thead><tr><th>Group</th><th class="num">Members</th><th class="num">{additive ? 'Total' : 'Avg'}</th><th class="num">Change</th></tr></thead>
          <tbody>
            {groups.map((g) => (
              <tr>
                <td>{g.group}</td>
                <td class="num">{g.members}</td>
                <td class="num">{formatValue(g.value, ds.unit)}{valSuffix}</td>
                <td class={`num ${toneOf(g.pct, spec)}`}>{formatDelta(g.pct, spec.mode === 'pp' ? { ...spec, band: Math.max(spec.band, 0.01) } : spec)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="section" style="padding-top:0" id="full">
    <div class="container">
      <h2>{ds.title} — full ranking</h2>
      <p class="sub">
        Every entity in this dataset, in HTML. The interactive panel above shows
        the same numbers; this is the one that survives without JavaScript.
      </p>
      <RankTable data={latestData} unit={valSuffix} fullUnit={ds.unit} mode={ds.changeMode} valueLabel={ds.valueLabel} better={ds.better} bandData={ds.data} projectedFrom={ds.projectedFrom} categories={cats} noun={noun} />
    </div>
  </section>

  {related.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <h2>Related indicators</h2>
        <p class="sub">More in {ds.topic}.</p>
        <div class="grid cols-3">
          {related.map((d) => (
            <a class="card link" href={`${base}/dataset/${d.slug}/`}>
              <h3 style="font-size:15px"><span class="ind-ic" aria-hidden="true">{TOPICS[d.topic]?.icon}</span>{d.title}</h3>
              <p class="meta">{d.source}</p>
            </a>
          ))}
        </div>
        {(prevDs || nextDs) && (
          <div class="pager">
            {prevDs ? <a class="ghost-btn" href={`${base}/dataset/${prevDs.slug}/`}>← {prevDs.title}</a> : <span />}
            {nextDs ? <a class="ghost-btn" href={`${base}/dataset/${nextDs.slug}/`}>{nextDs.title} →</a> : <span />}
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>
