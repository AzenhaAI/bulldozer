---
import BaseLayout from '../layouts/BaseLayout.astro';
import { statSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Read off the APK itself, so the figure cannot drift away from the download.
const apkMB = Math.round(statSync(fileURLToPath(new URL('../../public/downloads/bulldozer-stats.apk', import.meta.url))).size / 1048576);
---
<BaseLayout
  title="Apps for Android, iPhone and the web"
  description="BullDozer on your phone: a free Android app, an iOS build on request, or install the site as a web app. Every dataset, offline after the first load."
  active="apps"
>
  <section class="section">
    <div class="container" style="max-width:820px">
      <span class="kicker">Apps</span>
      <h1>The numbers, in your pocket</h1>
      <p class="sub">
        Every dataset on this site, on a phone, cached after the first load so
        charts and country profiles keep working with no connection. Free, no
        account, no ads.
      </p>

      <div class="apps-grid">
        <div class="app-card">
          <h2>Android</h2>
          <p>A direct download. The app is not on Google Play yet, so your phone
          asks you to allow <b>installing from unknown sources</b> the first time.</p>
          <a class="ghost-btn app-cta" href={`${base}/downloads/bulldozer-stats.apk`} download>
            Download APK, {apkMB} MB
          </a>
        </div>

        <div class="app-card">
          <h2>iPhone and iPad</h2>
          <p>On the App Store — free, no ads, no sign-up. Universal: the iPad
          build spreads the charts across the width instead of centring a
          phone column.</p>
          <a class="ghost-btn app-cta" href="https://apps.apple.com/app/id6797664814">
            Get it on the App Store
          </a>
          <p class="app-note">Or keep the site one tap away: in Safari, tap
          <b>Share</b> and then <b>Add to Home Screen</b>.</p>
        </div>

        <div class="app-card">
          <h2>Mac</h2>
          <p>A native window for the site, universal for Apple silicon and Intel.
          It opens the live pages, so it never carries stale numbers.</p>
          <a class="ghost-btn app-cta" href="/dl/BullDozer-mac.dmg" download>Download for macOS</a>
        </div>

        <div class="app-card">
          <h2>Windows</h2>
          <p>An installer that puts the site in its own window. Like the Mac
          build it opens the live pages, so the figures are never a stale copy.</p>
          <a class="ghost-btn app-cta" href="/dl/BullDozer-setup.exe" download>Download the installer</a>
        </div>

        <div class="app-card">
          <h2>Telegram</h2>
          <p>Send a country code and get its figures back. Works inside any chat:
          type the bot's name and a country, and the card lands in the conversation.</p>
          <a class="ghost-btn app-cta" href="https://t.me/bulldozer_ebot">Open the bot</a>
        </div>

        <div class="app-card">
          <h2>Web app</h2>
          <p>The site installs as an app on any desktop or Android browser, with
          its own window and icon, and the same offline cache.</p>
          <button type="button" class="ghost-btn app-cta" id="apps-pwa">Install web app</button>
          <p class="app-note" id="apps-pwa-note" hidden>This browser offers no
          install prompt here. Use its menu: <b>Install</b> or <b>Add to Home Screen</b>.</p>
        </div>
      </div>

      <h2 style="margin-top:34px">What you get</h2>

      <div class="gloss-term"><h3>The whole catalogue, offline</h3>
        <p>Every indicator, country profile and ranking travels with you. What
        the app has already fetched stays put, so a plane or a dead signal is no
        obstacle, and fresh figures arrive when you are back online.</p></div>

      <div class="gloss-term"><h3>Sourced, not scraped</h3>
        <p>Each number names where it came from and which period it covers, from
        the IMF, the World Bank, Gapminder, V-Dem and the World Happiness Report
        among others. The same open files this site is built from.</p></div>

      <div class="gloss-term"><h3>Nothing about you</h3>
        <p>No sign-up, no login, and no record of what you look at. See
        <a href={`${base}/privacy`}>Privacy</a> for the details, or
        <a href={`${base}/support`}>Support</a> if something misbehaves.</p></div>
    </div>
  </section>

  <script is:inline>
    // Browsers only allow the install prompt from a user gesture, and only once
    // they have fired beforeinstallprompt; where they never do, we say so
    // instead of leaving a button that quietly does nothing.
    (() => {
      let deferred = null;
      const btn = document.getElementById('apps-pwa');
      const note = document.getElementById('apps-pwa-note');
      window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferred = e; });
      btn.addEventListener('click', async () => {
        if (!deferred) { note.hidden = false; return; }
        deferred.prompt();
        await deferred.userChoice;
        deferred = null;
      });
    })();
  </script>
</BaseLayout>
