---
import BaseLayout from '../layouts/BaseLayout.astro';
import { statSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Read off the APK itself, so the figure cannot drift away from the download.
const apkMB = Math.round(statSync(fileURLToPath(new URL('../../public/downloads/bulldozer-stats.apk', import.meta.url))).size / 1048576);
const APP_STORE = 'https://apps.apple.com/app/id6797664814';
const PLAY = 'https://play.google.com/store/apps/details?id=ai.azenha.bulldozer';
---
<BaseLayout
  title="Apps for Android, iPhone and the web"
  description="BullDozer Stats on Google Play and the App Store, plus Mac, Windows, Telegram and a web app. Free, no account, no ads, works offline."
  active="apps"
>
  <section class="section">
    <div class="container apps-page">
      <span class="kicker">Apps</span>
      <h1>The numbers, in your pocket</h1>
      <p class="sub">Free. No account, no ads. Works offline.</p>

      <!-- The two stores first: that is what most visitors came for. On
           Android the Play badge moves to the front. -->
      <div class="store-badges" id="store-badges">
        <a class="store-badge" href={APP_STORE}>
          <svg class="ico" fill="#fff" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.7-3.1.7-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4 0 0-2.7-1-2.7-3.4ZM14.3 6.6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2Z"/></svg>
          <span><small>Download on the</small>App Store</span>
        </a>
        <a class="store-badge play" href={PLAY}>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="#00d7fe" d="M4.6 2.6a1 1 0 0 0-.5.9v17a1 1 0 0 0 .5.9l9.1-9.4-9.1-9.4Z"/><path fill="#00f076" d="m14.8 10.9 2.9-3-9.9-5.6 7 8.6Z"/><path fill="#ff3a44" d="m14.8 13.1-7 8.6 9.9-5.6-2.9-3Z"/><path fill="#ffd500" d="m18.9 10.9-2.4-1.4-3 3.5 3 3.5 2.4-1.4c.9-.5.9-1.7 0-2.2Z"/></svg>
          <span><small>GET IT ON</small>Google Play</span>
        </a>
      </div>

      <h2 class="more-h">Also on</h2>
      <div class="more-apps">
        <a class="tile" href="/dl/BullDozer-mac.dmg" download>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.7-3.1.7-.7 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4 0 0-2.7-1-2.7-3.4ZM14.3 6.6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.7-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2Z"/></svg><span class="t"><b>macOS</b><small>Apple silicon &amp; Intel</small></span>
        </a>
        <a class="tile" href="/dl/BullDozer-setup.exe" download>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5.6 10.1 4.6v6.9H3V5.6Zm8.4-1.2L21 3v8.5h-9.6V4.4ZM3 12.8h7.1v6.9L3 18.6v-5.8Zm8.4 0H21V21l-9.6-1.4v-6.8Z"/></svg><span class="t"><b>Windows</b><small>installer</small></span>
        </a>
        <a class="tile" href="https://t.me/bulldozer_ebot">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.9 4.3 18.7 19c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.3 12.7 1.5 11.2c-1-.3-1-1 .2-1.5l19-7.3c.9-.3 1.6.2 1.2 1.9Z"/></svg><span class="t"><b>Telegram</b><small>bot</small></span>
        </a>
        <button type="button" class="tile" id="apps-pwa">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17 1.01 7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99ZM17 19H7V5h10v14Zm-4-7v4h-2v-4H8l4-4 4 4h-3Z"/></svg><span class="t"><b>Web app</b><small>install the site</small></span>
        </button>
        <a class="tile" href={`${base}/downloads/bulldozer-stats.apk`} download>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.2 8.4h9.6v7.4c0 .7-.6 1.3-1.3 1.3h-.8v2.2c0 .6-.5 1.1-1.1 1.1s-1.1-.5-1.1-1.1v-2.2h-1v2.2c0 .6-.5 1.1-1.1 1.1s-1.1-.5-1.1-1.1v-2.2h-.8c-.7 0-1.3-.6-1.3-1.3V8.4Zm-2.1.2c.6 0 1.1.5 1.1 1.1v4.8c0 .6-.5 1.1-1.1 1.1S4 15.1 4 14.5V9.7c0-.6.5-1.1 1.1-1.1Zm13.8 0c.6 0 1.1.5 1.1 1.1v4.8c0 .6-.5 1.1-1.1 1.1s-1.1-.5-1.1-1.1V9.7c0-.6.5-1.1 1.1-1.1ZM8.1 7.3c.2-1.2.9-2.2 1.8-2.8L9 2.9c-.1-.2 0-.4.2-.5s.4 0 .5.2l.9 1.6c.4-.1.9-.2 1.4-.2s1 .1 1.4.2l.9-1.6c.1-.2.3-.3.5-.2s.3.3.2.5l-.9 1.6c.9.6 1.6 1.6 1.8 2.8H8.1Zm2.1-1.5c-.3 0-.5.2-.5.5s.2.5.5.5.5-.2.5-.5-.2-.5-.5-.5Zm3.6 0c-.3 0-.5.2-.5.5s.2.5.5.5.5-.2.5-.5-.2-.5-.5-.5Z"/></svg><span class="t"><b>Android APK</b><small>{apkMB} MB, no Play</small></span>
        </a>
      </div>
      <p class="apps-note" id="apps-pwa-note" hidden>This browser offers no install
        prompt. Use its menu: <b>Install</b> or <b>Add to Home Screen</b>.</p>
      <p class="apps-note">Installed the APK before? It does not update from
        Google Play: uninstall it, then install from Play.</p>

      <ul class="perks">
        <li><span aria-hidden="true">📴</span><div><b>Offline</b> Charts and country profiles keep working with no signal.</div></li>
        <li><span aria-hidden="true">🔗</span><div><b>Sourced</b> Every figure names its publisher and year.</div></li>
        <li><span aria-hidden="true">🔒</span><div><b>Private</b> No sign-up, nothing tracked. <a href={`${base}/privacy/`}>Privacy</a> · <a href={`${base}/support/`}>Support</a></div></li>
      </ul>
    </div>
  </section>

  <style>
    .apps-page { max-width: 760px; }
    .store-badges { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 30px; }
    .store-badges.android .play { order: -1; }
    .store-badge { flex: 1 1 160px; max-width: 240px; display: inline-flex; align-items: center; gap: 10px;
      background: #000; color: #fff; border: 1px solid #4a4d52; border-radius: 12px;
      padding: 10px 16px; text-decoration: none; transition: border-color .15s, transform .15s; }
    .store-badge:hover { border-color: var(--accent); transform: translateY(-1px); }
    .store-badge .ico { width: 30px; height: 30px; flex: none; }
    .store-badge span { display: flex; flex-direction: column; font-size: 20px; font-weight: 600; line-height: 1.1; letter-spacing: -.01em; white-space: nowrap; }
    .store-badge small { font-size: 11px; font-weight: 500; letter-spacing: .02em; opacity: .9; }
    .more-h { font-size: 13px; text-transform: uppercase; letter-spacing: .12em; color: var(--text-dim); margin: 0 0 10px; }
    .more-apps { display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 10px; }
    .tile { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px 8px;
      background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; color: var(--text);
      text-decoration: none; text-align: center; font: inherit; cursor: pointer; transition: border-color .15s; }
    .tile:hover { border-color: var(--accent); }
    .tile .ico { width: 26px; height: 26px; margin-bottom: 2px; }
    .tile .t { display: flex; flex-direction: column; gap: 2px; }
    .tile b { font-size: 14px; }
    .tile small { font-size: 11.5px; color: var(--text-dim); }
    @media (max-width: 600px) {
      .store-badges { gap: 10px; }
      .store-badge { flex: 1 1 0; min-width: 0; padding: 9px 10px; gap: 8px; }
      .store-badge .ico { width: 24px; height: 24px; }
      .store-badge span { font-size: 17px; }
      .store-badge small { font-size: 10px; }
      .tile { flex-direction: row; justify-content: flex-start; text-align: left; gap: 10px; padding: 11px 12px; }
      .tile .ico { margin: 0; flex: none; width: 24px; height: 24px; }
    }
    .apps-note { font-size: 12.5px; color: var(--text-dim); margin: 10px 0 0; }
    .perks { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 10px; }
    .perks li { display: flex; gap: 12px; align-items: flex-start; font-size: 14.5px; color: var(--text-dim); }
    .perks li > span { font-size: 20px; line-height: 1.2; }
    .perks b { color: var(--text); margin-right: 4px; }
  </style>

  <script is:inline>
    (() => {
      if (/Android/.test(navigator.userAgent)) document.getElementById('store-badges').classList.add('android');
      // Browsers only allow the install prompt from a user gesture, and only once
      // they have fired beforeinstallprompt; where they never do, we say so
      // instead of leaving a button that quietly does nothing.
      let deferred = null;
      const btn = document.getElementById('apps-pwa');
      const note = document.getElementById('apps-pwa-note');
      window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferred = e; });
      btn.addEventListener('click', async () => {
        if (!deferred) { note.hidden = false; return; }
        deferred.prompt();
        await deferred.userChoice;
        deferred = null;
      });
    })();
  </script>
</BaseLayout>
