---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatsNote from '@components/StatsNote.astro';
import { COUNTRY_NOTES } from '@data/methodology';
import { buildCountryIndex, countrySlug, similarCountries } from '@lib/countryIndex';
import { splitScaleSvg } from '@lib/splitScale';
import { flagFor } from '@lib/flags';
import { TOPICS, TOPIC_ORDER } from '@lib/topics';
import isoAlpha2 from '@data/iso-alpha2.json';
import countryCurrency from '@data/country-currency.json';
import subregions from '@data/subregions.json';
import alfacat from '@data/alfacat.json';
import economy from '@data/weekly/economy.json';

export function getStaticPaths() {
  return buildCountryIndex().map((c) => ({ params: { slug: countrySlug(c.name) }, props: { iso: c.iso } }));
}

const { iso } = Astro.props;
const all = buildCountryIndex();
const c = all.find((x) => x.iso === iso)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const flag = flagFor(c.iso);
const alpha2 = (isoAlpha2 as Record<string, string>)[c.iso.toUpperCase()];
const statsNote = COUNTRY_NOTES[c.iso];
const cur = (countryCurrency as Record<string, { code: string; name: string; symbol: string }>)[c.iso];
// Markets on AlfaCat, the sister site (scripts/parse_alfacat_links.mjs): the
// benchmark index, the largest listings where market value is known, the
// currency pair, and a screener of the country's companies.
const EURO_AC = new Set(['AUT', 'BEL', 'FRA', 'DEU', 'GRC', 'ITA', 'NLD', 'ESP', 'FIN', 'IRL', 'PRT', 'SVK', 'SVN', 'EST', 'LVA', 'LTU', 'LUX', 'MLT', 'CYP', 'HRV', 'BGR']);
const mk = (alfacat as any).byIso[c.iso] ?? {};
const mkIndex = mk.index ?? (EURO_AC.has(c.iso) ? (alfacat as any).byIso.EA?.index : null);
const mkFx = (alfacat as any).fx[EURO_AC.has(c.iso) ? 'EUR' : cur?.code ?? ''];
const markets = mkIndex || mk.top?.length || mk.screener || mkFx;
const inWeekly = (economy as any).rows.some((r: any) => r.iso === c.iso);

const fmt = (v: number, unit: string) =>
  `${v.toLocaleString('en-US', { maximumFractionDigits: 1 })}${unit && unit.includes('%') ? '%' : ''}`;
const find = (slug: string) => c.items.find((i) => i.slug === slug);

// IMF series run past the last closed year into the IMF's own projections; a
// projection shown with a bare year reads as a measured result. Same rule as
// Ask AI: the current and the previous year are estimates.
const thisYear = new Date().getUTCFullYear();
const splitScales = (it: { slug: string; value: number; unit: string; splits?: import('@lib/countryIndex').Split[] }) =>
  (it.splits ?? []).map((sp) => splitScaleSvg(it, sp, fmt)).join('');
const when = (it: { slug: string; period: string }) => {
  const y = Number(String(it.period).match(/\d{4}/)?.[0] ?? 0);
  return it.slug.startsWith('imf-') && y >= thisYear - 1 ? `${it.period} est.` : it.period;
};
// Headline stats — same recipe as the interactive Geo panel.
const gdp = find('imf-gdp-per-capita-ppp') || find('imf-gdp-per-capita');
// Freshest source wins: World Bank WDI (to 2024) over Gapminder (ends 2020).
const life = find('wb-life-expectancy') || find('gapminder-life-expectancy');
const happy = find('whr-happiness');
const dem = find('v-dem-v2x-libdem');
const headline = [
  gdp && { label: 'GDP per capita (PPP)', value: `$${Math.round(gdp.value).toLocaleString()}`, rank: gdp },
  life && { label: 'Life expectancy', value: `${life.value.toFixed(1)} yrs`, rank: life },
  happy && { label: 'Happiness score', value: happy.value.toFixed(2), rank: happy },
  dem && { label: 'Liberal democracy', value: dem.value.toFixed(2), rank: dem },
].filter(Boolean) as { label: string; value: string; rank: { rank: number; total: number; slug: string; period: string } }[];

const similar = similarCountries(c, all, 5);
// Neighbours for deep interlinking (komoot lesson: linked pages = deeper sessions).
// Prefer the fine UN M49 sub-region (Central Europe, South-Eastern Asia…); fall
// back to the coarse continent when a sub-region is missing or nearly empty.
const subMap = subregions as Record<string, string>;
const subregion = subMap[c.iso];
const prettySub = (s: string) => s.replace('South-Eastern', 'Southeast').replace('South-eastern', 'Southeast');
const subPeers = subregion
  ? all.filter((x) => subMap[x.iso] === subregion && x.iso !== c.iso)
  : [];
const useSub = subPeers.length >= 3;
const peerLabel = useSub ? prettySub(subregion) : c.region;
const regionPeers = (useSub
  ? subPeers
  : (c.region ? all.filter((x) => x.region === c.region && x.iso !== c.iso) : [])
).sort((a, b) => a.name.localeCompare(b.name));
const byTopic = TOPIC_ORDER.map((id) => ({
  id, label: TOPICS[id].label, icon: TOPICS[id].icon,
  items: c.items.filter((it) => it.topic === id).sort((a, b) => a.title.localeCompare(b.title)),
})).filter((t) => t.items.length);

const desc = `${c.name} — ${c.items.length} indicators with world ranks: ${
  headline.map((h) => `${h.label.toLowerCase()} ${h.value} (#${h.rank.rank} of ${h.rank.total})`).join(', ')
}. Data from IMF, World Bank, Gapminder, WHR, V-Dem and more.`;

// SEO title surfaces the high-intent marker indicators ("hungary gdp", "hdi of
// hungary") plus the indicator count, instead of a generic "country data profile".
const has = (kw: string) => c.items.some((i) => i.title.toLowerCase().includes(kw));
const MARKERS: [string, string][] = [
  ['gdp per capita', 'GDP'], ['population', 'Population'], ['human development', 'HDI'],
  ['life expectancy', 'Life Expectancy'], ['happiness', 'Happiness'], ['inflation', 'Inflation'],
];
const markerStr = MARKERS.filter(([kw]) => has(kw)).map(([, l]) => l).slice(0, 3).join(', ');
const seoTitle = `${c.name}: ${markerStr ? markerStr + ' & ' : ''}${c.items.length} Indicators`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: c.name,
  url: `https://azenha.ai${base}/country/${countrySlug(c.name)}/`,
  description: desc,
};
---
<BaseLayout title={seoTitle} description={desc} active="geo">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="section">
    <div class="container">
      <a class="back-link" href={`${base}/country/`}>← All countries</a>
      <span class="kicker">{c.region || 'Country profile'}</span>
      <h1>{flag} {c.name}</h1>
      {c.official && c.official !== c.name && <p class="cc-official">{c.official}</p>}
      <div class="cc-codes">
        <span class="cc-code" title="ISO 3166-1 alpha-3">{c.iso}</span>
        {alpha2 && <span class="cc-code" title="ISO 3166-1 alpha-2">{alpha2}</span>}
        {cur && <span class="cc-code cc-cur" title="Currency">{cur.symbol ? `${cur.symbol} ` : ''}{cur.name} ({cur.code})</span>}
      </div>
      <p class="sub">
        Every statistic we track for {c.name} — {c.items.length} indicators, each with its latest value and world rank.
        <a href={`${base}/geo/?c=${c.iso}`}>Open the interactive profile →</a>
      </p>

      {headline.length > 0 && (
        <div class="grid cols-4 country-head" style="margin:14px 0 6px">
          {headline.map((h) => (
            <div class="card">
              <p class="meta" style="margin:0">{h.label}</p>
              <h3 style="margin:4px 0 2px">{h.value}</h3>
              <p class="meta" style="margin:0">#{h.rank.rank} of {h.rank.total} · {when(h.rank)}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  {(markets || inWeekly) && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <h2 style="font-size:18px">Markets &amp; this week</h2>
        <p class="sub">Daily market data for {c.name} lives on <a href="/alfacat/">AlfaCat</a>, our sister site{inWeekly ? <>; the latest GDP, prices, jobs and rates are in <a href={`${base}/economy/`}>Economy this week</a></> : ''}.</p>
        <p style="display:flex; gap:10px; flex-wrap:wrap">
          {mkIndex && <a class="ghost-btn" style="margin:0; text-decoration:none" href={`/alfacat/ticker/${mkIndex.symbol}/`}>📈 {mkIndex.name}{mkIndex.chgYTD != null ? ` · ${mkIndex.chgYTD > 0 ? '+' : ''}${mkIndex.chgYTD}% this year` : ''}</a>}
          {mkFx && <a class="ghost-btn" style="margin:0; text-decoration:none" href={`/alfacat/ticker/${mkFx.symbol}/`}>💱 {mkFx.symbol.replace(/^(...)(...)$/, '$1/$2')}</a>}
          {(mk.top ?? []).map((t: any) => <a class="ghost-btn" style="margin:0; text-decoration:none" href={`/alfacat/ticker/${t.symbol.replace(/\./g, "_")}/`}>{t.name}</a>)}
          {mk.screener && <a class="ghost-btn" style="margin:0; text-decoration:none" href={`/alfacat/${mk.screener}`}>All {mk.listings} listed companies →</a>}
        </p>
      </div>
    </section>
  )}

  {similar.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <h2 style="font-size:18px">Most similar countries</h2>
        <p class="sub">By profile across every shared indicator (global percentiles).</p>
        <p style="display:flex; gap:10px; flex-wrap:wrap">
          {similar.map((s) => (
            <a class="ghost-btn" style="margin:0; text-decoration:none" href={`${base}/country/${countrySlug(s.c.name)}/`}>
              {flagFor(s.c.iso)} {s.c.name} · {Math.round(s.match * 100)}%
            </a>
          ))}
        </p>
      </div>
    </section>
  )}

  {regionPeers.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <h2 style="font-size:18px">More {peerLabel} countries</h2>
        <p class="sub">Compare {c.name} with its neighbours across the same {c.items.length} indicators.</p>
        <p style="display:flex; gap:8px; flex-wrap:wrap">
          {regionPeers.map((p) => (
            <a class="ghost-btn" style="margin:0; text-decoration:none" href={`${base}/country/${countrySlug(p.name)}/`}>
              {flagFor(p.iso)} {p.name}
            </a>
          ))}
        </p>
      </div>
    </section>
  )}

  <section class="section" style="padding-top:0">
    <div class="container">
      <h2 style="font-size:18px">All indicators</h2>
      {byTopic.map((t) => (
        <div>
          <h3 style="font-size:13px;margin:18px 0 6px;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px">{t.icon} {t.label}</h3>
          <table class="data ci-table">
            <tbody>
              {t.items.map((it) => (
                <Fragment>
                <tr>
                  <td><a href={`${base}/dataset/${it.slug}/`}>{it.title}</a></td>
                  <td class="num">{fmt(it.value, it.unit)}{it.unit && !it.unit.includes('%') && <span class="ci-unit"> {it.unit}</span>}{it.splits && (
                    <button type="button" class="ci-sex ci-sex-desk" aria-expanded="false" aria-controls={`sx-${it.slug}`} title="Show the groups on one scale">{it.splits.map((sp) => (
                      <span class={`sl ${sp.dim}`}><span class="a">{sp.labels[0]} {fmt(sp.a, it.unit)}</span> · <span class="b">{sp.labels[1]} {fmt(sp.b, it.unit)}</span></span>
                    ))}<span class="ci-sex-caret" aria-hidden="true">▾</span></button>
                  )}</td>
                  <td class="num" style="color:var(--text-dim)" title={it.better === 'low' ? 'Ranked from the highest value; lower is better here' : it.better === 'high' ? 'Ranked from the highest value; higher is better here' : 'Ranked from the highest value; not a judgement of good or bad'}>#{it.rank}/{it.total}</td>
                  <td class="num" style="color:var(--text-dim)" title={it.years > 1 ? `${it.years} readings` : 'Single reading, no trend yet'}>{it.years > 1 && it.first !== it.period ? `${it.first} → ${when(it)}` : it.years === 1 ? `${when(it)} only` : when(it)}</td>
                  {it.splits && (
                    <td class="ci-splits-td"><button type="button" class="ci-sex ci-sex-phone" aria-expanded="false" aria-controls={`sx-${it.slug}`} title="Show the groups on one scale">{it.splits.map((sp) => (
                      <span class={`sl ${sp.dim}`}><span class="a">{sp.labels[0]} {fmt(sp.a, it.unit)}</span> · <span class="b">{sp.labels[1]} {fmt(sp.b, it.unit)}</span></span>
                    ))}<span class="ci-sex-caret" aria-hidden="true">▾</span></button></td>
                  )}
                </tr>
                {it.splits && (
                  <tr class="ci-sex-panel" id={`sx-${it.slug}`} hidden><td colspan="4"><Fragment set:html={splitScales(it)} /></td></tr>
                )}
                </Fragment>
              ))}
            </tbody>
          </table>
        </div>
      ))}
      <p class="sub" style="margin-top:14px">
        Latest available period per indicator; "2015 → 2024" means a series of readings over
        those years, "2024 only" a single reading with no trend yet. The rank counts down from the highest
        value, whatever that means for the series: on child mortality or extreme
        poverty the country at #1 is the worst in the world, not the best.
        Sources are credited on each indicator page.
      </p>
      {statsNote && <StatsNote note={statsNote} open />}
    </div>
  </section>
<script is:inline>
  // Women / men: the numbers are the row; the scale opens under it on a tap.
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('button.ci-sex');
    if (!b) return;
    var panel = document.getElementById(b.getAttribute('aria-controls'));
    if (!panel) return;
    var open = b.getAttribute('aria-expanded') !== 'true';
    b.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  });
</script>
</BaseLayout>
